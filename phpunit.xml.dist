<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
         convertDeprecationsToExceptions="false"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <!-- La suite tourne dans UN seul processus : la mémoire s'accumule d'un
             test à l'autre (kernels bootés, clients HTTP, classeurs Excel et PDF
             générés en mémoire). Les 512 Mo du php.ini CLI ne suffisent plus pour
             `php bin/phpunit` en une passe — l'exécution s'interrompait sur un
             « Allowed memory size exhausted » dans zipstream (export XLSX), sans
             rapport avec le test concerné.

             1 Go a été franchi à son tour, et le symptôme est trompeur : sous
             pression mémoire, la suite ne s'arrête pas nette — des requêtes se
             mettent à répondre 500 dans des tests sans rapport (l'envoi d'e-mails
             en série, par exemple), qui passent tous en isolation. On monte donc à
             2 Go, ce qui reste un garde-fou contre une fuite réelle. Si ce plafond
             est atteint de nouveau, chercher d'abord une fuite avant de le lever.

             2 Go ont été franchis à leur tour (2026-09-08), à 97 % de la suite. La
             fuite a été cherchée avant de lever : le coût s'est révélé PROPORTIONNÉ,
             pas cumulatif — le dossier ajouté consomme 180 Mo pour 42 tests, du même
             ordre que les 144 Mo des 70 tests de `tests/Token`, et l'essentiel tient
             aux kernels bootés par WebTestCase, libérés à chaque test.

             La consigne reste la même pour la prochaine fois : mesurer un dossier
             isolé, le comparer à un dossier existant de taille voisine, et ne lever
             ce plafond que si le rapport Mo/test n'a pas bougé. -->
        <ini name="memory_limit" value="3072M" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="SYMFONY_PHPUNIT_REMOVE" value="" />
        <server name="SYMFONY_PHPUNIT_VERSION" value="9.5" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </coverage>

    <listeners>
        <listener class="Symfony\Bridge\PhpUnit\SymfonyTestsListener" />
    </listeners>

    <extensions>
    </extensions>
</phpunit>
