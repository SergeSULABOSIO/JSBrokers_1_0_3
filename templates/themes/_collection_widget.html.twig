{# templates/themes/_collection_widget.html.twig #}
{% block collection_widget %}
    {# Le balisage du widget vit dans _collection_manager.html.twig, partagé avec les
       onglets qui n'ont pas de champ de formulaire (cf. _form_row.html.twig). #}
    {{ include('themes/_collection_manager.html.twig', {
        manager_options: manager_options|default({}),
        dom_id: id,
        libelle: form.vars.label|default(form.vars.name),
    }, with_context = false) }}

    {# On cache le rendu par défaut de Symfony #}
    <div style="display:none;">
        {{- form_widget(form) -}}
    </div>
{% endblock %}
