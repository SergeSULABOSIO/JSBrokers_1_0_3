{# Écart en JOURS PLEINS : les deux dates sont ramenées à minuit avant la
   soustraction, sinon l'heure courante tronquait un jour et une police expirant
   aujourd'hui basculait du mauvais côté. Mêmes seuils que les chips de la rubrique
   Avenants (AvenantEcheanceScope) : < 0 échue, 0-30, 31-60, 61+. #}
{% set _now = 'today'|date('U') %}
{% set countEchus = 0 %}
{% set countJ30 = 0 %}
{% set countJ60 = 0 %}
{% set countJ61plus = 0 %}
{% for avenant in renouvellements %}
    {% set _diff = ((avenant.endingAt|date('Y-m-d')|date('U') - _now) / 86400)|round %}
    {% if _diff < 0 %}
        {% set countEchus = countEchus + 1 %}
    {% elseif _diff <= 30 %}
        {% set countJ30 = countJ30 + 1 %}
    {% elseif _diff <= 60 %}
        {% set countJ60 = countJ60 + 1 %}
    {% else %}
        {% set countJ61plus = countJ61plus + 1 %}
    {% endif %}
{% endfor %}

{# Seau ouvert par défaut : les ÉCHUES d'abord quand il y en a — même logique que le
   chip par défaut dynamique de la rubrique (ControllerUtilsTrait::getInitialSearchCriteria).
   Le groupe des décisions n'est JAMAIS le défaut : c'est une archive, pas un travail à faire. #}
{% set groupeDefaut = countEchus > 0 ? 'echus' : 'j30' %}

{# Les non renouvelables arrivent dans une collection SÉPARÉE (le pipeline les écarte de
   `renouvellements`), mais on les FUSIONNE pour la boucle de rendu : une ligne du tableau de
   bord porte une centaine de lignes de markup, dont son menu contextuel — la dupliquer aurait
   garanti qu'un des deux exemplaires prenne du retard sur l'autre. Le groupe se décide
   ci-dessous sur `avenant.nonRenouvelable`, pas sur la provenance. #}
{% set nonRenouvelables = nonRenouvelables|default([]) %}
{% set countNonRenouv = nonRenouvelables|length %}
{% set _toutes = renouvellements|merge(nonRenouvelables) %}

{% if _toutes|length > 0 %}
    {% if countEchus == 0 %}
    <p class="db-renew-item text-muted small px-2 py-4 text-center" data-group="echus"{% if groupeDefaut != 'echus' %} style="display:none;"{% endif %}>
        <twig:UX:Icon name="mdi:check-circle-outline" style="width:16px;height:16px;display:block;margin:0 auto .25rem;" />
        Aucune police échue : toutes les couvertures sont à jour.
    </p>
    {% endif %}
    {% if countJ30 == 0 %}
    <p class="db-renew-item text-muted small px-2 py-4 text-center" data-group="j30"{% if groupeDefaut != 'j30' %} style="display:none;"{% endif %}>
        <twig:UX:Icon name="mdi:check-circle-outline" style="width:16px;height:16px;display:block;margin:0 auto .25rem;" />
        Aucun renouvellement critique dans les 30 prochains jours.
    </p>
    {% endif %}
    {% if countJ60 == 0 %}
    <p class="db-renew-item text-muted small px-2 py-4 text-center" data-group="j60" style="display:none;">
        <twig:UX:Icon name="mdi:check-circle-outline" style="width:16px;height:16px;display:block;margin:0 auto .25rem;" />
        Aucun renouvellement entre 31 et 60 jours.
    </p>
    {% endif %}
    {% if countJ61plus == 0 %}
    <p class="db-renew-item text-muted small px-2 py-4 text-center" data-group="j61plus" style="display:none;">
        <twig:UX:Icon name="mdi:check-circle-outline" style="width:16px;height:16px;display:block;margin:0 auto .25rem;" />
        Aucun renouvellement au-delà de 60 jours.
    </p>
    {% endif %}
    {% if countNonRenouv == 0 %}
    <p class="db-renew-item text-muted small px-2 py-4 text-center" data-group="nonrenouv" style="display:none;">
        <twig:UX:Icon name="mdi:calendar-remove" style="width:16px;height:16px;display:block;margin:0 auto .25rem;" />
        Aucune police signalée « à ne pas renouveler ».
    </p>
    {% endif %}

    {% for avenant in _toutes %}
        {% set _diff = ((avenant.endingAt|date('Y-m-d')|date('U') - _now) / 86400)|round %}
        {# La DÉCISION prime sur la date : une police signalée non renouvelable n'est pas en
           retard, et son onglet ne dépend pas de son échéance. Gris neutre, jamais de rouge. #}
        {% if avenant.nonRenouvelable %}
            {% set group = 'nonrenouv' %}
            {% set urgencyColor = '#6c757d' %}
        {% elseif _diff < 0 %}
            {% set group = 'echus' %}
            {# --danger-dark : plus grave que le rouge « critique » des 30 jours. #}
            {% set urgencyColor = '#842029' %}
        {% elseif _diff <= 30 %}
            {% set group = 'j30' %}
            {% set urgencyColor = '#dc3545' %}
        {% elseif _diff <= 60 %}
            {% set group = 'j60' %}
            {% set urgencyColor = '#e69500' %}
        {% else %}
            {% set group = 'j61plus' %}
            {% set urgencyColor = '#198754' %}
        {% endif %}

        {% set clientNom   = avenant.cotation.piste.client.nom ?? '—' %}
        {% set assureurNom = avenant.cotation.assureur.nom ?? '—' %}
        {% set risqueNom   = avenant.cotation.piste.risque.nomComplet ?? '—' %}
        {% set portefeuille = avenant.cotation.piste.client.portefeuille ?? null %}
        {% set gestionnaireNom = portefeuille ? (portefeuille.gestionnaire.nom ?? portefeuille.gestionnaire.utilisateur.email ?? '') : '' %}
        {% set searchText  = (clientNom ~ '|' ~ assureurNom ~ '|' ~ risqueNom ~ '|' ~ (portefeuille ? portefeuille.nom : '') ~ '|' ~ gestionnaireNom)|lower %}

        <details class="db-ass-details db-renew-item"
                 data-group="{{ group }}"
                 data-search-text="{{ searchText|e }}"
                 data-avenant-id="{{ avenant.id }}"
                 data-entreprise-id="{{ entreprise.id }}"
                 data-piste-id="{{ avenant.pisteDeRenouvellement ? avenant.pisteDeRenouvellement.id : '' }}"
                 {# Lu par dbRenewCtxOpen : le menu contextuel propose « Signaler » ou
                    « Rétablir » selon l'état réel, jamais l'action impossible. #}
                 data-non-renouvelable="{{ avenant.nonRenouvelable ? '1' : '0' }}"
                 oncontextmenu="dbRenewCtxOpen(event,this)"
                 {% if group != groupeDefaut %}style="display:none;"{% endif %}>
            <summary class="d-flex align-items-center gap-2 py-2 px-1">
                <div class="db-ass-avatar rounded-circle d-flex align-items-center justify-content-center text-white"
                     style="width:26px;height:26px;background:{{ urgencyColor }};flex-shrink:0;">
                    <twig:UX:Icon name="fluent:document-edit-16-regular" style="width:13px;height:13px;" />
                </div>
                <div class="d-flex flex-column flex-grow-1" style="min-width:0;">
                    <span class="small fw-semibold text-truncate"
                          style="color:#212529;"
                          data-renew-tip
                          data-renew-prime="{{ avenant.primeTotale is not null ? avenant.primeTotale|number_format(0, ',', ' ') ~ ' ' ~ deviseCode : '—' }}"
                          data-renew-comm="{{ avenant.montantTTC is not null ? avenant.montantTTC|number_format(0, ',', ' ') ~ ' ' ~ deviseCode : '—' }}"
                          data-renew-retro="{{ avenant.retroCommission is not null ? avenant.retroCommission|number_format(0, ',', ' ') ~ ' ' ~ deviseCode : '—' }}"
                          data-renew-reserve="{{ avenant.reserve is not null ? avenant.reserve|number_format(0, ',', ' ') ~ ' ' ~ deviseCode : '—' }}"
                          data-renew-periode="{{ avenant.startingAt|date('d/m/Y') }} – {{ avenant.endingAt|date('d/m/Y') }}"
                          data-renew-risque="{{ risqueNom }}"
                          data-renew-assureur="{{ assureurNom }}"
                          data-renew-portefeuille="{{ portefeuille ? portefeuille.nom : 'Sans portefeuille' }}"
                          data-renew-gestionnaire="{{ gestionnaireNom }}"
                          data-renew-piste="{{ avenant.pisteDeRenouvellement ? avenant.pisteDeRenouvellement.nom : '' }}">{{ clientNom }}</span>
                    {% if portefeuille %}
                        <span class="text-truncate" style="font-size:.62rem;color:#0047AB;" title="Portefeuille : {{ portefeuille.nom }}{% if gestionnaireNom %} — Gestionnaire : {{ gestionnaireNom }}{% endif %}">
                            <twig:UX:Icon name="mdi:briefcase-account" style="width:10px;height:10px;" class="me-1" />
                            {{ portefeuille.nom }}{% if gestionnaireNom %} · {{ gestionnaireNom }}{% endif %}
                        </span>
                    {% else %}
                        <span class="text-truncate" style="font-size:.62rem;color:#adb5bd;font-style:italic;" title="Ce client n'est rattaché à aucun portefeuille">
                            <twig:UX:Icon name="mdi:briefcase-off-outline" style="width:10px;height:10px;" class="me-1" />
                            Sans portefeuille
                        </span>
                    {% endif %}
                </div>
                <span class="text-muted" style="font-size:.62rem;flex-shrink:0;white-space:nowrap;">
                    {{ avenant.startingAt|date('d/m/Y') }} – {{ avenant.endingAt|date('d/m/Y') }}
                </span>
                <span class="badge rounded-pill db-renew-badge"
                      style="background:{{ urgencyColor }};color:#fff;flex-shrink:0;">
                    {# Jamais de nombre NÉGATIF : pour une échue on nomme le retard. Pour une
                       police signalée, on nomme la DÉCISION — annoncer un retard sur une
                       échéance qu'on a choisi de ne pas honorer serait un contresens. #}
                    {% if avenant.nonRenouvelable %}Non renouv.{% elseif _diff < 0 %}Expiré depuis {{ -_diff }} j{% else %}{{ _diff }}j{% endif %}
                </span>
                <twig:UX:Icon name="mdi:chevron-down" class="db-ass-chevron"
                              style="width:14px;height:14px;color:#6c757d;" />
            </summary>

            <div class="px-2 py-2 bg-light rounded-bottom" style="font-size:.73rem;">
                {# LA DÉCISION EN TÊTE DU DÉTAIL, avec son motif : c'est la note écrite pour
                   celui qui rouvre le dossier, et elle doit être la première chose qu'il lit.
                   Source unique avec la liste et la fiche : l'indicateur nonRenouvelableDetail. #}
                {% if avenant.nonRenouvelableDetail %}
                <div class="mb-2 px-2 py-1 rounded" role="note"
                     style="background:#fff8e6;border-left:3px solid #e69500;color:#7a4f00;">
                    <twig:UX:Icon name="mdi:calendar-remove" style="width:11px;height:11px;" class="me-1" />
                    {{ avenant.nonRenouvelableDetail }}
                </div>
                {% endif %}
                <div class="mb-2">
                    {% if avenant.cotation.piste %}
                        <span style="color:#212529;">
                            <twig:UX:Icon name="fluent:document-edit-16-regular" style="width:11px;height:11px;" class="me-1" />
                            <strong>{{ avenant.cotation.piste.nom }}</strong>
                        </span>
                    {% else %}
                        <span style="color:#adb5bd;font-style:italic;">
                            <twig:UX:Icon name="mdi:account-question-outline" style="width:11px;height:11px;" class="me-1" />
                            Aucune piste — dossier non attribué
                        </span>
                    {% endif %}
                </div>
                <div class="mb-2 pt-1" style="border-top:1px dashed #dee2e6;">
                    {% if avenant.pisteDeRenouvellement %}
                        <div class="d-flex align-items-start gap-1" style="color:#0047AB;">
                            <twig:UX:Icon name="mdi:reload" style="width:11px;height:11px;margin-top:2px;flex-shrink:0;" />
                            <div>
                                <strong>{{ avenant.pisteDeRenouvellement.nom }}</strong>
                                <span class="text-muted ms-1" style="font-size:.68rem;">
                                    ({{ avenant.pisteDeRenouvellement.client.nom ?? '—' }})
                                </span>
                                {% if avenant.pisteDeRenouvellement.primePotentielle or avenant.pisteDeRenouvellement.commissionPotentielle %}
                                <div class="d-flex gap-2 flex-wrap mt-1" style="font-size:.65rem;color:#6c757d;">
                                    {% if avenant.pisteDeRenouvellement.primePotentielle %}
                                    <span>Prime :&nbsp;<strong style="color:#0047AB;">{{ avenant.pisteDeRenouvellement.primePotentielle|number_format(0, ',', ' ') }}&nbsp;{{ deviseCode }}</strong></span>
                                    {% endif %}
                                    {% if avenant.pisteDeRenouvellement.commissionPotentielle %}
                                    <span>Commission :&nbsp;<strong style="color:#198754;">{{ avenant.pisteDeRenouvellement.commissionPotentielle|number_format(0, ',', ' ') }}&nbsp;{{ deviseCode }}</strong></span>
                                    {% endif %}
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <span style="color:#adb5bd;font-style:italic;">
                            <twig:UX:Icon name="mdi:account-clock-outline" style="width:11px;height:11px;" class="me-1" />
                            Aucun travail de renouvellement en cours
                        </span>
                    {% endif %}
                </div>
                <div class="d-flex gap-3 flex-wrap pt-1" style="border-top:1px solid #dee2e6;">
                    <span style="color:#6c757d;">
                        <twig:UX:Icon name="wpf:security-checked" style="width:11px;height:11px;" class="me-1" />
                        {{ assureurNom }}
                    </span>
                    <span style="color:#6c757d;">
                        <twig:UX:Icon name="ant-design:product-filled" style="width:11px;height:11px;" class="me-1" />
                        {{ risqueNom }}
                    </span>
                    <span style="color:#6c757d;">
                        <twig:UX:Icon name="mdi:calendar-clock" style="width:11px;height:11px;" class="me-1" />
                        {{ avenant.endingAt|date('d/m/Y') }}
                    </span>
                    {% if avenant.description %}
                    <span style="color:#6c757d;">
                        <twig:UX:Icon name="fluent:text-description-16-filled" style="width:11px;height:11px;" class="me-1" />
                        {{ avenant.description|striptags|slice(0, 80) }}{{ avenant.description|striptags|length > 80 ? '…' : '' }}
                    </span>
                    {% endif %}
                </div>
            </div>
        </details>
    {% endfor %}
{% else %}
    <p class="text-muted small mb-0 px-2 py-3 text-center">Aucun renouvellement prévu.</p>
{% endif %}
