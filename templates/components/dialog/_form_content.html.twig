{# templates/components/dialog/_form_content.html.twig #}
{% form_theme form 'themes/_collection_widget.html.twig' %}
{% set title = isCreationMode
    ? formCanvas.parametres.titre_creation
    : formCanvas.parametres.titre_modification|replace({'%id%': entity.id})
%}
{# ── LES ACTIONS DE LA FICHE ─────────────────────────────────────────────────────
   Elles s'affichent dans la barre pleine largeur de la coquille du dialogue
   (dialog-manager), construite par dialog-instance#_afficherBarreActions avec le MÊME
   rendu que la barre du workspace (barre-actions.js). Le gabarit ne fait que les
   transmettre : la source reste le canevas SERVEUR, calculé avec l'entité.

   Avec elles, de quoi composer le selecto de la fiche — la forme exacte de celui d'une
   ligne de liste (_list_row) : type, canevas et nom affiché. Une action reçoit ainsi la
   même chose, qu'elle parte d'une ligne ou d'une fiche.

   En création, rien : il n'y a pas encore de fiche sur laquelle agir. #}
{% set actions_fiche = isCreationMode ? [] : formCanvas.parametres.attribute_actions|default([]) %}
{% set code_libelle = listeCanvas.colonne_principale.texte_principal.attribut_code|default(null) %}
    <div class="row gx-0" data-icon-name="{{ entityCanvas.parametres.icone|default('') }}"
        {% if actions_fiche is not empty %}
            data-actions-fiche="{{ actions_fiche|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}"
            data-entity-type="{{ entite_nom|default('') }}"
            data-entity-canvas="{{ entityCanvas|json_encode }}"
            data-label="{{ code_libelle ? attribute(entity, code_libelle)|default('') : '' }}"
        {% endif %}>
        {# La colonne des attributs est incluse ici et gère sa propre classe de colonne (ex: col-auto) #}
        {% include 'components/dialog/_calculated_attributes.html.twig' with { entity: entity, canvas: entityCanvas } %}

        {# La colonne du formulaire prend l'espace restant #}
        <div class="col form-column{% if formCanvas.parametres.form_class is defined %} {{ formCanvas.parametres.form_class }}{% endif %}">
            {# BANDEAU D'ALERTE opt-in, AU-DESSUS de tout le reste : un fait qui doit sauter aux
               yeux de quiconque ouvre la fiche (ex. « police signalée non renouvelable »). La
               colonne d'attributs calculés compte des dizaines de lignes — un fait décisif y
               serait noyé, ce qui est exactement le contraire du but.

               Le canvas fournit {niveau, titre, texte_code} ; le TEXTE vient d'un attribut
               calculé de l'entité, jamais du gabarit : une seule source de vérité pour toutes
               les surfaces. Attribut vide ou absent = aucun bandeau, donc invisible sur les
               entités ordinaires et sur tous les dialogues qui ne posent pas la clé.

               role="note" et non "alert" : ce n'est pas une erreur de saisie, et un alert serait
               annoncé de façon intrusive à chaque ouverture (WCAG 4.1.3). #}
            {% if formCanvas.parametres.form_alerte is defined %}
                {% set alerte = formCanvas.parametres.form_alerte %}
                {% set alerte_texte = attribute(entity, alerte.texte_code)|default(null) %}
                {% if alerte_texte is not null and alerte_texte|trim != '' %}
                    <div class="form-alerte form-alerte--{{ alerte.niveau|default('warning') }}" role="note">
                        <span class="form-alerte-icon" aria-hidden="true">
                            {{ ux_icon(resolve_icon_name(alerte.icone|default('action:alert')), {height: '22px', width: '22px'}) }}
                        </span>
                        <div class="form-alerte-text">
                            <p class="form-alerte-title">{{ alerte.titre }}</p>
                            <p class="form-alerte-desc">{{ alerte_texte }}</p>
                        </div>
                    </div>
                {% endif %}
            {% endif %}
            {# Entête contextuel opt-in (pastille de l'entité + description de l'édition
               et de son importance), au-dessus du cadre du formulaire. Rendu uniquement
               si le canvas pose form_intro : les autres dialogues sont inchangés. #}
            {% if formCanvas.parametres.form_intro is defined %}
                {% set intro = formCanvas.parametres.form_intro %}
                {# Rappel des informations pré-remplies dont les champs sont masqués
                   (rangées hidden du canvas) : l'utilisateur voit POUR QUI / SUR QUOI
                   il édite sans avoir à le mémoriser (Nielsen 6 — reconnaissance
                   plutôt que rappel). Meilleur effort : objets affichés via leur
                   « nom »/« libellé », scalaires tels quels, le reste est ignoré. #}
                {% set intro_facts = [] %}
                {% for row in formCanvas.form_layout|default([]) %}
                    {% set row_hidden = row.hidden is defined and row.hidden %}
                    {% for col in row.colonnes %}
                        {% for field in (col.champs is defined ? col.champs : [col]) %}
                            {% set fc = (field is mapping and field.field_code is defined) ? field.field_code : field %}
                            {# Champ masqué : rangée hidden du canvas OU champ parent injecté
                               dynamiquement (row_attr d-none, cf. renderFormCanvas). #}
                            {% set field_hidden = row_hidden
                                or (field is mapping and 'd-none' in (field.options.row_attr.class|default(''))) %}
                            {% if field_hidden and form[fc] is defined %}
                                {% set raw = form[fc].vars.data %}
                                {% set display = null %}
                                {% if raw is not null and raw is not iterable %}
                                    {% if raw.nom is defined %}{% set display = raw.nom %}
                                    {% elseif raw.libelle is defined %}{% set display = raw.libelle %}
                                    {% elseif raw.timestamp is defined %}{% set display = raw|date('d/m/Y') %}
                                    {% else %}{% set display = raw %}{% endif %}
                                {% endif %}
                                {% if display is not null and display != '' %}
                                    {% set fact_label = intro.facts_labels[fc]|default(form[fc].vars.label|default(fc|humanize)) %}
                                    {% set intro_facts = intro_facts|merge([{field: fc, label: fact_label, value: display}]) %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                {% endfor %}
                {# Contexte parent (fourni par renderFormCanvas) : objets parents déjà
                   rattachés à l'entité — indispensable en ÉDITION où le parent n'est
                   pas dans le layout (ex. la tâche d'un feedback). Dédoublonné avec
                   les faits issus des champs masqués ci-dessus. #}
                {% for pf_field, pf_value in parentContextFacts|default({}) %}
                    {% set already_listed = intro_facts|filter(f => f.field == pf_field)|length > 0 %}
                    {% if not already_listed %}
                        {% set pf_form_label = form[pf_field] is defined ? form[pf_field].vars.label|default(pf_field|humanize) : pf_field|humanize %}
                        {% set fact_label = intro.facts_labels[pf_field]|default(pf_form_label) %}
                        {% set intro_facts = intro_facts|merge([{field: pf_field, label: fact_label, value: pf_value}]) %}
                    {% endif %}
                {% endfor %}
                <div class="form-intro" role="note">
                    <span class="form-intro-icon" aria-hidden="true">
                        {{ ux_icon(resolve_icon_name(intro.icone|default(entityCanvas.parametres.icone|default('action:role'))), {height: '26px', width: '26px'}) }}
                    </span>
                    <div class="form-intro-text">
                        <p class="form-intro-title">{{ intro.titre }}</p>
                        <p class="form-intro-desc">{{ intro.description }}</p>
                        {% if intro_facts is not empty %}
                            <dl class="form-intro-facts">
                                {% for fact in intro_facts %}
                                    <div class="form-intro-fact">
                                        <dt>{{ fact.label }}</dt>
                                        <dd>{{ fact.value }}</dd>
                                    </div>
                                {% endfor %}
                            </dl>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            {# novalidate : la validation HTML5 native bloque silencieusement la soumission
               quand un champ `required` vide est dans une section masquée (le navigateur ne
               peut focaliser un champ caché). La validation de référence est côté SERVEUR ;
               un contrôle JS léger (dialog-instance#triggerSubmit) signale, lui, les seuls
               champs requis VISIBLES avant l'envoi. Robuste y compris sur la touche Entrée. #}
            {# Un canevas peut attacher son propre contrôleur Stimulus au formulaire
               (`form_controller`) : c'est le point d'accroche des comportements propres à
               une entité — champs qui apparaissent selon un choix, calculs à la volée. À
               défaut, le formulaire reste nu, exactement comme avant. #}
            {% set form_controller = formCanvas.parametres.form_controller|default(null) %}
            {{ form_start(form, {'attr': form_controller
                ? {'novalidate': 'novalidate', 'data-controller': form_controller}
                : {'novalidate': 'novalidate'}}) }}
            {# ══ PARTITION DU LAYOUT EN ONGLETS ══
               Une rangée qui porte `onglet_titre` est une COLLECTION, et chaque collection
               devient un onglet — `FormCanvasProviderTrait` pousse déjà une rangée dédiée
               par collection, la maille y était donc toute faite. Tout le reste forme
               l'onglet « Principal ».

               `|filter` et non une boucle avec `set` : en Twig, une variable posée DANS un
               `for` ne survit pas à la sortie de la boucle — la partition serait repartie
               vide, sans la moindre erreur pour le dire.

               Aucune collection → aucune barre : le dialogue est alors rendu exactement
               comme avant, ce qui garantit que ceux qui n'en portent pas ne bougent pas. #}
            {% set rangees_onglets = formCanvas.form_layout|default([])|filter(r => r.onglet_titre is defined) %}
            {% set rangees_principales = formCanvas.form_layout|default([])|filter(r => r.onglet_titre is not defined) %}

            {% if formCanvas.form_layout is defined and formCanvas.form_layout is not empty %}
                {% if rangees_onglets is empty %}
                    {% for row in rangees_principales %}
                        {% include 'components/dialog/_form_row.html.twig' with { row: row, form: form, formCanvas: formCanvas, idEntreprise: idEntreprise, idInvite: idInvite } only %}
                    {% endfor %}
                {% else %}
                    {# PRÉFIXE D'INSTANCE. Deux dialogues coexistent dès qu'on ouvre une
                       cotation depuis la liste d'une piste. Sans préfixe, deux
                       id="onglet-principal" dans le même document : aria-controls et
                       querySelector désigneraient le mauvais dialogue, et cliquer un
                       onglet de l'enfant remuerait le parent. #}
                    {% set uid = 'ong' ~ random(100000, 999999) %}
                    {# Un formulaire peut n'être fait QUE de collections : il n'a alors pas
                       d'onglet « Principal », et c'est son premier onglet qui s'ouvre. #}
                    {% set a_un_principal = rangees_principales is not empty %}

                    <div data-controller="onglets-formulaire">
                        <div class="jsb-onglets-barre" data-onglets-formulaire-target="barre">
                            <div class="jsb-onglets-rangee" role="tablist" aria-label="Sections de la fiche"
                                 data-onglets-formulaire-target="rangee"
                                 data-action="keydown->onglets-formulaire#handleTabKeydown">
                                {% if a_un_principal %}
                                    <button type="button" class="jsb-onglet active" role="tab"
                                            id="{{ uid }}-onglet-principal" aria-selected="true" tabindex="0"
                                            aria-controls="{{ uid }}-panneau-principal" data-tab-id="principal"
                                            data-onglets-formulaire-target="onglet"
                                            data-action="click->onglets-formulaire#switchTab">
                                        <span class="jsb-onglet-icone" aria-hidden="true">{{ ux_icon(resolve_icon_name(entityCanvas.parametres.icone|default('lucide:file-text'))) }}</span>
                                        <span class="jsb-onglet-titre">Principal</span>
                                    </button>
                                {% endif %}
                                {% for row in rangees_onglets %}
                                    {% set field_code = row.colonnes[0].champs[0].field_code %}
                                    {% set actif = not a_un_principal and loop.first %}
                                    {% set compte = row.onglet_compte|default(null) %}
                                    <button type="button"
                                            class="jsb-onglet{{ actif ? ' active' }}{{ row.hidden|default(false) ? ' d-none' }}"
                                            role="tab" id="{{ uid }}-onglet-{{ field_code }}"
                                            aria-selected="{{ actif ? 'true' : 'false' }}"
                                            tabindex="{{ actif ? '0' : '-1' }}"
                                            aria-controls="{{ uid }}-panneau-{{ field_code }}"
                                            data-tab-id="{{ field_code }}"
                                            data-onglets-formulaire-target="onglet"
                                            data-action="click->onglets-formulaire#switchTab">
                                        <span class="jsb-onglet-icone" aria-hidden="true">{{ ux_icon(resolve_icon_name(formCanvas.parametres.field_icons[field_code]|default('collection'))) }}</span>
                                        <span class="jsb-onglet-titre">{{ row.onglet_titre }}</span>
                                        {# PASTILLE DE COMPTE — et surtout AUCUN aria-label sur
                                           l'onglet : il remplacerait le nom accessible entier et
                                           effacerait ce nombre. Le nom se lit « Cotations 3
                                           éléments », accordé au singulier comme il se doit.
                                           Absente en création (compte nul) : le contrôleur la
                                           crée alors au premier élément mis en attente. #}
                                        {% if compte %}
                                            <span class="jsb-onglet-compte">{{ compte }}<span class="visually-hidden"> {{ compte > 1 ? 'éléments' : 'élément' }}</span></span>
                                        {% endif %}
                                    </button>
                                {% endfor %}
                            </div>

                            {# Repli « + N » : même grammaire que les deux barres du workspace,
                               piloté par le même module (onglets-debordement.js). Sans « fermer » :
                               un onglet de formulaire ne se ferme pas, il n'a donc pas de croix. #}
                            <button type="button" class="list-tabs-more d-none"
                                    data-onglets-formulaire-target="boutonPlus"
                                    data-action="click->onglets-formulaire#toggleDebordement"
                                    aria-expanded="false" aria-haspopup="true"
                                    aria-controls="{{ uid }}-panneau-debordement">
                                <span data-onglets-formulaire-target="compteurPlus">+0</span>
                                <span class="visually-hidden">sections supplémentaires</span>
                                <twig:UX:Icon name="{{ resolve_icon_name('lucide:chevron-down') }}" class="list-tabs-more-chevron" aria-hidden="true" />
                            </button>
                            <div id="{{ uid }}-panneau-debordement" class="list-tabs-overflow-panel d-none"
                                 data-onglets-formulaire-target="panneauDebordement"
                                 role="list" aria-label="Sections repliées"></div>
                        </div>

                        {# TOUTES les rangées sont rendues, y compris celles des onglets masqués :
                           form_end(render_rest: true) recracherait sinon leurs champs en bas du
                           formulaire. On cache l'onglet, jamais la rangée. #}
                        {% if a_un_principal %}
                            <div class="jsb-onglets-panneau" id="{{ uid }}-panneau-principal" role="tabpanel"
                                 tabindex="0" aria-labelledby="{{ uid }}-onglet-principal"
                                 data-onglets-formulaire-target="panneau" data-tab-id="principal">
                                {% for row in rangees_principales %}
                                    {% include 'components/dialog/_form_row.html.twig' with { row: row, form: form, formCanvas: formCanvas, idEntreprise: idEntreprise, idInvite: idInvite } only %}
                                {% endfor %}
                            </div>
                        {% endif %}
                        {% for row in rangees_onglets %}
                            {% set actif = not a_un_principal and loop.first %}
                            <div class="jsb-onglets-panneau{{ actif ? '' : ' est-cache' }}"
                                 id="{{ uid }}-panneau-{{ row.colonnes[0].champs[0].field_code }}" role="tabpanel"
                                 tabindex="0" aria-labelledby="{{ uid }}-onglet-{{ row.colonnes[0].champs[0].field_code }}"
                                 data-onglets-formulaire-target="panneau"
                                 data-tab-id="{{ row.colonnes[0].champs[0].field_code }}">
                                {% include 'components/dialog/_form_row.html.twig' with { row: row, form: form, formCanvas: formCanvas, idEntreprise: idEntreprise, idInvite: idInvite } only %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            {% else %}
                {{ form_widget(form) }}
            {% endif %}

            {# Suppress fields that are in the form type but intentionally absent from the canvas layout.
               Calling setRendered() prevents form_end(render_rest:true) from rendering them as stray widgets. #}
            {% if formCanvas.parametres.suppress_fields is defined %}
                {% for suppressedField in formCanvas.parametres.suppress_fields %}
                    {% if form[suppressedField] is defined %}{% do form[suppressedField].setRendered() %}{% endif %}
                {% endfor %}
            {% endif %}

            {{ form_end(form, {'render_rest': true}) }}
        </div>
    </div>
