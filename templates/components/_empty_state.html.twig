{# templates/components/_empty_state.html.twig #}
{#
    Ce composant affiche un message "état vide" avec un appel à l'action.

    @param string title          Le titre principal (ex: "Votre liste est vide.")
    @param string description    Un texte descriptif (ex: "Commencez par ajouter un nouvel élément.")
    @param string button_text    Le texte du bouton (ex: "Ajouter un élément")
    @param string button_action  L'action Stimulus à déclencher au clic (ex: "collection#addItem" ou "list-manager#handleAddRequest")
    @param string icon_name      (Optionnel) Le nom de l'icône UX à afficher.
    @param array  button_2_cles  (Optionnel) Les critères que le bouton secondaire RETIRE — choisis
                                 par le serveur (CauseDeListeVide), lus par list-manager#retirerFiltres.
    @param string button_2_class (Optionnel) Niveau du bouton secondaire : `jsb-etat-vide__geste--secondaire`
                                 (défaut) ou `jsb-etat-vide__geste--discret`.
    @param bool   reinitialiser  (Optionnel) Offre « Réinitialiser » (critères PAR DÉFAUT de la liste),
                                 avant le bouton secondaire — décidé par le serveur : seulement si
                                 les critères ne sont pas déjà ceux par défaut.
#}
<div class="empty-state-container">
    <div class="empty-state-content">
        {% if icon_name is defined and icon_name %}
            <div class="empty-state-icon">
                <twig:UX:Icon name="{{ resolve_icon_name(icon_name) }}" aria-hidden="true" />
            </div>
        {% endif %}

        <h3 class="empty-state-title">{{ title|default('Cette liste est vide.') }}</h3>

        {% if description is defined and description %}
            <p class="empty-state-description">{{ description }}</p>
        {% endif %}

        {# LES GESTES, SUR UNE RANGÉE, EN TROIS NIVEAUX (Serge, 2026-10-29 : « pas professionnels »,
           « trop d'espace ») : discret (Réinitialiser), secondaire (Tout retirer, Afficher tout
           le cabinet), principal (Ajouter). « Réinitialiser » puis « Tout retirer » : l'ordre de
           la ligne des filtres. #}
        <div class="jsb-etat-vide__gestes">
            {% if reinitialiser is defined and reinitialiser %}
                <button type="button" class="jsb-etat-vide__geste jsb-etat-vide__geste--discret" data-action="click->list-manager#resetSearch">
                    <twig:UX:Icon name="lucide:rotate-cw" class="jsb-etat-vide__icone" aria-hidden="true" />
                    Réinitialiser
                </button>
            {% endif %}
            {% if button_2_text is defined and button_2_text and button_2_action is defined and button_2_action %}
                <button type="button" class="jsb-etat-vide__geste {{ button_2_class|default('jsb-etat-vide__geste--secondaire') }}" data-action="{{ button_2_action }}"
                        {%- if button_2_cles is defined %} data-list-manager-cles-param="{{ button_2_cles|json_encode }}"{% endif %}>
                    {% if button_2_icon is defined and button_2_icon %}
                        <twig:UX:Icon name="{{ resolve_icon_name(button_2_icon) }}" class="jsb-etat-vide__icone" aria-hidden="true" />
                    {% endif %}
                    {{ button_2_text }}
                </button>
            {% endif %}
            {% if button_text is defined and button_text and button_action is defined and button_action %}
                <button type="button" class="jsb-etat-vide__geste jsb-etat-vide__geste--principal" data-action="{{ button_action }}">
                    <twig:UX:Icon name="{{ resolve_icon_name(button_icon|default('lucide:plus-circle')) }}" class="jsb-etat-vide__icone" aria-hidden="true" />
                    {{ button_text }}
                </button>
            {% endif %}
        </div>
    </div>
</div>