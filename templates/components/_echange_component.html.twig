{#
  Composant « Importation / Exportation des données » de l'espace de travail.

  Aller-retour du portefeuille vers un classeur Excel unique, qui sert à la fois de
  fichier d'export et de gabarit d'import.

  Le PÉRIMÈTRE affiché ici n'est pas la liste des entités de l'application : c'est ce
  que CET invité a le droit de lire, ressource par ressource (CanevasDEchange). Deux
  collaborateurs de droits différents voient donc deux listes différentes — et c'est la
  même liste que l'assistant restitue, puisqu'ils lisent la même source.

  Langage visuel : charte JS Brokers (cobalt #0047AB), re-scopé sous .jsb-echange, et
  calqué sur .jsb-doccpt (documents comptables) dont cette rubrique est la voisine
  structurelle. AUCUN <script> inline (non exécuté dans les partials AJAX du
  workspace) : l'interactivité est portée par le contrôleur Stimulus `echange`.
#}
<div class="jsb-echange"
     data-controller="echange"
     data-echange-url-value="{{ path('admin.echange.workspace', {idEntreprise: idEntreprise}) }}"
     data-echange-onglet-value="{{ ongletActif }}"
     data-echange-export-url-value="{{ path('admin.echange.exporter_diffuse', {idEntreprise: idEntreprise}) }}"
     data-echange-import-url-value="{{ path('admin.echange.controler', {idEntreprise: idEntreprise}) }}"
     data-echange-id-entreprise-value="{{ idEntreprise }}">
    <style>
        .jsb-echange { padding: 1.25rem 1.5rem; }
        /* La rangée de chips est COLLANTE dans une liste, où elle suit la barre de
           contrôles. Cette rubrique n'a pas de liste au-dessus : on la remet dans le
           flux, sans toucher à la pilule ni aux chips eux-mêmes. */
        .jsb-echange .jsb-preset-filters-bar {
            position: static;
            padding: 0;
            margin: 1rem 0;
            border-bottom: 0;
            background: transparent;
        }
        .jsb-echange .cs-panel { background:#ffffff; border:1px solid #dee2e6; border-radius:12px; padding:1.1rem 1.25rem; margin-bottom:1rem; }

        /* Entête du composant. */
        .jsb-echange .ech-head { display:flex; align-items:center; gap:.75rem; margin:0 0 1rem; }
        .jsb-echange .ech-head-ic {
            width:44px; height:44px; border-radius:12px; flex:0 0 auto;
            background:#e8f0fb; color:#0047AB; display:flex; align-items:center; justify-content:center;
        }
        .jsb-echange .ech-head h2 { font-size:1.25rem; font-weight:700; color:#212529; margin:0; }
        .jsb-echange .ech-head p { color:#6c757d; font-size:.88rem; margin:.15rem 0 0; max-width:70ch; }

        /* Les sous-onglets n'ont AUCUN style ici : ils empruntent .jsb-preset-filters
           et .jsb-preset-chip d'app.css, le composant des filtres rapides des listes.
           Les redéfinir localement, c'était créer un troisième dialecte visuel pour la
           même idée. */

        /* Bandeau de facturation : permanent, sur les trois onglets. */
        .jsb-echange .ech-billing {
            display:flex; align-items:center; gap:.7rem; flex-wrap:wrap;
            border-radius:10px; padding:.75rem 1rem; margin-bottom:1rem;
            border:1px solid #dee2e6; background:#e8f0fb; color:#212529; font-size:.88rem;
        }
        .jsb-echange .ech-billing.is-payante { border-color:#ffc107; background:#fff3cd; color:#664d03; }
        .jsb-echange .ech-billing.is-bloquee { border-color:#f8d7da; background:#f8d7da; color:#842029; }
        .jsb-echange .ech-billing strong { font-weight:700; }
        .jsb-echange .ech-billing .ech-solde { margin-left:auto; font-variant-numeric:tabular-nums; }

        /* Périmètre : une ligne par ressource échangeable. */
        .jsb-echange .ech-titre { font-size:1.05rem; font-weight:700; color:#212529; margin:0 0 .25rem; }
        .jsb-echange .ech-table { width:100%; border-collapse:collapse; }
        .jsb-echange .ech-caption {
            caption-side:top; text-align:left; padding:0 0 .5rem;
            color:#6c757d; font-size:.82rem;
        }
        .jsb-echange .ech-table th, .jsb-echange .ech-table td {
            padding:.55rem .6rem; border-bottom:1px solid #f0f0f0; font-size:.88rem; vertical-align:middle;
        }
        .jsb-echange .ech-table thead th {
            color:#6c757d; font-weight:600; font-size:.76rem; text-transform:uppercase;
            letter-spacing:.03em; text-align:left; vertical-align:bottom;
        }
        .jsb-echange .ech-table td.num, .jsb-echange .ech-table th.num { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
        .jsb-echange .ech-table tbody tr:hover { background:#f8f9fa; }
        /* La ligne survolée ou active se signale aussi par un liseré cobalt : le fond
           gris seul ne suffit pas à qui distingue mal les nuances. */
        .jsb-echange .ech-table tbody tr { box-shadow:inset 3px 0 0 transparent; }
        .jsb-echange .ech-table tbody tr:hover { box-shadow:inset 3px 0 0 #0047AB; }
        .jsb-echange .ech-table tbody tr:focus-within { box-shadow:inset 3px 0 0 #0047AB; background:#f8f9fa; }

        /* La cellule de nom est un <th scope="row"> : on lui retire son allure d'en-tête. */
        .jsb-echange .ech-cell-nom { font-weight:400; text-align:left; }
        .jsb-echange .ech-res-nom {
            display:inline; font-weight:600; color:#212529; cursor:pointer; margin:0;
        }
        .jsb-echange .ech-res-nom:hover { color:#0047AB; }
        .jsb-echange .ech-res-feuille { display:block; color:#6c757d; font-size:.78rem; margin-top:.1rem; }
        .jsb-echange .ech-res-nb { font-weight:600; color:#212529; }
        .jsb-echange .ech-res-detail { display:block; color:#6c757d; font-size:.76rem; }
        .jsb-echange .ech-dep { color:#495057; font-size:.82rem; }

        /* Réservé aux lecteurs d'écran : un en-tête de colonne existe toujours, même
           quand la colonne ne porte qu'une case à cocher. */
        .jsb-echange .ech-sr {
            position:absolute; width:1px; height:1px; padding:0; margin:-1px;
            overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
        }

        /* Pastilles d'état. */
        .jsb-echange .ech-chip {
            display:inline-flex; align-items:center; gap:.3rem; padding:.15rem .5rem;
            border-radius:999px; font-size:.75rem; font-weight:600; white-space:nowrap;
        }
        .jsb-echange .ech-chip.is-lecture { background:#e8f0fb; color:#212529; }
        .jsb-echange .ech-chip.is-ecriture { background:#d1e7dd; color:#0f5132; }
        .jsb-echange .ech-chip.is-neutre { background:#e9ecef; color:#495057; }

        .jsb-echange .ech-vide { color:#6c757d; font-size:.9rem; padding:1.25rem 0; text-align:center; }
        .jsb-echange .ech-actions { display:flex; flex-wrap:wrap; gap:.6rem; align-items:center; justify-content:flex-end; margin-top:1rem; padding-top:1rem; border-top:1px solid #f0f0f0; }
        /* La barre de l'export ouvre le panneau au lieu de le fermer : le geste
           principal se lit d'abord, le périmètre le précise ensuite. Le trait passe
           donc DESSOUS, et la barre s'aligne à gauche comme tout ce qui la suit —
           un bouton isolé à droite, au-dessus d'un contenu aligné à gauche, casse
           la colonne de lecture. */
        .jsb-echange .ech-actions.ech-actions--tete {
            justify-content:flex-start;
            margin:0 0 1rem; padding:0 0 1rem;
            border-top:none; border-bottom:1px solid #f0f0f0;
        }
        .jsb-echange .btn-cobalt { background:#0047AB; border-color:#0047AB; color:#ffffff; }
        .jsb-echange .btn-cobalt:hover { background:#003380; border-color:#003380; color:#ffffff; }
        .jsb-echange .btn-cobalt:disabled { background:#0047AB; border-color:#0047AB; opacity:.65; cursor:not-allowed; }
        .jsb-echange .ech-actions .btn { display:inline-flex; align-items:center; gap:.4rem; white-space:nowrap; min-height:38px; }
        .jsb-echange .ech-note { color:#6c757d; font-size:.82rem; margin:.6rem 0 0; }

        /* Dépôt de fichier. */
        .jsb-echange .ech-depot { display:flex; flex-wrap:wrap; gap:.75rem; align-items:center; }
        .jsb-echange .ech-fichier {
            display:inline-flex; align-items:center; gap:.5rem; cursor:pointer;
            padding:.55rem .9rem; border:1px dashed #dee2e6; border-radius:10px;
            background:#f8f9fa; color:#212529; font-size:.88rem; font-weight:600;
            min-height:44px;
        }
        .jsb-echange .ech-fichier:hover { border-color:#0047AB; background:#e8f0fb; }
        .jsb-echange .ech-fichier:focus-within { outline:2px solid #0047AB; outline-offset:2px; }
        .jsb-echange .ech-fichier input[type="file"] { position:absolute; width:1px; height:1px; opacity:0; }
        .jsb-echange .ech-suppressions { display:inline-flex; align-items:center; gap:.4rem; font-size:.85rem; color:#495057; min-height:44px; }

        /* Sélection du périmètre. */
        .jsb-echange .ech-selection { display:flex; align-items:center; gap:.5rem; margin-bottom:.6rem; }
        .jsb-echange .ech-bouton-lien {
            border:1px solid #dee2e6; background:#ffffff; border-radius:8px;
            padding:.4rem .8rem; min-height:36px; cursor:pointer;
            color:#0047AB; font-size:.82rem; font-weight:600; font-family:inherit;
        }
        .jsb-echange .ech-bouton-lien:hover { background:#e8f0fb; border-color:#0047AB; color:#003380; }
        .jsb-echange .ech-bouton-lien:focus-visible { outline:2px solid #0047AB; outline-offset:2px; }
        .jsb-echange .ech-compte { margin-left:auto; color:#495057; font-size:.82rem; font-variant-numeric:tabular-nums; }

        /* ⚠ UNE LIGNE EXCLUE NE SE SIGNALE PAS QUE PAR LA COULEUR (WCAG 1.4.1).
           L'opacité seule est invisible à qui ne perçoit pas les nuances, et disparaît
           à l'impression. On y ajoute donc un texte, une rayure sur le nom, et un
           liseré : trois signaux pour un seul état. */
        .jsb-echange tr.is-exclue { opacity:.55; }
        .jsb-echange tr.is-exclue { box-shadow:inset 3px 0 0 #dee2e6; }
        .jsb-echange tr.is-exclue .ech-res-nom { text-decoration:line-through; color:#6c757d; }
        .jsb-echange tr.is-exclue .ech-res-etat::before {
            content:'exclue'; display:inline-block; margin-left:.4rem; padding:.05rem .4rem;
            border-radius:999px; background:#e9ecef; color:#495057;
            font-size:.7rem; font-weight:600; text-transform:uppercase; letter-spacing:.02em;
        }
        /* « Requise » ne s'affiche QUE sur une sélection partielle : quand tout est coché,
           tout est requis par quelque chose, et le mot ne distinguerait plus rien. */
        .jsb-echange tr.is-requise .ech-res-etat::before {
            content:'requise'; display:inline-block; margin-left:.4rem; padding:.05rem .4rem;
            border-radius:999px; background:#e8f0fb; color:#212529;
            font-size:.7rem; font-weight:600; text-transform:uppercase; letter-spacing:.02em;
        }

        /* ── Groupes par module ────────────────────────────────────────────────────
           Le module vient de la carte des droits : ces groupes portent exactement les
           mêmes noms que le menu de l'application. C'est ce qui permet à l'utilisateur
           de reconnaître au lieu de se rappeler (Nielsen 6). */
        .jsb-echange .ech-groupe {
            border:1px solid #dee2e6; border-radius:10px; background:#ffffff;
            margin-bottom:.6rem; overflow:hidden;
        }
        .jsb-echange .ech-groupe[open] { border-color:#0047AB; }
        .jsb-echange .ech-groupe-tete {
            display:flex; align-items:center; gap:.75rem; cursor:pointer;
            padding:.6rem .85rem; min-height:44px; background:#f8f9fa;
            font-size:.9rem; font-weight:700; color:#212529;
            list-style:none; user-select:none;
        }
        .jsb-echange .ech-groupe-tete::-webkit-details-marker { display:none; }
        .jsb-echange .ech-groupe-tete:hover { background:#e8f0fb; }
        .jsb-echange .ech-groupe-tete:focus-visible { outline:2px solid #0047AB; outline-offset:-2px; }
        .jsb-echange .ech-groupe-nom { margin:0; }
        .jsb-echange .ech-groupe-compte {
            margin-left:auto; padding:.1rem .5rem; border-radius:999px;
            background:#e9ecef; color:#495057;
            font-size:.75rem; font-weight:600; font-variant-numeric:tabular-nums;
        }
        /* Le compte passe au cobalt dès que le groupe n'est plus entier : la couleur
           double un texte qui dit déjà « 4 sur 10 » — jamais elle ne le remplace
           (WCAG 1.4.1). */
        .jsb-echange .ech-groupe-compte.is-partiel { background:#e8f0fb; color:#0047AB; }
        .jsb-echange .ech-groupe-compte.is-vide { background:#e9ecef; color:#6c757d; }
        /* Chevron en CSS : il ne dit rien que l'état ouvert/fermé n'exprime déjà. */
        .jsb-echange .ech-groupe-chevron {
            width:9px; height:9px; flex:0 0 auto;
            border-right:2px solid #6c757d; border-bottom:2px solid #6c757d;
            transform:rotate(45deg); transform-origin:center;
            transition:transform .18s ease;
        }
        .jsb-echange details[open] > summary .ech-groupe-chevron { transform:rotate(-135deg); }
        .jsb-echange .ech-groupe .ech-table { border-top:1px solid #dee2e6; }
        .jsb-echange .ech-groupe .ech-table thead th { background:#ffffff; }

        /* ⚠ TROISIÈME ÉTAT D'UN CHIP : partiellement retenu.
           Le gabarit de liste n'en a que deux, parce qu'un filtre est posé ou ne l'est
           pas. Ici une famille peut être à moitié retenue sans qu'on l'ait demandé —
           une dépendance tirée depuis une autre famille — et confondre ce cas avec
           « écartée » ferait croire qu'on n'exporte rien alors que deux données
           sortiront. Le compteur l'écrit ; ceci ne fait que le rendre visible de loin. */
        .jsb-echange .jsb-preset-chip[aria-pressed="mixed"] {
            background:#e8f0fb; color:#0047AB;
            box-shadow:inset 0 0 0 1px #0047AB;
        }
        .jsb-echange .jsb-preset-chip[aria-pressed="mixed"] .jsb-preset-chip__count {
            background:rgba(0, 71, 171, 0.16); color:#0047AB;
        }
        .jsb-echange .jsb-preset-chip[aria-pressed="false"] .jsb-preset-chip__icon { opacity:.35; }

        /* Le gabarit vierge. Sorti du volet de réglage, il est devenu un élément de
           premier plan : il ne peut plus se contenter du flux par défaut d'un <p>. */
        .jsb-echange .ech-gabarit {
            display:flex; flex-wrap:wrap; align-items:center; gap:.6rem;
            margin:0 0 1rem;
        }
        /* Dans la barre d'actions, le gabarit n'est plus un bloc : il s'aligne sur ses
           voisins et abandonne sa marge. */
        .jsb-echange .ech-actions .ech-gabarit { margin:0; }
        .jsb-echange .ech-gabarit .btn { display:inline-flex; align-items:center; gap:.4rem; white-space:nowrap; min-height:38px; }
        /* Un lien désarmé (aucune donnée retenue) ne doit pas se donner l'air cliquable. */
        .jsb-echange .ech-gabarit a[aria-disabled="true"] { opacity:.65; pointer-events:none; }

        /* Rappel d'un périmètre restauré. Ton d'information, pas d'alerte : rien n'est
           en panne, on signale seulement d'où vient l'état affiché. */
        .jsb-echange .ech-rappel {
            display:flex; align-items:center; gap:.5rem;
            margin:0 0 .75rem; padding:.55rem .8rem;
            border-radius:8px; background:#e8f0fb; color:#212529;
            font-size:.83rem;
        }

        /* Le volet du périmètre : replié par défaut, dans les DEUX onglets. C'est un
           réglage, pas une étape — et cinq groupes déroulés d'office faisaient trois
           écrans de hauteur avant d'atteindre le bouton. */
        .jsb-echange .ech-perimetre-volet {
            border:1px dashed #dee2e6; border-radius:10px; padding:.25rem .85rem;
            margin-bottom:1rem; background:#ffffff;
        }
        .jsb-echange .ech-perimetre-volet[open] { border-style:solid; border-color:#0047AB; padding-bottom:.85rem; }
        .jsb-echange .ech-perimetre-tete {
            display:flex; align-items:center; gap:.6rem; cursor:pointer;
            min-height:44px; list-style:none; user-select:none;
            font-size:.88rem; font-weight:600; color:#0047AB;
        }
        .jsb-echange .ech-perimetre-tete::-webkit-details-marker { display:none; }
        .jsb-echange .ech-perimetre-tete:focus-visible { outline:2px solid #0047AB; outline-offset:2px; }
        .jsb-echange .ech-perimetre-tete .ech-groupe-chevron { margin-left:auto; }

        /* Rapport de contrôle. */
        .jsb-echange .ech-rapport { margin-top:1.25rem; padding-top:1rem; border-top:1px solid #f0f0f0; }
        .jsb-echange .ech-synthese { display:flex; flex-wrap:wrap; gap:1.25rem; font-size:.88rem; color:#495057; }
        .jsb-echange .ech-synthese strong { color:#212529; font-variant-numeric:tabular-nums; }
        .jsb-echange .ech-chip.is-erreur { background:#f8d7da; color:#842029; }
        .jsb-echange .ech-chip.is-avertissement { background:#fff3cd; color:#664d03; }
    </style>

    {# ── Entête ── #}
    <div class="ech-head">
        <div class="ech-head-ic" aria-hidden="true">
            <twig:UX:Icon name="{{ resolve_icon_name('echange') }}" style="width:24px;height:24px;" />
        </div>
        <div>
            <h2>Importation / Exportation</h2>
            <p>
                Exportez vos données dans un classeur Excel, travaillez dessus hors ligne, puis
                réimportez le même fichier. Format Excel (.xlsx) exclusivement.
            </p>
        </div>
    </div>

    {# ── Bandeau de facturation : le coût s'annonce AVANT, jamais après ── #}
    {% set billingClass = facturation.gratuitesRestantes > 0
        ? ''
        : (facturation.exportFinancable ? 'is-payante' : 'is-bloquee') %}
    <div class="ech-billing {{ billingClass }}" role="status">
        <twig:UX:Icon name="{{ resolve_icon_name('action:information') }}" style="width:18px;height:18px;flex:0 0 auto;" />
        <span>
            {% if facturation.gratuitesRestantes > 0 %}
                <strong>{{ facturation.gratuitesRestantes }}</strong>
                opération{{ facturation.gratuitesRestantes > 1 ? 's' : '' }}
                gratuite{{ facturation.gratuitesRestantes > 1 ? 's' : '' }}
                restante{{ facturation.gratuitesRestantes > 1 ? 's' : '' }}
                sur {{ facturation.quotaGratuit }}.
            {% elseif facturation.exportFinancable %}
                La prochaine exportation sera facturée <strong>{{ facturation.coutExport }} tokens</strong>.
            {% else %}
                Solde insuffisant : l'exportation coûte <strong>{{ facturation.coutExport }} tokens</strong>.
            {% endif %}
            L'importation n'est pas facturée à l'opération : chaque ligne écrite paie le même
            métrage qu'une saisie à l'écran.
        </span>
        <span class="ech-solde">Solde : {{ facturation.soldeDisponible|number_format(0, ',', ' ') }} tokens</span>
    </div>

    {# ── Sous-onglets ──
       Markup REPRIS TEL QUEL des filtres rapides des listes (_List_manager.html.twig) :
       rangée `.jsb-preset-filters-bar`, piste `.jsb-preset-filters.jsb-control-pill`,
       titre TEXTUEL du critère en tête, puis les chips — l'actif en pastille cobalt.
       Aucune classe propre à la rubrique : c'est le composant de la maison, pas une
       imitation. Le titre est purement textuel ; l'icône appartient au chip, où elle
       dit l'état — c'est la règle de toutes les rubriques.

       Des boutons et non des liens : le composant se recharge en AJAX. #}
    {% set onglets = {'exporter': 'echange-export', 'importer': 'echange-import', 'historique': 'action:ongoing'} %}
    {% set libelles = {'exporter': 'Exporter', 'importer': 'Importer', 'historique': 'Historique'} %}
    <div class="jsb-preset-filters-bar">
        <div class="jsb-preset-filters jsb-control-pill" role="group" aria-label="Vue de la rubrique">
            <span class="jsb-preset-filters__titre" aria-hidden="true">vue</span>
            {% for cle, icone in onglets %}
                {# L'onglet « Importer » n'apparaît pas sans droit d'écriture : proposer
                   une porte qui se refuse est une promesse qu'on ne tient pas. #}
                {% if cle != 'importer' or peutImporter %}
                    <button type="button"
                            class="jsb-preset-chip{{ cle == ongletActif ? ' is-active' : '' }}"
                            data-action="click->echange#changeOnglet"
                            data-echange-onglet-param="{{ cle }}"
                            aria-pressed="{{ cle == ongletActif ? 'true' : 'false' }}">
                        <span class="jsb-preset-chip__icon" aria-hidden="true">
                            {{ ux_icon(resolve_icon_name(icone), {width: '15px', height: '15px'}) }}
                        </span>
                        <span>{{ libelles[cle] }}</span>
                    </button>
                {% endif %}
            {% endfor %}
        </div>
    </div>

    {# ── EXPORTER ── #}
    {% if ongletActif == 'exporter' %}
        <div class="cs-panel">
            <h3 class="ech-titre" id="ech-perimetre-titre">Que voulez-vous exporter ?</h3>
            <p class="ech-note" style="margin:0 0 1rem;">
                L'export produit <strong>l'état de votre portefeuille</strong> : une ligne par
                tranche, et sur cette ligne la police, l'assuré, l'assureur, la prime et son
                solde, la commission, ses taxes, votre réserve et les rétrocommissions.
                <strong>C'est un état de lecture</strong> — il ne se redépose pas, ses colonnes
                étant des résultats et non des champs. Pour préparer des données à importer,
                prenez le gabarit vierge de l'onglet Importer. Vous pouvez ne retenir que
                <strong>les colonnes qui vous servent</strong>.
            </p>

            {# Le bouton est DÉSARMÉ pendant l'opération (echange#exporter) : un double
               clic produirait deux fichiers et, sans la clé d'idempotence, deux
               occurrences facturées. #}
            <div class="ech-actions ech-actions--tete">
                {% if not facturation.exportFinancable %}
                    <span class="ech-note" style="margin:0;">
                        Rechargez votre solde pour exporter : il manque
                        {{ (facturation.coutExport - facturation.soldeDisponible)|number_format(0, ',', ' ') }} tokens.
                    </span>
                {% endif %}
                <button type="button"
                        class="btn btn-sm btn-cobalt"
                        data-echange-target="boutonExport"
                        data-action="click->echange#exporter"
                        {{ (ressources is empty or not facturation.exportFinancable) ? 'disabled' : '' }}>
                    <twig:UX:Icon name="{{ resolve_icon_name('echange-export') }}" style="width:18px;height:18px;" />
                    <span>
                        Générer l'export
                        {%- if facturation.coutExport > 0 %} ({{ facturation.coutExport }} tokens){% endif %}
                    </span>
                </button>

                {# ⚠ PLUS DE GABARIT ICI. C'est un outil d'IMPORT : on le remplit pour le
                   déposer. Il vivait à cette barre parce que l'export produisait, lui
                   aussi, un fichier d'échange — ce n'est plus le cas. Il est resté dans
                   l'onglet Importer, où il sert. #}
            </div>

            {# ⚠ CE VOLET NE CHOISIT PLUS DES DONNÉES, MAIS DES COLONNES. L'état a une
               maille fixe — une ligne par tranche — et n'a pas de familles d'entités à
               retenir. Le gabarit vierge, lui, a quitté cet onglet : c'est un outil
               d'import, il vit là où on s'en sert. #}
            {% include 'components/echange/_colonnes.html.twig' with {
                colonnesParGroupe: colonnesParGroupe,
                identite: colonneIdentite,
                total: colonnesTotal
            } only %}

        </div>
    {% endif %}

    {# ── IMPORTER ── #}
    {% if ongletActif == 'importer' %}
        <div class="cs-panel">
            <h3 style="font-size:1.05rem;font-weight:700;color:#212529;margin:0 0 .25rem;">Importer un classeur</h3>
            <p class="ech-note" style="margin:0 0 1rem;">
                Le fichier déposé doit être un classeur produit par cette rubrique. Il est d'abord
                contrôlé à blanc — gratuitement, sans rien écrire — et vous ne confirmez qu'ensuite,
                au vu du rapport.
            </p>
            {# ⚠ ÉCARTER DES FEUILLES SANS LE DIRE SERAIT UNE TRAHISON. Le périmètre arrive
               restreint à la production ; le volet qui le montre est replié. Sans cette
               phrase, un classeur complet serait repris à moitié et l'utilisateur ne
               l'apprendrait qu'au rapport — ou jamais. #}
            <p class="ech-note" style="margin:0 0 1rem;">
                Par défaut, seules vos <strong>données de production</strong> seront reprises :
                les autres feuilles du fichier seront ignorées. Pour en reprendre davantage,
                ouvrez « Choisir ce qu'on reprend du fichier », en bas de ce panneau.
            </p>

            {# ⚠ LE GABARIT PRÉCÈDE LE DÉPÔT, ET HORS DE TOUT VOLET. On le remplit pour
               le déposer : le proposer après le dépôt, ou l'enfermer dans un réglage
               replié, c'est le proposer à qui n'en a plus besoin. #}
            {% if parModule is not empty %}
                {% include 'components/echange/_gabarit.html.twig' with {
                    idEntreprise: idEntreprise,
                    contexte: 'importer'
                } only %}
            {% endif %}

            {# ── Dépôt ── #}
            <div class="ech-depot">
                <label class="ech-fichier">
                    <input type="file"
                           accept=".xlsx"
                           data-echange-target="fichier"
                           data-action="change->echange#fichierChoisi">
                    <twig:UX:Icon name="{{ resolve_icon_name('echange-import') }}" style="width:20px;height:20px;" />
                    <span data-echange-target="nomFichier">Choisir un classeur .xlsx</span>
                </label>

                {# La case est DÉCOCHÉE par défaut, et le restera : une colonne « Action »
                   mal recopiée ne doit pas pouvoir vider une feuille entière. #}
                <label class="ech-suppressions">
                    <input type="checkbox" data-echange-target="suppressions">
                    <span>Autoriser les suppressions demandées par le fichier</span>
                </label>

                <button type="button"
                        class="btn btn-sm btn-cobalt"
                        data-echange-target="boutonControle"
                        data-action="click->echange#controler"
                        disabled>
                    <twig:UX:Icon name="{{ resolve_icon_name('action:analyser') }}" style="width:18px;height:18px;" />
                    <span>Contrôler le fichier</span>
                </button>
            </div>
            <p class="ech-note">
                Le contrôle est gratuit et n'écrit rien : vous pouvez le relancer autant de fois
                qu'il le faut pour corriger votre fichier.
            </p>

            {# ── Ce qu'on reprend ── #}
            {#
              LE RÉGLAGE FERME LA MARCHE, replié, comme à l'export. La plupart des dépôts
              n'y touchent pas : la production convient telle quelle, et le paragraphe du
              haut l'annonce déjà. Le laisser en travers du chemin, déroulé, c'était trois
              écrans à franchir pour atteindre le bouton qu'on venait chercher.

              ⚠ IL RESTE AVANT LE CONTRÔLE, ET C'EST CE QUI COMPTE. Le contrôle est le
              compte rendu de ce qui va être écrit : décocher après lui obligerait à tout
              recontrôler, et l'utilisateur relirait un rapport qui ne décrit plus le geste
              qu'il s'apprête à faire. Sa place dans la page a changé, pas sa place dans
              l'enchaînement.
            #}
            {% if parModule is not empty %}
                {% include 'components/echange/_perimetre.html.twig' with {
                    parModule: parModule,
                    ecrivables: ecrivables,
                    ressources: ressources,
                    defauts: defauts,
                    contexte: 'importer'
                } only %}
            {% endif %}

            {# ── Contrôle en attente ── #}
            <div data-echange-target="rapport">
                {% if controleEnCours %}
                    {% set rapport = controleEnCours.rapport %}
                    <div class="ech-rapport" data-echange-run-id="{{ controleEnCours.id }}">
                        <div class="ech-billing" role="status">
                            <twig:UX:Icon name="{{ resolve_icon_name('action:information') }}" style="width:18px;height:18px;flex:0 0 auto;" />
                            <span>
                                Contrôle en attente de votre décision :
                                <strong>{{ controleEnCours.nomFichier }}</strong>,
                                déposé le {{ controleEnCours.createdAt|date('d/m/Y H:i') }}.
                            </span>
                        </div>

                        <div class="ech-synthese">
                            <span><strong>{{ rapport.creations|default(0) }}</strong> création(s)</span>
                            <span><strong>{{ rapport.modifications|default(0) }}</strong> mise(s) à jour</span>
                            <span><strong>{{ rapport.suppressions|default(0) }}</strong> suppression(s)</span>
                            <span><strong>{{ rapport.lignes_lues|default(0) }}</strong> ligne(s) lue(s)</span>
                        </div>

                        {% if rapport.anomalies|default([])|length %}
                            <table class="ech-table" style="margin-top:1rem;">
                                <thead>
                                    <tr>
                                        <th style="width:8rem;">Gravité</th>
                                        <th style="width:16rem;">Où</th>
                                        <th>Ce qu'il faut corriger</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for anomalie in rapport.anomalies|slice(0, 100) %}
                                        <tr>
                                            <td>
                                                <span class="ech-chip {{ anomalie.gravite == 'ERREUR' ? 'is-erreur' : 'is-avertissement' }}">
                                                    {{ anomalie.gravite == 'ERREUR' ? 'Erreur' : 'Avertissement' }}
                                                </span>
                                            </td>
                                            <td class="ech-dep">
                                                {{ [anomalie.feuille, anomalie.ligne ? 'ligne ' ~ anomalie.ligne : null, anomalie.colonne ? 'col. ' ~ anomalie.colonne : null]|filter(v => v)|join(', ') ?: '—' }}
                                            </td>
                                            <td>{{ anomalie.message }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                            {% if rapport.anomalies|length > 100 %}
                                <p class="ech-note">… et {{ rapport.anomalies|length - 100 }} autre(s) anomalie(s).</p>
                            {% endif %}
                        {% endif %}

                        <div class="ech-actions">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    data-action="click->echange#annuler"
                                    data-echange-run-param="{{ controleEnCours.id }}">
                                <twig:UX:Icon name="{{ resolve_icon_name('action:cancel') }}" style="width:18px;height:18px;" />
                                <span>Abandonner</span>
                            </button>

                            {# LE FICHIER RENDU ANNOTÉ. C'est la réponse à « et maintenant ? » :
                               lire « feuille Clients, ligne 47, colonne M » à l'écran puis
                               retrouver la cellule dans son classeur, trois cents fois, est un
                               travail de copiste — et c'est là qu'on abandonne, pas à l'erreur.
                               Proposé dès qu'il y a quelque chose à corriger, y compris quand le
                               contrôle est confirmable : un avertissement mérite d'être vu en
                               place avant qu'on ne l'accepte (Nielsen 9). #}
                            {% if rapport.anomalies|default([])|length %}
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="{{ path('admin.echange.anomalies', {idEntreprise: idEntreprise, idRun: controleEnCours.id}) }}"
                                   title="Votre propre classeur, avec les cellules fautives surlignées et le motif en commentaire.">
                                    <twig:UX:Icon name="{{ resolve_icon_name('action:download') }}" style="width:18px;height:18px;" />
                                    <span>Télécharger le fichier annoté</span>
                                </a>
                            {% endif %}
                            {# Le bouton n'existe QUE si le rapport est exécutable : il n'y a pas
                               d'import partiel, et proposer « importer quand même » serait
                               proposer de laisser la base dans un état que personne n'a décrit. #}
                            {% if controleEnCours.estConfirmable %}
                                <button type="button"
                                        class="btn btn-sm btn-cobalt"
                                        data-echange-target="boutonConfirmation"
                                        data-action="click->echange#confirmer"
                                        data-echange-run-param="{{ controleEnCours.id }}">
                                    <twig:UX:Icon name="{{ resolve_icon_name('action:check') }}" style="width:18px;height:18px;" />
                                    <span>Confirmer l'importation</span>
                                </button>
                            {% else %}
                                <span class="ech-note" style="margin:0;">
                                    Corrigez les erreurs ci-dessus dans votre fichier, puis redéposez-le.
                                </span>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {# ── HISTORIQUE ── #}
    {% if ongletActif == 'historique' %}
        <div class="cs-panel">
            <h3 style="font-size:1.05rem;font-weight:700;color:#212529;margin:0 0 .25rem;">Historique des opérations</h3>
            <p class="ech-note" style="margin:0 0 1rem;">
                Un export fait sortir du cabinet des données personnelles de prospects et d'assurés.
                Ce journal n'est pas effaçable depuis cette page — c'est ce qui en fait une trace.
            </p>

            {% if historique is empty %}
                <p class="ech-vide">Aucune opération d'échange à ce jour.</p>
            {% else %}
                <table class="ech-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Opération</th>
                            <th>Auteur</th>
                            <th>Périmètre</th>
                            <th class="num">Lignes</th>
                            <th class="num">Coût</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for occurrence in historique %}
                            <tr>
                                <td>{{ occurrence.createdAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    <span class="ech-chip {{ occurrence.type == typeExport ? 'is-lecture' : 'is-ecriture' }}">
                                        {{ occurrence.typeLibelle }}
                                    </span>
                                </td>
                                <td>{{ occurrence.invite ? occurrence.invite.nom : '—' }}</td>
                                <td class="ech-dep">
                                    {{ occurrence.perimetre is empty ? '—' : occurrence.perimetre|length ~ ' donnée' ~ (occurrence.perimetre|length > 1 ? 's' : '') }}
                                </td>
                                <td class="num">{{ occurrence.nbLignes|number_format(0, ',', ' ') }}</td>
                                <td class="num">
                                    {% if occurrence.tokensDebites > 0 %}
                                        {{ occurrence.tokensDebites|number_format(0, ',', ' ') }} tokens
                                    {% else %}
                                        <span class="ech-chip is-neutre">Sans forfait</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    {% endif %}
</div>
