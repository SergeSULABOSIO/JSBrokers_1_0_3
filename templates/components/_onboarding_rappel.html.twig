{#
   LE RAPPEL DE LA DETTE DE CONFIGURATION — un seul gabarit, deux surfaces.

   Un onboarding inachevé est une dette réelle du cabinet envers lui-même. Elle se rappelle
   donc partout : en permanence dans la colonne 1 (`voyant`) et en grand sur l'écran
   d'arrivée (`bandeau`). Écrire le texte de la dette à deux endroits aurait garanti qu'ils
   finissent par se contredire — c'est la raison d'être de ce partiel unique.

   Variables attendues :
     - bilan        : sortie d'OnboardingCompletude (score, etapes, restantes, complet)
     - etapesCitees : les étapes restantes les plus lourdes, déjà triées côté PHP
     - variante     : 'voyant' | 'bandeau'

   Rien n'est rendu quand la dette est soldée : un voyant bloqué à 100 % n'est plus que du
   bruit, et l'écran redevient un tableau de bord.
#}
{% import _self as rappel %}

{% if bilan.complet is not defined or not bilan.complet %}
    {% set _restantes = bilan.restantes|length %}

    {#
       La description affichée en colonne 2 au survol de l'item. Volontairement une CHAÎNE
       et non un bloc `{% set %}` : capturée en bloc, elle deviendrait un Markup considéré
       comme sûr, que le filtre d'échappement laisserait passer tel quel — ses balises
       casseraient alors l'attribut qui la transporte.
    #}
    {% set _description = '<p><strong>La configuration de votre cabinet est incomplète.</strong> Tant qu\'elle l\'est, certaines opérations resteront hors de portée : on ne peut pas coter sans assureur, ni encaisser sans compte bancaire.</p><p>Le guide de démarrage rassemble tout ce qu\'il reste à faire, au même endroit. Chaque étape s\'y règle sans quitter la page, et vous pouvez la reprendre quand vous voulez.</p>' %}

    {#
       Les attributs qui ouvrent le guide. Le composant est chargé par le MÊME chemin que
       n'importe quelle rubrique (`workspace-manager#loadComponent`) : même onglet unique,
       même restauration après rechargement.
    #}
    {% set _ouvrir %}
        data-workspace-manager-component-name-param="_onboarding_component.html.twig"
        data-workspace-manager-entity-name-param="Onboarding"
        data-workspace-manager-group-name-param=""
        data-workspace-manager-icon-param="action:settings"
        data-workspace-manager-description-param="{{ _description|e('html_attr') }}"
    {% endset %}

    {% if variante == 'voyant' %}
        {#
           Un <button> et non un <a> : un lien de la colonne 1 qui porterait un filtre
           `keydown.enter` s'activerait deux fois (cf. ColonneDeuxRepliableTest), et il n'y
           a de toute façon aucune URL à atteindre — le guide se charge en place.

           ⚠ Le titre de l'onglet est lu par le contrôleur dans `.nav-text` : c'est pourquoi
           le pourcentage vit dans un span à part. Le mettre dans `.nav-text` aurait
           intitulé l'onglet « 45 % ».
        #}
        <button type="button"
            class="nav-item ws-onboarding-jauge"
            data-controller="onboarding-jauge"
            data-onboarding-jauge-auto-ouvrir-value="{{ autoOuvrir|default(false) ? 'true' : 'false' }}"
            data-action="mouseenter->onboarding-jauge#ouvrir mouseleave->onboarding-jauge#fermerDiffere focus->onboarding-jauge#ouvrir blur->onboarding-jauge#fermerDiffere click->workspace-manager#loadComponent"
            {{ _ouvrir|raw }}
            aria-label="Démarrage du cabinet : {{ bilan.score }} % configuré, {{ _restantes }} étape{{ _restantes > 1 ? 's' : '' }} restante{{ _restantes > 1 ? 's' : '' }}. Ouvrir le guide."
        >
            {# L'anneau ne porte AUCUNE information à lui seul : le pourcentage est écrit
               juste à côté, et l'aria-label le redit (WCAG 1.4.1). #}
            <span class="ws-jauge-anneau" aria-hidden="true" style="--ws-jauge-pct: {{ bilan.score }};">
                <span class="ws-jauge-icone">{{ ux_icon('mdi:rocket-launch-outline', {height: '17px', width: '17px'}) }}</span>
            </span>
            <span class="nav-text">Démarrage</span>
            <span class="ws-jauge-pct">{{ bilan.score }} %</span>
        </button>

        {# Le contenu de l'infobulle est rendu ICI, côté serveur : aucune requête au survol,
           et un test de gabarit peut le lire. Le contrôleur le déplace sous <body> pour
           échapper à l'`overflow` de la colonne. #}
        <template data-onboarding-jauge-target="modele">
            <div class="ws-onboarding-detail" role="note">
                <p class="ws-onboarding-detail-titre">Démarrage du cabinet</p>
                {{ rappel.progression(bilan.score) }}
                {{ rappel.listeEtapes(bilan) }}
                {# CE BOUTON NE PORTE PAS DE `data-action`, ET C'EST VOULU : le panneau
                   est déplacé sous <body> pour échapper au rognage de la colonne, donc
                   hors de la portée de tout contrôleur Stimulus. Des attributs d'action
                   y seraient inertes — et donc trompeurs. Le contrôleur lui attache un
                   écouteur ordinaire, qui rejoue le clic sur le voyant lui-même. #}
                <button type="button" class="ws-onboarding-cta" data-onboarding-cta>
                    Reprendre la configuration
                </button>
            </div>
        </template>

    {% elseif variante == 'bandeau' %}
        {#
           role="note" et non "alert" : ce n'est pas une erreur de saisie, et un `alert`
           serait annoncé de façon intrusive à chaque arrivée sur le tableau de bord
           (WCAG 4.1.3). Même raisonnement que le bandeau `form_alerte` des dialogues.
        #}
        <div class="jsb-onboarding-bandeau" role="note">
            <span class="jsb-onboarding-bandeau-icone" aria-hidden="true">
                {{ ux_icon('mdi:rocket-launch-outline', {height: '28px', width: '28px'}) }}
            </span>
            <div class="jsb-onboarding-bandeau-corps">
                <p class="jsb-onboarding-bandeau-titre">
                    Votre cabinet n'est configuré qu'à {{ bilan.score }} %
                    <span class="jsb-onboarding-bandeau-reste">{{ _restantes }} étape{{ _restantes > 1 ? 's' : '' }} restante{{ _restantes > 1 ? 's' : '' }}</span>
                </p>
                {{ rappel.progression(bilan.score) }}
                {# NOMMER ce qui bloque, et pas seulement le mesurer : un pourcentage ne dit
                   pas quoi faire, une liste de manques si. #}
                {% if etapesCitees|default([])|length > 0 %}
                    <p class="jsb-onboarding-bandeau-manques">
                        Il vous manque encore
                        {%- for etape in etapesCitees %} <strong>{{ etape.libelle }}</strong>{{ loop.last ? '.' : ',' }}{% endfor %}
                    </p>
                {% endif %}
            </div>
            <button type="button" class="jsb-onboarding-cta-primaire" {{ _ouvrir|raw }}>
                Terminer la configuration
            </button>
        </div>
    {% endif %}
{% endif %}

{# La barre de progression, avec sa valeur écrite pour l'assistance. #}
{% macro progression(score) %}
    <div class="jsb-onboarding-barre" role="progressbar"
         aria-valuenow="{{ score }}" aria-valuemin="0" aria-valuemax="100"
         aria-label="Configuration du cabinet">
        <span class="jsb-onboarding-barre-remplie" style="width: {{ score }}%;"></span>
    </div>
{% endmacro %}

{# Le détail de l'infobulle : ce qui est fait, ce qu'il reste. Les états ne reposent pas
   sur la seule couleur — ✓ / ○ et les libellés portent l'information (WCAG 1.4.1). #}
{% macro listeEtapes(bilan) %}
    <ul class="ws-onboarding-liste">
        {% for etape in bilan.etapes %}
            <li class="ws-onboarding-liste-item{{ etape.fait ? ' est-fait' : '' }}">
                <span class="ws-onboarding-puce" aria-hidden="true">{{ etape.fait ? '✓' : '○' }}</span>
                <span class="ws-onboarding-liste-libelle">{{ etape.libelle }}</span>
                <span class="ws-onboarding-liste-etat">
                    {{- etape.fait ? (etape.nombre > 0 ? etape.nombre ~ ' enregistré' ~ (etape.nombre > 1 ? 's' : '') : 'fait') : 'à faire' -}}
                </span>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}
