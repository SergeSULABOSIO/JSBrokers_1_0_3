{#
    LES VERSEMENTS DÉJÀ ENREGISTRÉS — une ligne par VIREMENT.

    Ce volet ne double pas la rubrique « Reversements de rétrocommission ». La rubrique
    montre la base telle qu'elle est : un virement qui solde trois affaires y paraît en
    trois lignes. Ici, on regroupe par lot — un décaissement, une ligne, une preuve — parce
    que c'est ainsi que le courtier a payé, et parce que le justificatif est unique.

    LES DEUX ACTIONS SONT CELLES DES FICHES. Elles émettent les MÊMES événements que les
    actions de canevas (`ui:documents.attach-request`, `ui:documents.liste-request`), déjà
    traités par le cerveau : la boîte qui s'ouvre est celle que l'utilisateur connaît, et
    rien n'est recâblé ici.

    Facture : jsb-picker-* d'app.css comme le reste du rapport (/charte-couleurs, cobalt
    #0047AB) ; tableau sémantique avec scope sur les en-têtes (/ergonomie-web, WCAG 1.3.1).
#}
<div class="rva-wrap"
     data-controller="retro-agent-versements"
     data-retro-agent-versements-attacher-url-value="{{ attacherUrlPattern }}"
     data-retro-agent-versements-rapport-url-value="{{ rapportUrl }}">
    <style>
        /* La carte reprend celle du picker : une facture propre à cet écran cesserait de
           suivre la charte au premier ajustement. */
        .rva-wrap { padding: 1.25rem; }
        .rva-carte {
            background-color: var(--bg-white, #ffffff);
            border: 1px solid var(--border-light, #dee2e6);
            border-radius: 10px;
            overflow: hidden;
        }
        .rva-titre {
            margin: 0;
            padding: .85rem 1.25rem;
            border-bottom: 2px solid var(--cobalt, #0047AB);
            font-size: .95rem;
            font-weight: 600;
            color: #0d2440;
        }
        .rva-table { margin: 0; }
        .rva-table > :not(caption) > * > * { padding: .6rem .85rem; vertical-align: middle; }
        .rva-table thead th {
            background-color: var(--bg-light, #f8f9fa);
            color: var(--text-body, #495057);
            font-size: .78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .02em;
            white-space: nowrap;
        }
        .rva-num { text-align: right; font-variant-numeric: tabular-nums; }
        /* SANS PIÈCE, ON LE DIT. Les versements enregistrés avant que la preuve soit
           exigée s'affichent à zéro : la dette de preuve est visible, pas masquée. */
        .rva-sans-piece { color: var(--danger, #dc3545); font-weight: 600; }
        .rva-avec-piece { color: var(--success, #198754); font-weight: 600; }
        .rva-affaires { color: var(--text-muted, #6c757d); font-size: .82rem; }
    </style>

    {# LE RETOUR EST INDISPENSABLE, PAS DÉCORATIF. Ce volet REMPLACE le rapport dans
       le même onglet : sans ce bouton, on ne peut plus revenir au rapport de l'agent
       qu'en refermant l'onglet et en repartant de la liste des invités — refaire tout
       le chemin pour un aller-retour. #}
    <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-2 mb-3"
            data-action="retro-agent-versements#retour">
        {# SVG inline, comme les poignées de bord du workspace : aucune flèche gauche
           n'est vendue localement dans les jeux d'icônes du projet, et un alias
           inconnu ferait dépendre ce bouton d'une récupération en ligne. #}
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>
        </svg>
        Retour au rapport de production
    </button>

    <div class="rva-carte">
        <h6 class="rva-titre">Versements enregistrés — {{ agent.nom }}</h6>

        {% if lots is empty %}
            <p class="jsb-picker-empty text-muted m-0 p-4" role="status">
                Aucun versement enregistré pour cet agent.
            </p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm rva-table" aria-label="Virements enregistrés pour cet agent">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Référence</th>
                            <th scope="col">Compte débité</th>
                            <th scope="col">Affaires réglées</th>
                            <th scope="col" class="rva-num">Total</th>
                            <th scope="col">Justificatif</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cle, lot in lots %}
                            {% set nbPieces = pieces[cle]|default(0) %}
                            <tr data-rva-lot="{{ cle }}">
                                <td>{{ lot.porteur.paidAt ? lot.porteur.paidAt|date('d/m/Y') : 'N/A' }}</td>
                                <td>{{ lot.porteur.reference ?: '—' }}</td>
                                <td>{{ lot.porteur.compteBancaire ? lot.porteur.compteBancaire.intitule : 'Caisse (espèces)' }}</td>
                                <td>
                                    {{ lot.membres|length }} affaire{{ lot.membres|length > 1 ? 's' : '' }}
                                    <div class="rva-affaires">
                                        {% for membre in lot.membres %}
                                            {{ membre.avenant ? membre.avenant.referencePolice : '#' ~ membre.id }}{{ not loop.last ? ' · ' : '' }}
                                        {% endfor %}
                                    </div>
                                </td>
                                <td class="rva-num">{{ lot.total|number_format(2, ',', ' ') }} {{ monnaie }}</td>
                                <td>
                                    {% if nbPieces > 0 %}
                                        <span class="rva-avec-piece">{{ nbPieces }} pièce{{ nbPieces > 1 ? 's' : '' }}</span>
                                    {% else %}
                                        <span class="rva-sans-piece">Aucune</span>
                                    {% endif %}
                                </td>
                                <td class="text-nowrap">
                                    {# Attacher : sur le PORTEUR du lot, pour que le fichier ne soit
                                       écrit qu'une fois. Relire : le lot ENTIER, car l'assistant a pu
                                       classer sa pièce sur n'importe quel membre. #}
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-action="retro-agent-versements#attacher"
                                            data-porteur-id="{{ lot.porteur.id }}"
                                            title="Attacher un justificatif à ce virement">
                                        <twig:UX:Icon name="{{ resolve_icon_name('action:upload') }}" style="width:14px;height:14px;" aria-hidden="true" />
                                        Attacher
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            data-action="retro-agent-versements#voir"
                                            data-url="{{ path('admin.retro_agent.versement_documents', {id: agent.id, cle: cle}) }}"
                                            {{ nbPieces == 0 ? 'disabled' : '' }}
                                            title="Voir les justificatifs de ce virement">
                                        <twig:UX:Icon name="{{ resolve_icon_name('classeur') }}" style="width:14px;height:14px;" aria-hidden="true" />
                                        Voir
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
