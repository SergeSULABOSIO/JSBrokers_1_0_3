{#
    LA GRILLE ELLE-MÊME — fragment rechargé au changement d'exercice, et restauré après
    chaque geste (journal, ajustement, sortie).

    ── ELLE MONTRE TOUT LE MONDE, MÊME À ZÉRO ──────────────────────────────────────────
    Contrairement au calendrier qui ne liste que les absents : ici, un collaborateur sans
    aucun mouvement est une information — c'est peut-être quelqu'un qu'on a oublié de doter.

    ── L'ALERTE N'EST PAS QU'UNE COULEUR (WCAG 1.4.1) ──────────────────────────────────
    Un solde au-delà du seuil porte une puce ET le mot « report élevé ».

    ── CHAQUE GESTE DIT SUR QUI IL PORTE ───────────────────────────────────────────────
    « Journal » répété sur chaque ligne ne dit rien à qui navigue au lecteur d'écran :
    l'intitulé accessible nomme donc le collaborateur (WCAG 2.4.4).
#}
{# ── LA NAVIGATION EST UN PAGINEUR, PAS DEUX BOUTONS AUX EXTRÉMITÉS ─────────────────
   Écartelés de part et d'autre d'un panneau large de mille pixels, les deux boutons ne
   se lisaient plus comme un couple : rien ne disait que « 2025 » et « 2027 » font un
   seul geste, et la bande paraissait vide entre les deux. Regroupés dans la pastille du
   pagineur de liste — celle qui sert déjà à changer de page —, ils redeviennent un
   contrôle unique, et le titre reprend la place forte, à gauche.
   — Nielsen 4 (cohérence : le même geste porte la même forme partout) et 8 (minimalisme). #}
<div class="jsb-picker-sousentete">
    <p class="jsb-picker-sousentete-titre">Exercice {{ grille.exercice }}</p>
    <nav class="jsb-pagination-nav d-inline-flex align-items-center gap-1"
         aria-label="Changer d'exercice">
        <button type="button" class="btn btn-sm btn-outline-secondary"
                data-cpt-exercice="{{ grille.precedent }}">
            <span aria-hidden="true">‹</span> {{ grille.precedent }}
            <span class="visually-hidden">Voir l'exercice {{ grille.precedent }}</span>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary"
                data-cpt-exercice="{{ grille.suivant }}">
            {{ grille.suivant }} <span aria-hidden="true">›</span>
            <span class="visually-hidden">Voir l'exercice {{ grille.suivant }}</span>
        </button>
    </nav>
</div>

{% if grille.lignes|length == 0 %}
    <p class="jsb-picker-empty">Aucun collaborateur dans ce cabinet.</p>
{% else %}
    <table class="jsb-picker-table">
        <caption class="visually-hidden">
            Compteurs de congés des collaborateurs du cabinet pour l'exercice {{ grille.exercice }},
            en jours ouvrables.
        </caption>
        <thead>
            <tr>
                <th scope="col">Collaborateur</th>
                <th scope="col" class="jsb-picker-num">Acquis</th>
                <th scope="col" class="jsb-picker-num">dont report</th>
                <th scope="col" class="jsb-picker-num">Consommé</th>
                <th scope="col" class="jsb-picker-num">Engagé</th>
                <th scope="col" class="jsb-picker-num">Disponible</th>
                <th scope="col">Gestes</th>
            </tr>
        </thead>
        <tbody>
            {% for ligne in grille.lignes %}
                <tr>
                    <th scope="row" class="fw-semibold">
                        {{ ligne.agent }}
                        {% if ligne.alerte %}
                            <span class="jsb-picker-chip jsb-picker-chip--other ms-1">report élevé</span>
                        {% endif %}
                    </th>
                    <td class="jsb-picker-num">{{ ligne.acquis|number_format(1, ',', ' ') }}</td>
                    <td class="jsb-picker-num text-muted">
                        {{ ligne.dontReport > 0 ? ligne.dontReport|number_format(1, ',', ' ') : '—' }}
                    </td>
                    <td class="jsb-picker-num">{{ ligne.consomme|number_format(1, ',', ' ') }}</td>
                    <td class="jsb-picker-num">{{ ligne.engage|number_format(1, ',', ' ') }}</td>
                    <td class="jsb-picker-num {{ ligne.disponible < 0 ? 'jsb-picker-num--negatif fw-bold' : 'jsb-picker-num--accent' }}">
                        {{ ligne.disponible|number_format(1, ',', ' ') }}
                        {% if ligne.disponible < 0 %}<span class="visually-hidden">(négatif)</span>{% endif %}
                    </td>
                    <td>
                        {# CHAQUE GESTE PORTE SON ICÔNE. Trois libellés courts alignés se
                           lisent comme un bloc de texte ; l'icône les redevient trois
                           boutons distincts, et l'on vise « Sortie » sans relire.
                           Elle est décorative — le mot dit déjà tout (WCAG 1.1.1). #}
                        <span class="jsb-picker-gestes">
                            <button type="button" class="btn btn-sm btn-outline-secondary jsb-picker-geste"
                                    data-cpt-journal="{{ ligne.id }}"
                                    aria-label="Journal de {{ ligne.agent }}">
                                {{ ux_icon(resolve_icon_name('action:view'), {width: '14px', height: '14px'}) }}
                                Journal
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary jsb-picker-geste"
                                    data-cpt-ajuster="{{ ligne.id }}"
                                    aria-label="Ajuster le compteur de {{ ligne.agent }}">
                                {{ ux_icon(resolve_icon_name('action:edit'), {width: '14px', height: '14px'}) }}
                                Ajuster
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary jsb-picker-geste"
                                    data-cpt-sortie="{{ ligne.id }}"
                                    aria-label="Décompte de sortie de {{ ligne.agent }}">
                                {{ ux_icon(resolve_icon_name('action:exit'), {width: '14px', height: '14px'}) }}
                                Sortie
                            </button>
                        </span>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th scope="row">Total</th>
                <td class="jsb-picker-num">{{ grille.totaux.acquis|number_format(1, ',', ' ') }}</td>
                <td></td>
                <td class="jsb-picker-num">{{ grille.totaux.consomme|number_format(1, ',', ' ') }}</td>
                <td class="jsb-picker-num">{{ grille.totaux.engage|number_format(1, ',', ' ') }}</td>
                <td class="jsb-picker-num jsb-picker-num--accent">{{ grille.totaux.disponible|number_format(1, ',', ' ') }}</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    {% if grille.seuilReport > 0 %}
        <p class="jsb-picker-note">
            « Report élevé » signale un disponible au-delà de
            <strong>{{ grille.seuilReport|number_format(1, ',', ' ') }}&nbsp;jours</strong>, seuil réglé
            dans « Paramètres congés ». Un solde qui s'accumule indéfiniment est une dette
            qui grossit sans que personne ne la regarde.
        </p>
    {% endif %}
{% endif %}
