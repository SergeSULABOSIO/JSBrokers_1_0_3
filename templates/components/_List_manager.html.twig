{#
    Ce template est un composant générique et réutilisable pour afficher une liste d'entités sous forme de tableau.
    Il est le conteneur principal qui orchestre l'affichage des en-têtes, des données et de l'état vide.

    Contrôleur Stimulus associé :
    - `list-manager` (anciennement `liste-principale`): Gère l'ensemble de la liste, y compris la sélection, le tri,
      la pagination (via des événements) et les actions globales comme "tout cocher" ou "ajouter".

    Paramètres attendus :
    - `data`: La collection d'entités à afficher.
    - `entite_nom`: Le nom de l'entité (ex: "Client", "Piste").
    - `entityFormCanvas`: La configuration du formulaire de l'entité, utilisée pour les actions d'ajout/édition.
    - `listeCanvas`: La configuration d'affichage de la liste (colonnes, titres).
    - `numericAttributes` (optionnel): Attributs numériques pour les totaux.
#}
<div
        id="{{ listId | default('list-controller-' ~ random()) }}" {# CORRECTION : Utiliser un ID prédictible ou un fallback aléatoire. #}
        data-controller="list-manager"
        data-list-manager-nb-elements-value="{{ data|length }}"
        data-list-manager-entite-value="{{ entite_nom }}"
        data-list-manager-server-root-name-value="{{ serverRootName }}"
        data-list-manager-id-entreprise-value="{{ idEntreprise }}"
        data-list-manager-id-invite-value="{{ idInvite }}"
        {# GOTCHA Twig/Stimulus : `{}` en Twig est un tableau PHP vide que json_encode
           sérialise en `[]` — or les valeurs Stimulus typées `Object` REFUSENT `[]`
           (TypeError au premier accès, qui avorte _initializeAndNotifyState et donc
           ui:tab.initialized). Pour tout repli vide d'une valeur Object, émettre la
           chaîne littérale '{}'. #}
        data-list-manager-entity-form-canvas-value='{{ (entityFormCanvas is defined and entityFormCanvas is not empty ? entityFormCanvas|json_encode : '{}')|e('html_attr') }}'
        {# Canvas de recherche de l'entité listée : transmis au cerveau via
           ui:tab.initialized pour que la barre de recherche se recontextualise
           à chaque activation d'onglet. (Valeur Stimulus de type Array : `[]` est
           un repli valide ici.) #}
        data-list-manager-search-canvas-value='{{ (searchCanvas|default([]))|json_encode|e('html_attr') }}'
        data-list-manager-numeric-attributes-and-values-value='{{ numericAttributesAndValues|default({})|json_encode|e('html_attr') }}'
        data-list-manager-list-url-value="{{ listUrl | default('') }}"
        data-list-manager-pagination-value='{{ (paginationMeta is defined and paginationMeta is not empty ? paginationMeta|json_encode : '{}')|e('html_attr') }}'
        data-list-manager-initial-criteria-value='{{ (initialSearchCriteria is defined and initialSearchCriteria is not empty ? initialSearchCriteria|json_encode : '{}')|e('html_attr') }}'
    >
        {% if usage|default('generic') != 'dialog' %}
        <div class="jsb-list-controls-bar" data-list-manager-target="controlsBar">
            <div class="jsb-list-controls-bar__display jsb-control-pill"
                 role="status" aria-live="polite" aria-atomic="true"
                 data-view-manager-target="display">Prêt.</div>
            <div data-list-manager-target="paginationContainer" class="jsb-list-controls-bar__pagination jsb-control-pill"></div>
            <div class="jsb-list-controls-bar__totals jsb-control-pill">
                {{ include('components/_list_summary.html.twig') }}
            </div>
        </div>
        {# Chips de filtre rapide (optionnels, déclarés par le canvas de liste via
           `filtres_predefinis`) : chaque option pose/retire un critère de recherche via
           le Cerveau (ui:filter.preset). L'état actif est synchronisé sur les critères
           courants de l'onglet (badge de la barre de recherche compris). Rangée DÉDIÉE
           sous la barre de contrôles : elle était saturée (statut + pagination + totaux),
           les chips s'y empilaient mal. #}
        {% if listeCanvas.filtres_predefinis is defined and listeCanvas.filtres_predefinis is not empty %}
            <div class="jsb-preset-filters-bar">
                {% for groupe in listeCanvas.filtres_predefinis %}
                    <div class="jsb-preset-filters jsb-control-pill" role="group"
                         aria-label="{{ groupe.libelle | default('Filtres rapides') }}"
                         data-preset-criterion="{{ groupe.critere }}">
                        {# Le CRITÈRE est écrit une seule fois, en tête du groupe : les boutons
                           ne portent plus que la valeur. Une rubrique peut ainsi aligner
                           quatre groupes sur une ligne là où deux la remplissaient.
                           Le titre reste PUREMENT TEXTUEL : l'icône appartient au chip, où
                           elle dit l'état — c'est la règle de toutes les rubriques. #}
                        <span class="jsb-preset-filters__titre" aria-hidden="true">{{ groupe.titre | default(groupe.libelle | default('Filtrer')) }}</span>
                        {% for option in groupe.options %}
                            {% if option.selecteur is defined %}
                                {# CHIP-SÉLECTEUR : l'option ne porte pas une valeur mais une
                                   ENTITÉ où aller chercher les valeurs au clic. C'est ce qui
                                   permet de filtrer sur une relation (un agent, un client…)
                                   sans figer une option par enregistrement dans un canevas de
                                   liste — lesquels sont partagés et ignorent l'entreprise.
                                   Le choix retombe ensuite dans le MÊME chemin que les autres
                                   chips : ui:filter.preset. #}
                                <button type="button" class="jsb-preset-chip"
                                        data-action="click->list-manager#openPresetSelector"
                                        data-criterion-key="{{ groupe.critere }}"
                                        data-selecteur-entite="{{ option.selecteur.entite }}"
                                        data-selecteur-champ="{{ option.selecteur.displayField | default('nom') }}"
                                        {# La FAMILLE du choix, quand un même critère en accepte
                                           plusieurs : le bénéficiaire d'un reversement est un agent
                                           OU un partenaire, deux colonnes distinctes. Le préfixe
                                           voyage avec la valeur, ce qui permet à la traduction SQL
                                           de viser la bonne, et aux deux chips de ne pas s'allumer
                                           ensemble sur des identifiants homonymes. #}
                                        {% if option.selecteur.prefixe is defined %}data-selecteur-prefixe="{{ option.selecteur.prefixe }}"{% endif %}
                                        {# Le libellé d'ORIGINE, pour pouvoir y revenir : une fois
                                           un agent choisi, le chip porte son NOM — un filtre
                                           qu'on ne peut pas lire est un filtre qu'on croit
                                           absent. « Tous les agents » le remet à zéro. #}
                                        data-selecteur-libelle-defaut="{{ option.label }}"
                                        aria-haspopup="listbox"
                                        aria-expanded="false">
                                    {%- if option.icon is defined and option.icon -%}
                                        <span class="jsb-preset-chip__icon" aria-hidden="true">{{ ux_icon(resolve_icon_name(option.icon), {width: '15px', height: '15px'}) }}</span>
                                    {%- endif -%}
                                    <span data-selecteur-libelle>{{ option.label }}</span>
                                </button>
                            {% else %}
                            {# `titre_complet` porte le libellé non abrégé : le titre du groupe
                               n'est pas annoncé avec le bouton par les lecteurs d'écran, et
                               « Partielle » seul ne dirait pas de quelle dette il s'agit. #}
                            <button type="button" class="jsb-preset-chip"
                                    data-action="click->list-manager#applyPresetFilter"
                                    data-criterion-key="{{ groupe.critere }}"
                                    data-criterion-value="{{ option.value }}"
                                    data-criterion-label="{{ option.titre_complet | default(option.label) }}"
                                    {% if option.titre_complet is defined %}aria-label="{{ option.titre_complet }}" title="{{ option.titre_complet }}"{% endif %}
                                    aria-pressed="false">
                                {%- if option.icon is defined and option.icon -%}
                                    <span class="jsb-preset-chip__icon" aria-hidden="true">{{ ux_icon(resolve_icon_name(option.icon), {width: '15px', height: '15px'}) }}</span>
                                {%- endif -%}
                                <span>{{ option.label }}</span>
                            </button>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
        {% endif %}
        <div class="table-scroll-wrapper flex-grow-1" data-list-manager-target="listContainer">
            <table class="table table-hover table-sm table-enhanced" aria-label="Liste de {{ entite_nom }}">
                <thead class="table-light sticky-header">
                    <tr class="text-center">
                        {# Colonne Id. + case « tout sélectionner » : réservée aux listes principales.
                           En collection embarquée (dialog), aucune action en lot n'existe (le bandeau
                           d'actions groupées est masqué) : on supprime cette colonne pour épurer le
                           scan visuel et réduire la charge informationnelle. #}
                        {% if usage|default('generic') != 'dialog' %}
                            <th scope="col" style="width: 80px;">
                                <div class="form-check m-2 justify-content-start">
                                    <input class="form-check-input" type="checkbox" data-action="change->list-manager#toggleAll" data-list-manager-target="selectAllCheckbox" aria-label="Tout sélectionner">
                                    <label class="text-secondary">Id.</label>
                                </div>
                            </th>
                        {% endif %}
                        {% if listeCanvas.colonne_principale is defined %}
                            <th scope="col">
                                <div class='d-flex justify-content-start text-secondary m-2'>{{ listeCanvas.colonne_principale.titre_colonne | default('Titre principal') }}</div>
                            </th>
                        {% endif %}
                        {# On n'affiche les colonnes numériques que si on n'est PAS dans une collection totalisable de dialogue #}
                        {% if not (usage is defined and usage == 'dialog' and totalizableField is defined and totalizableField is not null) %}
                            {% for colonne in listeCanvas.colonnes_numeriques | default([]) %}
                                <th scope="col" style="width:150px" class="th-numeric">
                                    <div class='text-secondary m-2'>{{ colonne.titre_colonne | default('Valeur') }}</div>
                                </th>
                            {% endfor %}
                        {% endif %}
                        {# NOUVEAU : Colonne d'actions pour les collections dans un dialogue #}
                        {% if usage is defined and usage == 'dialog' %}
                            <th scope="col" style="width: 100px;" class="text-end pe-4">
                                <div class='d-flex justify-content-end text-secondary m-2'>Actions</div>
                            </th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody class="table-group-divider context-target" data-list-manager-target="donnees">
                    {# MODIFICATION : On rend les lignes directement côté serveur si des données sont passées.
                       Le contrôleur JS ne chargera les données que lors d'une recherche/refresh. #}
                    {% for entity in data %}
                        {{ include('components/_list_row.html.twig', { 
                            'entity': entity, 
                            'listeCanvas': listeCanvas, 
                            'entite_nom': entite_nom, 
                            'entityCanvas': entityCanvas, 
                            'usage': usage|default('generic'),
                            'parentEntity': parentEntity|default(null),
                            'totalizableField': totalizableField|default(null),
                            'totalizableFieldDetails': totalizableFieldDetails|default(null),
                            'listActionOptions': listActionOptions|default({})
                        }) }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div data-list-manager-target="emptyStateContainer" class="d-none h-100">
            {% if usage is defined and usage == 'dialog' %}
                {# CAS : État vide pour une collection DANS UN FORMULAIRE D'ÉDITION.
                   Quand la fiche parente n'est pas encore enregistrée, seul le TEXTE change :
                   le composant, lui, reste le même. Deux états vides différents selon qu'on
                   crée ou qu'on modifie donneraient deux visages à une même situation — et
                   celui de la création doit dire ce qui a d'unique ici : la saisie est
                   possible tout de suite, et elle sera écrite avec la fiche. #}
                {% set parentEnAttente = parentEntity is defined and parentEntity is not null and parentEntity.id is null %}
                {% set emptyStateParams = {
                    title: "La collection est vide",
                    description: parentEnAttente
                        ? "Ajoutez vos éléments dès maintenant : ils seront créés en même temps que la fiche."
                        : "Ajouter un élément à la collection en cliquant sur le bouton \"Ajouter\".",
                    icon_name: entityCanvas.parametres.icone | default('lucide:folder-plus'),
                    button_text: "Ajouter",
                    button_action: customAddAction, 
                    button_icon: "lucide:plus-circle"
                } %}
            {% else %}
                {# CAS : État vide pour une liste principale OU une collection contextuelle (hors formulaire). #}
                {% set emptyStateParams = {
                    title: "Aucun élément trouvé",
                    description: "Essayez de réinitialiser vos critères ou d'ajouter un nouvel élément.",
                    icon_name: entityCanvas.parametres.icone | default('lucide:search-x'),
                    button_2_text: "Réinitialiser",
                    button_2_action: "click->list-manager#resetSearch",
                    button_2_icon: "lucide:rotate-cw"
                } %}
                {% if can_add | default(false) %}
                    {% set emptyStateParams = emptyStateParams|merge({ button_text: "Ajouter", button_action: "click->list-manager#requestAddItem", button_icon: "lucide:plus-circle" }) %}
                {% endif %}
            {% endif %}

            {{ include('components/_empty_state.html.twig', emptyStateParams) }}
        </div>
    </div>
</div>
