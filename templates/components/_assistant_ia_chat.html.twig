{#
  Panneau de chat de l'assistant IA — injecté dans la COLONNE 4 (visualisation)
  via l'événement `app:workspace.open-html-in-visualization` (workspace-manager).

  Interface type « chat Claude » aux couleurs JS Brokers : bulles assistant à
  gauche (fond blanc bordé), bulles utilisateur à droite (fond cobalt subtil
  #e8f0fb — jamais de cobalt plein sous du texte courant), refus périmètre
  signalé par un liseré avertissement. AUCUN <script> inline : l'interactivité
  est portée par le contrôleur Stimulus `assistant-chat` (instancié
  automatiquement dans le HTML injecté).
#}
{#
  Thème du chat : 'light' / 'dark' si l'utilisateur a tranché (colonne
  Utilisateur::$themeAssistant), 'auto' sinon. Le CSS ne réagit qu'à "dark" ;
  'auto' est résolu par le contrôleur Stimulus (préférence système du poste) dès
  connect(), avant le premier rendu visuel.
#}
{#
  Macros des éléments montés à la fois par le SERVEUR (boucle de l'historique) et
  par le NAVIGATEUR (bulles ajoutées en direct, qui clonent les <template> du bas
  de ce fichier). Les définir ici les rend SOURCE UNIQUE : le contrôleur Stimulus
  ne construit aucun markup ni aucune icône, il clone et remplit du textContent.
  C'est ce qui évite le troisième doublon Twig ⇄ JS.
#}
{% macro citationBulle(qui, extrait, quoteId) %}
    <button type="button" class="aic-msg-quote" data-quote-id="{{ quoteId }}"
            data-action="click->assistant-chat#allerAuMessage"
            aria-label="Aller au message cité">
        <span class="aic-msg-quote-qui">{{ qui }}</span>
        <span class="aic-msg-quote-extrait">{{ extrait }}</span>
    </button>
{% endmacro %}
{% import _self as aic %}
<div class="jsb-ai-chat"
     data-aic-theme="{{ themeAssistant|default('auto') }}"
     data-controller="assistant-chat"
     data-assistant-chat-send-url-value="{{ path('admin.assistantia.api.message.send', {idEntreprise: idEntreprise, idConversation: conversation.id}) }}"
     data-assistant-chat-etat-url-value="{{ path('admin.assistantia.api.message.etat', {idEntreprise: idEntreprise, idConversation: conversation.id}) }}"
     data-assistant-chat-dialog-context-url-value="{{ path('admin.assistantia.api.dialog_context', {idEntreprise: idEntreprise}) }}"
     data-assistant-chat-visual-context-url-value="{{ path('admin.assistantia.api.visual_context', {idEntreprise: idEntreprise}) }}"
     data-assistant-chat-contexte-url-value="{{ path('admin.assistantia.api.contexte.attach', {idEntreprise: idEntreprise, idConversation: conversation.id}) }}"
     data-assistant-chat-fichier-url-value="{{ path('admin.assistantia.api.fichier.attach', {idEntreprise: idEntreprise, idConversation: conversation.id}) }}"
     data-assistant-chat-fichier-limits-value="{{ fichierLimits|default(attached_file_limits())|json_encode|e('html_attr') }}"
     data-assistant-chat-theme-url-value="{{ path('admin.assistantia.api.theme') }}"
     data-assistant-chat-id-entreprise-value="{{ idEntreprise }}"
     data-assistant-chat-id-invite-value="{{ idInvite }}"
     data-assistant-chat-id-conversation-value="{{ conversation.id }}"
     data-assistant-chat-assistant-nom-value="{{ assistantNom }}"
     {# URL de renommage de CETTE conversation, lue par le workspace-manager
        quand on double-clique le libellé de l'onglet qui contient ce chat.

        POURQUOI ICI PLUTÔT QUE SUR L'ONGLET. Elle y a d'abord voyagé, par
        l'événement d'ouverture puis par le localStorage — et c'était fragile :
        un onglet restauré depuis une entrée mémorisée AVANT l'arrivée de cette
        fonctionnalité n'avait pas l'URL, donc le double-clic ne faisait rien,
        en silence. Ce partial, lui, est toujours re-téléchargé depuis le
        serveur à chaque ouverture ou restauration : l'attribut est là par
        construction, jamais périmé. #}
     data-renommer-url="{{ path('admin.assistantia.api.conversation.rename', {idEntreprise: idEntreprise, idConversation: conversation.id}) }}"
     data-action="assistant:contexte.attach-request->assistant-chat#attachFromEvent">
    <style>
        /* ══ Jetons de couleur du chat ══════════════════════════════════════════
           Le chat est le seul écran de l'application à proposer un mode sombre
           (confort visuel : c'est l'interface la plus longuement regardée). Il
           est donc entièrement AUTO-PORTÉ : toutes ses couleurs passent par ces
           jetons, et le mode sombre ne redéfinit QUE ces jetons — aucun des ~90
           sélecteurs ci-dessous n'est dupliqué.

           Les jetons sont nommés par RÔLE, jamais par valeur : deux couleurs
           identiques en clair peuvent divercher en sombre. Exemple : le fond du
           panneau et le survol d'une ligne de tableau valent tous deux #f8f9fa
           en clair, mais en sombre l'élévation s'inverse (le fond s'assombrit,
           le survol s'éclaircit) — d'où --aic-bg vs --aic-row-hover. */
        .jsb-ai-chat {
            /* Surfaces, du plus bas au plus élevé */
            --aic-bg:#f8f9fa;              /* fond du panneau, encadrés encastrés */
            --aic-surface:#ffffff;         /* entête, composer, bulle assistant, cartes */
            --aic-surface-raised:#e9ecef;  /* survol neutre, badge neutre, plan annulé */
            --aic-btn-neutral-bg:#f8f9fa;  /* bouton neutre POSÉ sur une carte blanche */
            --aic-code-bg:#f1f3f5;
            --aic-chip-file-bg:#eef1f4;
            --aic-input-bg:#ffffff;
            --aic-row-hover:#f8f9fa;       /* survol de ligne : s'ÉCLAIRCIT en sombre */
            /* Textes */
            --aic-text:#212529;
            --aic-text-strong:#343a40;
            --aic-text-2:#495057;
            --aic-muted:#6c757d;
            --aic-input-text:#000000;
            /* Bordures : `strong` porte les contours de composants (WCAG 1.4.11),
               `border` et `subtle` sont décoratifs. */
            --aic-border:#dee2e6;
            --aic-border-strong:#ced4da;
            --aic-border-subtle:#e9ecef;
            /* Marque. `solid` reste le cobalt de la charte dans les DEUX modes
               (aplat des boutons pleins, blanc dessus = 8.44:1) ; `accent` est la
               version lisible en texte/icône/liseré, qui s'éclaircit en sombre. */
            --aic-accent:#0047AB;
            --aic-accent-solid:#0047AB;
            --aic-on-accent:#ffffff;
            --aic-accent-hover:#003380;
            --aic-accent-subtle:#e8f0fb;
            --aic-on-subtle:#0047AB;
            --aic-ring:rgba(0,71,171,.35);
            --aic-shadow-hover:rgba(0,71,171,.12);
            --aic-shadow-chip:rgba(0,71,171,.25);
            /* États sémantiques (retours utilisateur uniquement) */
            --aic-success-bg:#d1e7dd; --aic-success-fg:#0f5132;
            --aic-danger-bg:#f8d7da;  --aic-danger-fg:#842029;
            --aic-warning-bg:#fff3cd; --aic-warning-fg:#664d03;
            --aic-warning-line:#ffc107;
            --aic-mic-pulse:rgba(132,32,41,.45);
            --aic-mic-fade:rgba(132,32,41,0);

            /* Les CONTRÔLES NATIFS (liste déroulante d'un <select>, barres de
               défilement, curseurs de saisie) sont peints par le navigateur, hors
               de portée de nos jetons : la liste d'un select s'ouvrait blanche sur
               un chat sombre. `color-scheme` est le seul levier qui les fasse
               suivre. Il est posé EXPLICITEMENT sur les deux thèmes — sans la
               valeur `light` ici, un poste dont le système est en sombre ouvrirait
               une liste sombre sur un chat clair, soit l'incohérence inverse. */
            color-scheme: light;

            display:flex; flex-direction:column; height:100%; min-height:0; background:var(--aic-bg);
        }
        /* Ceinture et bretelles : les navigateurs qui rendent la liste déroulante
           avec les styles d'auteur lisent ces règles, les autres suivent
           color-scheme. Dans les deux cas, la liste est du thème du chat. */
        .jsb-ai-chat select option {
            background:var(--aic-input-bg); color:var(--aic-input-text);
        }

        /* ══ Mode sombre ════════════════════════════════════════════════════════
           SEUL endroit où les couleurs sombres sont définies. Pas de
           @media (prefers-color-scheme) ici : le contrôleur Stimulus résout le
           thème (choix explicite de l'utilisateur > préférence système) et écrit
           toujours data-aic-theme sur cette racine → une seule source de vérité,
           et les puces re-rendues par le serveur héritent par simple cascade.
           Contrastes WCAG AA vérifiés par calcul (texte courant 13.48:1, texte
           atténué 7.71:1, accent 6.62:1, contours de composants 3.41:1). */
        .jsb-ai-chat[data-aic-theme="dark"] {
            /* Bascule les contrôles natifs (liste d'un select, barres de défilement)
               en sombre : ils ne lisent aucun de nos jetons. */
            color-scheme: dark;

            --aic-bg:#16181b;
            --aic-surface:#1e2227;
            --aic-surface-raised:#2a2f36;
            --aic-btn-neutral-bg:#2a2f36;  /* s'ÉCLAIRCIT au-dessus de la carte, comme en clair */
            --aic-code-bg:#262b31;
            --aic-chip-file-bg:#262b31;
            --aic-input-bg:#16181b;
            --aic-row-hover:#2a2f36;       /* élévation inversée : plus clair que la bulle */
            --aic-text:#e9ecef;
            --aic-text-strong:#f1f3f5;
            --aic-text-2:#ced4da;
            --aic-muted:#adb5bd;
            --aic-input-text:#f8f9fa;
            --aic-border:#343a40;
            --aic-border-strong:#6c757d;
            --aic-border-subtle:#2a2f36;
            --aic-accent:#6ea8fe;          /* le cobalt ne ferait que 1.90:1 ici */
            --aic-accent-hover:#0a58ca;    /* un aplat s'ÉCLAIRCIT au survol en sombre */
            --aic-accent-subtle:#16305a;
            --aic-on-subtle:#6ea8fe;
            --aic-ring:rgba(110,168,254,.45);
            --aic-shadow-hover:rgba(0,0,0,.45);
            --aic-shadow-chip:rgba(110,168,254,.35);
            --aic-success-bg:#16281f; --aic-success-fg:#79dfb0;
            --aic-danger-bg:#341a1d;  --aic-danger-fg:#ea868f;
            --aic-warning-bg:#33290a; --aic-warning-fg:#ffda6a;
            --aic-mic-pulse:rgba(234,134,143,.45);
            --aic-mic-fade:rgba(234,134,143,0);
        }
        /* Exception structurelle : un aplat cobalt sur fond sombre ne se détache
           plus de la surface (1.90:1). On lui donne un contour perceptible pour
           que le bouton reste identifiable comme bouton (WCAG 1.4.11). Le
           box-sizing global préserve les 44×44 px de la cible (WCAG 2.5.5). */
        .jsb-ai-chat[data-aic-theme="dark"] .aic-send,
        .jsb-ai-chat[data-aic-theme="dark"] .aic-mut-btn--primary { border:1px solid var(--aic-accent); }

        /* ── Entête ── */
        .jsb-ai-chat .aic-header {
            display:flex; align-items:center; gap:.65rem; flex:0 0 auto;
            padding:.75rem 1rem; background:var(--aic-surface); border-bottom:1px solid var(--aic-border);
        }
        .jsb-ai-chat .aic-avatar {
            width:40px; height:40px; border-radius:50%; flex:0 0 auto;
            background:var(--aic-accent-solid); color:var(--aic-on-accent); font-weight:700; font-size:1.05rem;
            display:flex; align-items:center; justify-content:center;
        }
        .jsb-ai-chat .aic-header-txt { min-width:0; }
        .jsb-ai-chat .aic-header-nom { color:var(--aic-text); font-weight:700; font-size:1rem; margin:0; }
        .jsb-ai-chat .aic-header-sub { color:var(--aic-muted); font-size:.78rem; margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        /* Boutons d'action de l'entête (thème, plein écran, fermeture) : socle commun. */
        .jsb-ai-chat .aic-iconbtn {
            background:none; border:none; color:var(--aic-muted); cursor:pointer; flex:0 0 auto;
            width:36px; height:36px; border-radius:8px; display:flex; align-items:center; justify-content:center;
        }
        .jsb-ai-chat .aic-iconbtn:hover { background:var(--aic-surface-raised); color:var(--aic-text); }
        .jsb-ai-chat .aic-iconbtn:focus-visible { outline:2px solid var(--aic-accent); outline-offset:2px; }
        /* Le premier bouton d'action pousse le groupe à droite de l'entête. */
        .jsb-ai-chat .aic-header .aic-iconbtn:first-of-type { margin-left:auto; }
        /* Bascule agrandir / réduire selon l'état pressé (piloté par le contrôleur
           workspace-manager, qui synchronise aria-pressed avec le mode plein écran). */
        .jsb-ai-chat .aic-fullscreen .aic-ic-collapse { display:none; }
        .jsb-ai-chat .aic-fullscreen[aria-pressed="true"] .aic-ic-expand { display:none; }
        .jsb-ai-chat .aic-fullscreen[aria-pressed="true"] .aic-ic-collapse { display:block; }
        /* ── Entête : commandes repliées ou dépliées selon la place ──
           En colonne étroite, quatre icônes rognaient « Assistant IA · Sté COURTAGE
           RDC Sarl », le seul texte qui dit à l'utilisateur OÙ il travaille : les
           commandes occasionnelles passent donc dans le menu ⋮.
           EN PLEIN ÉCRAN, la contrainte tombe — la barre fait toute la largeur. On
           DÉPLIE alors les commandes en boutons d'icône et l'on masque le ⋮ : un clic
           au lieu de deux, sans jamais rogner le titre. Les mêmes éléments servent
           dans les deux états ; rien n'est dupliqué, donc rien ne peut diverger. */
        /* `.chat-fullscreen` est posée par workspace-manager sur la RACINE du poste
           de travail, pas sur le chat : le sélecteur part donc de l'ancêtre. */
        .chat-fullscreen .jsb-ai-chat .aic-header .aic-msg-menu {
            position:static; display:flex; gap:.15rem; padding:0;
            min-width:0; background:none; border:none; border-radius:0; box-shadow:none;
            /* Le ⋮ portait l'auto-marge qui pousse le groupe à droite ; il est masqué
               ici, c'est donc au menu déplié de la porter. */
            margin-left:auto;
        }
        /* Replié : le menu flottant est retiré du flux ET de l'arbre d'accessibilité. */
        .jsb-ai-chat .aic-menu-entete.is-ferme { display:none; }
        /* Déplié en plein écran, même quand il est « fermé » : les commandes sont
           alors des boutons de barre, il n'y a plus rien à ouvrir. */
        .chat-fullscreen .jsb-ai-chat .aic-header .aic-menu-entete.is-ferme { display:flex; }
        .chat-fullscreen .jsb-ai-chat .aic-header .aic-msg-menu-item {
            width:36px; height:36px; padding:0; justify-content:center; border-radius:8px;
            color:var(--aic-muted);
        }
        /* Le libellé cède la place à l'icône ; le nom accessible, lui, reste porté
           par `aria-label` — jamais de bouton muet. */
        .chat-fullscreen .jsb-ai-chat .aic-header .aic-msg-menu-item > span { display:none; }
        .chat-fullscreen .jsb-ai-chat .aic-header .aic-msg-menu-sep { display:none; }
        .chat-fullscreen .jsb-ai-chat .aic-header .aic-msg-menu-item svg { width:20px; height:20px; }
        .chat-fullscreen .jsb-ai-chat .aic-header .aic-options { display:none; }

        /* Bascule de thème : même mécanique que le plein écran — l'icône suit
           aria-pressed. Au repos (clair) on propose la lune ; pressé (sombre) on
           propose le soleil, c'est-à-dire toujours l'action à venir. */
        .jsb-ai-chat .aic-theme .aic-ic-sun { display:none; }
        .jsb-ai-chat .aic-theme[aria-pressed="true"] .aic-ic-moon { display:none; }
        .jsb-ai-chat .aic-theme[aria-pressed="true"] .aic-ic-sun { display:block; }

        /* ── Fil de messages ── */
        .jsb-ai-chat .aic-messages { flex:1 1 auto; min-height:0; overflow-y:auto; padding:1rem; display:flex; flex-direction:column; gap:.75rem; }
        .jsb-ai-chat .aic-msg { display:flex; gap:.5rem; max-width:92%; }
        .jsb-ai-chat .aic-msg--assistant { align-self:flex-start; }
        .jsb-ai-chat .aic-msg--user { align-self:flex-end; flex-direction:row-reverse; }
        .jsb-ai-chat .aic-msg-avatar {
            width:28px; height:28px; border-radius:50%; flex:0 0 auto; margin-top:2px;
            background:var(--aic-accent-solid); color:var(--aic-on-accent); font-weight:700; font-size:.8rem;
            display:flex; align-items:center; justify-content:center;
        }
        .jsb-ai-chat .aic-msg-body { min-width:0; display:flex; flex-direction:column; gap:.15rem; }
        .jsb-ai-chat .aic-msg-text {
            margin:0; padding:.6rem .8rem; border-radius:12px;
            color:var(--aic-text); font-size:.9rem; line-height:1.5; white-space:pre-wrap; word-break:break-word;
        }
        .jsb-ai-chat .aic-msg--assistant .aic-msg-text {
            background:var(--aic-surface); border:1px solid var(--aic-border); border-top-left-radius:4px;
            /* Contenu HTML structuré (Markdown rendu) : les éléments de bloc
               gèrent déjà leurs propres marges, pre-wrap ne sert plus qu'à
               préserver les sauts de ligne du texte brut utilisateur. */
            white-space:normal;
        }
        .jsb-ai-chat .aic-msg--user .aic-msg-text { background:var(--aic-accent-subtle); border-top-right-radius:4px; }
        .jsb-ai-chat .aic-msg--refus .aic-msg-text { border-left:3px solid var(--aic-warning-line); }

        /* Question ACCEPTÉE mais qui attend son tour. Ket n'en traite qu'une à la
           fois : les suivantes doivent se distinguer de celle qui travaille, sans
           quoi l'utilisateur croirait à un traitement simultané. Un simple
           estompement — pas un spinner : rien ne tourne encore pour elle. */
        .jsb-ai-chat .aic-msg--en-file .aic-msg-text { opacity:.62; }
        .jsb-ai-chat .aic-msg--en-file .aic-msg-text::after {
            content:'en file';
            display:block; margin-top:.25rem;
            font-size:.72rem; font-style:italic; opacity:.8;
        }

        /* Rendu Markdown restreint des réponses assistant (voir
           assistant-markdown-render.js) : sobre, densité compacte adaptée à
           une bulle de largeur limitée. */
        .jsb-ai-chat .aic-msg-text p { margin:0 0 .5rem; }
        .jsb-ai-chat .aic-msg-text p:last-child { margin-bottom:0; }
        .jsb-ai-chat .aic-msg-text ul,
        .jsb-ai-chat .aic-msg-text ol { margin:0 0 .5rem; padding-left:1.2rem; }
        .jsb-ai-chat .aic-msg-text ul:last-child,
        .jsb-ai-chat .aic-msg-text ol:last-child { margin-bottom:0; }
        .jsb-ai-chat .aic-msg-text li { margin-bottom:.15rem; }
        .jsb-ai-chat .aic-msg-text strong { color:var(--aic-text); font-weight:700; }
        .jsb-ai-chat .aic-msg-text code {
            background:var(--aic-code-bg); color:var(--aic-text); border-radius:4px;
            padding:.05rem .3rem; font-size:.85em;
        }
        .jsb-ai-chat .aic-md-heading { margin:.2rem 0 .35rem; font-size:.92rem; font-weight:700; color:var(--aic-text-strong); }
        /* Un tableau large ne doit JAMAIS élargir ni écraser la bulle : il devient
           lui-même la boîte défilante. `width:max-content` donne aux colonnes leur
           largeur naturelle, `max-width:100%` les borne à la bulle (donc à la colonne
           de visualisation) et `overflow-x:auto` ne montre la barre horizontale que
           si ça dépasse — les messages sans tableau large restent inchangés. */
        .jsb-ai-chat .aic-msg-text table {
            border-collapse:separate; border-spacing:0; margin:.3rem 0 .5rem; font-size:.83rem;
            display:block; width:max-content; max-width:100%; overflow-x:auto;
        }
        /* nowrap l'emporte sur le word-break hérité de .aic-msg-text : une
           référence de police ou un montant ne se casse plus en plusieurs lignes. */
        .jsb-ai-chat .aic-msg-text th,
        .jsb-ai-chat .aic-msg-text td { border-bottom:1px solid var(--aic-border); padding:.3rem .5rem; text-align:left; white-space:nowrap; }
        .jsb-ai-chat .aic-msg-text th { color:var(--aic-muted); font-weight:600; text-transform:uppercase; letter-spacing:.3px; font-size:.72rem; }
        .jsb-ai-chat .aic-msg-text td { color:var(--aic-text-2); }
        /* Feedback local sur chaque LIGNE de données, dans la même langue que
           les bulles et les listes du produit : SURVOL (fond #f8f9fa, idiome
           .table-enhanced / .jsb-picker-table d'app.css, texte plus contrasté)
           et CLIC (fond cobalt subtil, idiome .db-fb-item:active). L'entête
           n'est pas concerné : seules les données sont survolables. */
        .jsb-ai-chat .aic-msg-text tbody td { transition:background-color .12s ease, color .12s ease; }
        .jsb-ai-chat .aic-msg-text tbody tr:hover td { background:var(--aic-row-hover); color:var(--aic-text); }
        .jsb-ai-chat .aic-msg-text tbody tr:active td { background:var(--aic-accent-subtle); }
        /* Rôles de colonne d'un tableau markdown — même idiome que .aic-plan-c-montant
           plus bas, pour que les tableaux rédigés par Ket et ceux rendus par le serveur
           se lisent de la même façon. La classe vient du renderer (assistant-markdown-
           render.js), qui traduit l'alignement GFM « ---: » : l'attribut `align` de
           marked, lui, ne survit pas à la sanitisation. `tabular-nums` donne aux
           chiffres une largeur constante — sans quoi une colonne alignée à droite reste
           illisible, les unités ne tombant pas les unes sous les autres. */
        .jsb-ai-chat .aic-msg-text th.aic-md-num,
        .jsb-ai-chat .aic-msg-text td.aic-md-num { text-align:right; font-variant-numeric:tabular-nums; }
        .jsb-ai-chat .aic-msg-text th.aic-md-center,
        .jsb-ai-chat .aic-msg-text td.aic-md-center { text-align:center; }
        /* Ligne de TOTAUX : le chiffre qui résume le tableau ne doit pas se lire comme
           une ligne de données de plus. Filet de séparation au-dessus, texte contrasté,
           et pas de survol — ce n'est pas un enregistrement qu'on peut ouvrir. */
        .jsb-ai-chat .aic-msg-text tr.aic-md-total td {
            border-top:1px solid var(--aic-border); border-bottom:0;
            font-weight:700; color:var(--aic-text-strong);
        }
        .jsb-ai-chat .aic-msg-text tbody tr.aic-md-total:hover td,
        .jsb-ai-chat .aic-msg-text tbody tr.aic-md-total:active td { background:transparent; color:var(--aic-text-strong); }
        /* Pastilles : mêmes couleurs sémantiques que .jsb-state-badge (app.css). */
        .jsb-ai-chat .aic-md-badge {
            display:inline-block; padding:.1rem .5rem; border-radius:999px;
            font-size:.75rem; font-weight:600; line-height:1.3; white-space:nowrap;
        }
        .jsb-ai-chat .aic-md-badge--success { background:var(--aic-success-bg); color:var(--aic-success-fg); }
        .jsb-ai-chat .aic-md-badge--danger  { background:var(--aic-danger-bg); color:var(--aic-danger-fg); }
        .jsb-ai-chat .aic-md-badge--warning { background:var(--aic-warning-bg); color:var(--aic-warning-fg); }
        .jsb-ai-chat .aic-md-badge--info    { background:var(--aic-accent-subtle); color:var(--aic-on-subtle); }
        .jsb-ai-chat .aic-md-badge--neutral { background:var(--aic-surface-raised); color:var(--aic-text-2); }

        /* ══ Programme du jour ══════════════════════════════════════════════════
           Bulle d'ouverture d'une conversation vide, rendue par le SERVEUR (aucun
           token, aucune invention) — cf. _plan_du_jour.html.twig. Volontairement
           dépourvue de data-md-source et de data-message-id : ce n'est pas un
           message du fil, elle n'a ni menu ⋮, ni citation, ni export, et le
           pipeline markdown ne doit pas la revisiter au connect().
           Aucune couleur en dur : uniquement des jetons --aic-*, sans quoi la
           bascule de thème laisserait la bulle en arrière. */
        /* La bulle du programme prend TOUTE la largeur disponible : elle ne
           dialogue pas, elle présente des tableaux. Les 92 % des bulles de
           conversation (respiration à droite, marque du tour de parole) ne feraient
           ici que rogner des colonnes. Le padding intérieur se resserre aussi : dans
           une colonne étroite, chaque pixel rendu au tableau est une colonne de
           moins à faire défiler. */
        .jsb-ai-chat .aic-msg--plan { max-width:100%; width:100%; }
        .jsb-ai-chat .aic-msg--plan .aic-msg-body { flex:1 1 auto; }
        .jsb-ai-chat .aic-msg--plan .aic-msg-text { padding:.6rem .55rem; }
        .jsb-ai-chat .aic-plan { margin-top:.25rem; }
        .jsb-ai-chat .aic-plan-intro { margin:0 0 .6rem; color:var(--aic-text-2); }
        .jsb-ai-chat .aic-plan-priorite {
            margin:0 0 .7rem; padding:.4rem .6rem;
            border-left:3px solid var(--aic-accent); border-radius:0 6px 6px 0;
            background:var(--aic-accent-subtle); color:var(--aic-on-subtle);
            font-size:.82rem; font-weight:600;
        }
        .jsb-ai-chat .aic-plan-section { margin:0 0 .55rem; }
        .jsb-ai-chat .aic-plan-section:last-of-type { margin-bottom:0; }
        /* Entête de section : le titre porte le sens, le compte porte le volume,
           le périmètre lève l'ambiguïté « mon portefeuille ou tout le cabinet ? ». */
        .jsb-ai-chat .aic-plan-head {
            display:flex; align-items:baseline; gap:.4rem; flex-wrap:wrap;
            margin:0 0 .3rem;
        }
        .jsb-ai-chat .aic-plan-titre {
            margin:0; font-size:.78rem; font-weight:700; letter-spacing:.3px;
            text-transform:uppercase; color:var(--aic-text-strong);
        }
        .jsb-ai-chat .aic-plan-compte { font-size:.78rem; font-weight:600; color:var(--aic-accent); }
        .jsb-ai-chat .aic-plan-perimetre { font-size:.72rem; color:var(--aic-muted); }
        /* ── Tableau d'une section ──────────────────────────────────────────────
           Même idiome que les tableaux markdown des réponses (entête sobre en
           majuscules, survol de ligne, pas de retour à la ligne dans une cellule) :
           une seule grammaire de lecture dans tout le chat. C'est le CONTENEUR qui
           défile, pas le tableau : ainsi la colonne N° peut rester collée à gauche
           (sticky) pendant qu'on fait défiler les colonnes de droite. */
        .jsb-ai-chat .aic-plan-tablewrap {
            overflow-x:auto; overscroll-behavior-x:contain;
            border:1px solid var(--aic-border-subtle); border-radius:8px;
            background:var(--aic-surface);
        }
        /* Sélecteur volontairement aussi précis que `.aic-msg-text table` : à
           spécificité égale ou moindre, la règle markdown ci-dessus l'emporterait
           (elle est plus haut dans la feuille mais compte un élément de plus). */
        .jsb-ai-chat .aic-msg-text table.aic-plan-table {
            border-collapse:separate; border-spacing:0;
            /* Un plancher de largeur : en colonne étroite le tableau déborde et
               défile (comportement voulu), plutôt que de compresser les colonnes
               jusqu'à l'illisible. */
            width:100%; min-width:32rem; font-size:.8rem;
            /* ANNULE la règle des tableaux markdown ci-dessus (display:block +
               overflow-x:auto), qui ferait du tableau une SECONDE boîte défilante
               dans son conteneur : deux barres de défilement empilées, et des
               colonnes collantes qui ne collent plus à rien. Ici c'est le
               conteneur qui défile, et lui seul. */
            display:table; max-width:none; overflow:visible;
        }
        .jsb-ai-chat .aic-plan-table th,
        .jsb-ai-chat .aic-plan-table td {
            padding:.32rem .5rem; text-align:left; white-space:nowrap; vertical-align:top;
            border-bottom:1px solid var(--aic-border-subtle);
        }
        .jsb-ai-chat .aic-plan-table tbody tr:last-child td { border-bottom:0; }
        .jsb-ai-chat .aic-plan-table thead th {
            background:var(--aic-bg); color:var(--aic-muted);
            font-weight:600; font-size:.68rem; text-transform:uppercase; letter-spacing:.3px;
            border-bottom:1px solid var(--aic-border);
        }
        /* Colonne N° figée : en défilement horizontal, le courtier garde le repère
           de la ligne qu'il lit (« la 3 »), y compris pour la citer à Ket. */
        .jsb-ai-chat .aic-plan-table .aic-plan-c-num {
            position:sticky; left:0; z-index:1;
            width:1%; padding-right:.35rem; text-align:right;
            font-variant-numeric:tabular-nums; color:var(--aic-muted); font-size:.72rem;
            background:var(--aic-surface);
        }
        .jsb-ai-chat .aic-plan-table thead .aic-plan-c-num { background:var(--aic-bg); }
        .jsb-ai-chat .aic-plan-c-ctx { color:var(--aic-text-2); }
        .jsb-ai-chat .aic-plan-c-date { color:var(--aic-text-2); font-variant-numeric:tabular-nums; }
        .jsb-ai-chat .aic-plan-c-montant {
            text-align:right; font-variant-numeric:tabular-nums;
            font-weight:600; color:var(--aic-text);
        }
        /* Statut figé à droite, comme le N° l'est à gauche : les deux repères qui
           font trier l'œil (« laquelle, et est-elle en retard ? ») restent visibles
           quelle que soit la position du défilement horizontal. */
        .jsb-ai-chat .aic-plan-table .aic-plan-c-statut {
            position:sticky; right:0; z-index:1;
            width:1%; text-align:right; background:var(--aic-surface);
            box-shadow:-6px 0 6px -7px rgba(0,0,0,.35);
        }
        .jsb-ai-chat .aic-plan-table thead .aic-plan-c-statut { background:var(--aic-bg); }
        .jsb-ai-chat .aic-plan-vide { color:var(--aic-muted); }

        /* Une LIGNE = une action : toute sa surface ouvre la fiche. Le survol et le
           clic reprennent l'idiome des tableaux markdown, pour une seule grammaire
           d'interaction. */
        .jsb-ai-chat .aic-plan-row { cursor:pointer; transition:background-color .12s ease; }
        .jsb-ai-chat .aic-plan-row:hover > td { background:var(--aic-row-hover); color:var(--aic-text); }
        .jsb-ai-chat .aic-plan-row:active > td { background:var(--aic-accent-subtle); }
        /* Le bouton ne porte AUCUNE action (son clic remonte au <tr>) : il n'existe
           que pour rendre la ligne atteignable au clavier et l'annoncer comme
           actionnable aux lecteurs d'écran. Il se présente donc comme du texte. */
        .jsb-ai-chat .aic-plan-objet {
            display:block; max-width:22rem; overflow:hidden; text-overflow:ellipsis;
            padding:0; border:0; background:transparent; text-align:left;
            font:inherit; font-weight:600; color:var(--aic-text); cursor:pointer;
        }
        .jsb-ai-chat .aic-plan-row:hover .aic-plan-objet { color:var(--aic-accent); }
        .jsb-ai-chat .aic-plan-objet:focus-visible { outline:2px solid var(--aic-accent); outline-offset:2px; border-radius:3px; }
        /* Précision de second rang (police, assureur, assigné à) : elle situe la
           ligne sans concurrencer son libellé, et s'efface plutôt que d'élargir
           encore le tableau. */
        .jsb-ai-chat .aic-plan-detail {
            display:block; max-width:22rem; overflow:hidden; text-overflow:ellipsis;
            font-size:.72rem; color:var(--aic-muted);
        }
        .jsb-ai-chat .aic-plan-reste {
            margin:.15rem 0 0; padding-left:.4rem;
            font-size:.75rem; font-style:italic; color:var(--aic-muted);
        }

        /* Graphiques (blocs ```chart montés par assistant-chart-render.js) : une
           <figure> avec le <canvas> puis une légende explicative en dessous.
           Comme les tableaux, le graphique ne doit jamais déborder la bulle. */
        .jsb-ai-chat .aic-chart { margin:.4rem 0 .5rem; }
        .jsb-ai-chat .aic-chart:last-child { margin-bottom:0; }
        .jsb-ai-chat .aic-chart-figure { margin:0; }
        .jsb-ai-chat .aic-chart-canvas {
            position:relative; height:230px; max-width:100%;
            background:var(--aic-surface); border:1px solid var(--aic-border); border-radius:8px;
            padding:.5rem;
        }
        /* Légende sous le graphique : concise, atténuée, liseré cobalt discret
           pour signaler « clé de lecture » sans concurrencer le graphique. */
        .jsb-ai-chat .aic-chart-legende {
            margin:.35rem 0 0; padding:.1rem 0 .1rem .55rem;
            border-left:2px solid var(--aic-accent);
            font-size:.76rem; line-height:1.4; color:var(--aic-muted);
        }

        /* Feedback local sur chaque bulle : SURVOL (liseré cobalt + élévation
           légère) et CLIC (enfoncement bref) — l'utilisateur « sent » chaque
           message sous la souris. Transition douce, couleurs de la charte. */
        .jsb-ai-chat .aic-msg .aic-msg-text {
            transition: border-color .15s ease, box-shadow .15s ease, transform .08s ease;
            cursor: default;
        }
        .jsb-ai-chat .aic-msg:hover .aic-msg-text {
            border-color:var(--aic-accent);
            box-shadow:0 3px 10px var(--aic-shadow-hover);
        }
        /* Bulle utilisateur sans bordure de base : on en révèle une au survol
           (transparente au repos pour éviter tout saut de mise en page). */
        .jsb-ai-chat .aic-msg--user .aic-msg-text { border:1px solid transparent; }
        /* Le liseré d'avertissement d'un refus reste jaune, même au survol. */
        .jsb-ai-chat .aic-msg--refus:hover .aic-msg-text { border-left-color:var(--aic-warning-line); }
        .jsb-ai-chat .aic-msg:active .aic-msg-text { transform:scale(.985); }
        .jsb-ai-chat .aic-msg-time { color:var(--aic-muted); font-size:.7rem; }
        .jsb-ai-chat .aic-msg--user .aic-msg-time { text-align:right; }

        /* Agrafe des messages utilisateur : instantané des objets du contexte à
           l'envoi (pastille discrète, alignée à droite sous la bulle). */
        .jsb-ai-chat .aic-msg-attach {
            align-self:flex-end; display:inline-flex; align-items:center; gap:3px;
            border:1px solid var(--aic-border); background:var(--aic-surface); color:var(--aic-muted);
            font-size:.68rem; line-height:1.2; padding:1px 7px; border-radius:999px;
            cursor:pointer; font-family:inherit;
            transition:border-color .15s ease, color .15s ease;
        }
        .jsb-ai-chat .aic-msg-attach:hover { border-color:var(--aic-accent); color:var(--aic-accent); }
        .jsb-ai-chat .aic-msg-attach:focus-visible { outline:2px solid var(--aic-accent); outline-offset:2px; }

        /* ══ Actions d'une bulle (kebab + menu) ═════════════════════════════════
           Le bouton et le menu vivent DANS .jsb-ai-chat : ils héritent des jetons
           --aic-* par cascade, donc le mode sombre est gratuit — aucune couleur
           n'est dupliquée ici, contrairement au .context-menu applicatif dont les
           teintes sombres sont codées en dur.
           Le menu est posé en `fixed` : il échappe ainsi à l'overflow-y:auto du
           fil (aucun ancêtre ne porte de transform, les coordonnées viewport de
           getBoundingClientRect restent donc valides). */
        .jsb-ai-chat .aic-msg-body { position:relative; }
        .jsb-ai-chat .aic-msg-menu-btn {
            position:absolute; top:-4px; right:-4px; z-index:1;
            display:flex; align-items:center; justify-content:center;
            width:26px; height:26px; padding:0; border-radius:8px;
            background:var(--aic-surface); border:1px solid var(--aic-border);
            color:var(--aic-muted); cursor:pointer;
            /* opacity (et NON display:none) : le bouton reste atteignable au Tab,
               et :focus-visible le révèle — WCAG 2.4.7. */
            opacity:0;
            transition:opacity .12s ease, color .12s ease, border-color .12s ease;
        }
        .jsb-ai-chat .aic-msg--user .aic-msg-menu-btn { right:auto; left:-4px; }
        .jsb-ai-chat .aic-msg:hover .aic-msg-menu-btn,
        .jsb-ai-chat .aic-msg:focus-within .aic-msg-menu-btn,
        .jsb-ai-chat .aic-msg-menu-btn:focus-visible,
        .jsb-ai-chat .aic-msg-menu-btn[aria-expanded="true"] { opacity:1; }
        .jsb-ai-chat .aic-msg-menu-btn:hover { color:var(--aic-accent); border-color:var(--aic-accent); }
        .jsb-ai-chat .aic-msg-menu-btn:focus-visible { outline:2px solid var(--aic-accent); outline-offset:2px; }
        /* Tactile : pas de survol possible, le bouton reste donc visible. */
        @media (hover:none) { .jsb-ai-chat .aic-msg-menu-btn { opacity:1; } }
        @media (prefers-reduced-motion:reduce) { .jsb-ai-chat .aic-msg-menu-btn { transition:none; } }

        /* z-index juste au-dessus de l'infobulle .jsb-ctx-tip (9999, app.css). */
        .jsb-ai-chat .aic-msg-menu {
            position:fixed; z-index:10000; min-width:200px; padding:.25rem;
            background:var(--aic-surface); border:1px solid var(--aic-border-strong);
            border-radius:10px; box-shadow:0 8px 24px var(--aic-shadow-hover);
        }
        .jsb-ai-chat .aic-msg-menu[hidden] { display:none; }
        .jsb-ai-chat .aic-msg-menu-item {
            display:flex; align-items:center; gap:.55rem; width:100%;
            padding:.45rem .6rem; border:none; border-radius:6px; background:none;
            color:var(--aic-text); font-family:inherit; font-size:.85rem; text-align:left;
            cursor:pointer;
        }
        .jsb-ai-chat .aic-msg-menu-item[hidden] { display:none; }
        .jsb-ai-chat .aic-msg-menu-item:hover,
        .jsb-ai-chat .aic-msg-menu-item:focus-visible {
            background:var(--aic-accent-subtle); color:var(--aic-on-subtle); outline:none;
        }
        .jsb-ai-chat .aic-msg-menu-item svg { flex:0 0 auto; color:var(--aic-muted); }
        /* COLONNE D'ICÔNES DE LARGEUR FIXE — menu d'entête uniquement.
           Chaque icône imposait sa propre largeur, si bien que les libellés ne
           démarraient pas tous au même endroit. Une base fixe les aligne quoi qu'il
           arrive, y compris si une icône future arrivait sans attribut de taille.
           SCOPÉ : le menu de bulle a des icônes de 15 px, qu'il ne faut pas gonfler. */
        .jsb-ai-chat .aic-menu-entete .aic-msg-menu-item svg {
            flex:0 0 18px; width:18px; height:18px; align-self:center;
        }
        .jsb-ai-chat .aic-msg-menu-item:hover svg,
        .jsb-ai-chat .aic-msg-menu-item:focus-visible svg { color:var(--aic-on-subtle); }
        .jsb-ai-chat .aic-msg-menu-sep {
            margin:.25rem .3rem; border:none; border-top:1px solid var(--aic-border);
        }

        /* ══ Citation (« Répondre ») ════════════════════════════════════════════ */
        /* Dans la bulle : rappel du message cité, cliquable pour y revenir. */
        .jsb-ai-chat .aic-msg-quote {
            display:block; width:100%; margin:0 0 .15rem; padding:.3rem .5rem;
            text-align:left; font-family:inherit; cursor:pointer;
            background:var(--aic-bg); border:none; border-left:3px solid var(--aic-accent);
            border-radius:6px;
        }
        .jsb-ai-chat .aic-msg-quote:hover { background:var(--aic-accent-subtle); }
        .jsb-ai-chat .aic-msg-quote:focus-visible { outline:2px solid var(--aic-accent); outline-offset:2px; }
        .jsb-ai-chat .aic-msg-quote-qui {
            display:block; font-size:.7rem; font-weight:600; color:var(--aic-accent);
        }
        /* Troncature en CSS, jamais en JS : une seule règle, aucune constante
           de longueur dupliquée entre le serveur et le navigateur. */
        .jsb-ai-chat .aic-msg-quote-extrait {
            display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
            overflow:hidden; font-size:.76rem; color:var(--aic-muted); line-height:1.35;
        }
        /* Surlignage bref du message rejoint depuis une citation. */
        .jsb-ai-chat .aic-msg--cible .aic-msg-text {
            outline:2px solid var(--aic-accent); outline-offset:2px;
        }

        /* Bandeau de citation du composer : brouillon purement client, jamais
           persisté — il disparaît à l'envoi ou à l'annulation. */
        .jsb-ai-chat .aic-citation {
            display:flex; align-items:center; gap:.4rem; min-width:0;
            margin:0 0 .4rem; padding:.3rem .35rem .3rem .55rem;
            background:var(--aic-bg); border-left:3px solid var(--aic-accent); border-radius:6px;
        }
        .jsb-ai-chat .aic-citation[hidden] { display:none; }
        .jsb-ai-chat .aic-citation svg { flex:0 0 auto; color:var(--aic-accent); }
        .jsb-ai-chat .aic-citation-qui { flex:0 0 auto; font-size:.72rem; font-weight:600; color:var(--aic-accent); }
        .jsb-ai-chat .aic-citation-extrait {
            flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
            font-size:.76rem; color:var(--aic-muted);
        }

        /* Bulles système (402 tokens / erreur réseau). */
        .jsb-ai-chat .aic-notice { margin:0; padding:.6rem .8rem; border-radius:8px; font-size:.85rem; align-self:center; max-width:92%; }
        .jsb-ai-chat .aic-notice--warning { background:var(--aic-warning-bg); color:var(--aic-warning-fg); }
        .jsb-ai-chat .aic-notice--error { background:var(--aic-danger-bg); color:var(--aic-danger-fg); }
        /* Confirmation d'une action réussie (envoi d'un message par e-mail) :
           mêmes jetons que le plan exécuté, donc mode sombre couvert d'office. */
        .jsb-ai-chat .aic-notice--status { background:var(--aic-success-bg); color:var(--aic-success-fg); }

        /* Panneau de décision sous un plan de mutation préparé par Ket. */
        .jsb-ai-chat .aic-mutation-actions {
            display:flex; flex-wrap:wrap; align-items:center; gap:.5rem .6rem;
            align-self:flex-start; max-width:96%; margin:.4rem 0 .55rem;
            padding:.75rem .85rem; background:var(--aic-surface); border:1px solid var(--aic-border);
            border-left:3px solid var(--aic-accent); border-radius:10px;
        }
        .jsb-ai-chat .aic-mutation-actions .aic-notice { flex:1 1 100%; align-self:stretch; margin:.1rem 0 0; }

        /* Budget en texte simple sur une ligne (coût · solde · reste). */
        .jsb-ai-chat .aic-mutation-budget { flex:1 1 100%; margin:0 0 .1rem; font-size:.8rem; color:var(--aic-text-2); font-weight:600; }

        /* PROGRAMME : situe l'étape dans la série (« étape 2 sur 3 »). Sans ce
           repère, une série de validations successives est vécue comme une suite
           de demandes sans fin — l'utilisateur doit voir où il en est et ce qu'il
           reste. La jauge est purement décorative (l'information est dans le texte). */
        .jsb-ai-chat .aic-prog-bandeau { flex:1 1 100%; margin:0 0 .35rem; }
        .jsb-ai-chat .aic-prog-ligne {
            margin:0 0 .25rem; font-size:.78rem; font-weight:600; color:var(--aic-muted);
        }
        .jsb-ai-chat .aic-prog-ref { color:var(--aic-text-2); font-weight:700; }
        .jsb-ai-chat .aic-prog-jauge {
            height:4px; border-radius:99px; background:var(--aic-border-subtle); overflow:hidden;
        }
        .jsb-ai-chat .aic-prog-jauge span { display:block; height:100%; background:var(--aic-accent-solid); }
        /* Le rapport final : encadré discret, pour qu'il se distingue d'une réponse
           ordinaire — c'est un compte rendu, pas une conversation. */
        .jsb-ai-chat .aic-prog-correction {
            display:flex; flex-wrap:wrap; align-items:center; gap:.5rem .6rem;
            align-self:flex-start; max-width:96%; margin:.1rem 0 .55rem; padding:.65rem .8rem;
            background:var(--aic-surface); border:1px solid var(--aic-border);
            border-left:3px solid var(--aic-warning-fg); border-radius:10px;
        }
        .jsb-ai-chat .aic-prog-correction p { flex:1 1 100%; margin:0 0 .1rem; font-size:.8rem; color:var(--aic-text-2); }

        /* Aperçu AUTORITAIRE : ce que le plan écrira réellement (données serveur),
           et ce qu'il ne couvre pas — pour qu'un écart avec la prose de Ket se voie
           AVANT la validation. */
        .jsb-ai-chat .aic-mut-apercu { flex:1 1 100%; margin:0 0 .35rem; }
        .jsb-ai-chat .aic-mut-apercu-titre {
            margin:0 0 .25rem; font-size:.78rem; font-weight:600; color:var(--aic-muted);
        }
        .jsb-ai-chat .aic-mut-apercu-liste { margin:0; padding-left:1.1rem; font-size:.83rem; color:var(--aic-text); }
        .jsb-ai-chat .aic-mut-apercu-liste li { margin:.1rem 0; }
        .jsb-ai-chat .aic-mut-apercu-liste ul { margin:.1rem 0 .2rem; padding-left:1rem; color:var(--aic-text-2); font-size:.79rem; }
        .jsb-ai-chat .aic-mut-apercu-omission {
            margin:.35rem 0 0; padding:.4rem .55rem; border-radius:6px;
            background:var(--aic-warning-bg); color:var(--aic-warning-fg); font-size:.78rem;
        }

        /* SUPPRESSION : rendue visible AVANT toute décision. L'utilisateur n'était
           averti qu'après avoir cliqué « Valider et exécuter » — portée réelle,
           irréversibilité et mot de passe n'apparaissaient que dans la modale. */
        .jsb-ai-chat .aic-mut-apercu-suppression {
            color:var(--aic-danger-fg); font-weight:600;
        }
        .jsb-ai-chat .aic-mut-suppression-alerte {
            margin:.45rem 0 0; padding:.5rem .6rem; border-radius:6px;
            background:var(--aic-danger-bg); color:var(--aic-danger-fg);
            border-left:3px solid currentColor; font-size:.78rem;
        }
        .jsb-ai-chat .aic-mut-suppression-titre { margin:0; font-weight:600; }
        .jsb-ai-chat .aic-mut-suppression-portee { margin:.3rem 0 .1rem; }
        .jsb-ai-chat .aic-mut-suppression-liste { margin:0; padding-left:1.1rem; }
        .jsb-ai-chat .aic-mut-suppression-liste li { margin:.05rem 0; }
        .jsb-ai-chat .aic-mut-suppression-pied { margin:.3rem 0 0; font-weight:600; }

        /* Étendue du plan : une case à cocher par étape du parcours (l'étape socle
           reste cochée et désactivée). Décocher réajuste le budget affiché. */
        .jsb-ai-chat .aic-mut-steps {
            flex:1 1 100%; margin:.15rem 0 .35rem; padding:.5rem .6rem;
            border:1px solid var(--aic-border-subtle); border-radius:8px; background:var(--aic-bg);
        }
        .jsb-ai-chat .aic-mut-steps-legend {
            float:none; width:auto; padding:0 .2rem; margin:0 0 .3rem;
            font-size:.75rem; font-weight:600; color:var(--aic-muted); text-transform:none;
        }
        .jsb-ai-chat .aic-mut-step {
            display:flex; align-items:baseline; gap:.45rem;
            padding:.22rem .2rem; font-size:.82rem; color:var(--aic-text); cursor:pointer;
        }
        .jsb-ai-chat .aic-mut-step input { flex:0 0 auto; accent-color:var(--aic-accent-solid); cursor:pointer; }
        .jsb-ai-chat .aic-mut-step input:disabled { cursor:default; }
        .jsb-ai-chat .aic-mut-step input:focus-visible { outline:2px solid var(--aic-accent); outline-offset:2px; }
        .jsb-ai-chat .aic-mut-step-label { flex:1 1 auto; }
        .jsb-ai-chat .aic-mut-step-meta { flex:0 0 auto; font-size:.74rem; color:var(--aic-muted); }
        .jsb-ai-chat .aic-mut-step:has(input:disabled) { cursor:default; color:var(--aic-text-2); }

        /* Boutons d'action (charte cobalt + états accessibles). */
        .jsb-ai-chat .aic-mut-btn {
            display:inline-flex; align-items:center; gap:.4rem;
            min-height:38px; padding:.45rem .9rem; font-size:.85rem; font-weight:600;
            line-height:1; border-radius:8px; border:1px solid transparent; cursor:pointer;
            text-decoration:none; transition:background-color .15s ease, border-color .15s ease, box-shadow .15s ease;
        }
        .jsb-ai-chat .aic-mut-btn svg { width:15px; height:15px; flex:0 0 auto; }
        .jsb-ai-chat .aic-mut-btn--primary { background:var(--aic-accent-solid); color:var(--aic-on-accent); }
        .jsb-ai-chat .aic-mut-btn--primary:hover { background:var(--aic-accent-hover); color:var(--aic-on-accent); }
        .jsb-ai-chat .aic-mut-btn--ghost { background:transparent; color:var(--aic-text-2); border-color:var(--aic-border-strong); }
        .jsb-ai-chat .aic-mut-btn--ghost:hover { background:var(--aic-surface-raised); color:var(--aic-text); }
        .jsb-ai-chat .aic-mut-btn:focus-visible { outline:none; box-shadow:0 0 0 3px var(--aic-ring); }
        .jsb-ai-chat .aic-mut-btn:disabled { opacity:.65; pointer-events:none; }

        /* Décision MÉMORISÉE d'un plan (feedback permanent dans le fil). */
        .jsb-ai-chat .aic-plan-status {
            display:inline-flex; align-items:center; gap:.4rem; align-self:flex-start;
            max-width:96%; margin:.1rem 0 .5rem; padding:.35rem .7rem;
            font-size:.8rem; font-weight:600; border-radius:8px;
        }
        .jsb-ai-chat .aic-plan-status svg { width:14px; height:14px; flex:0 0 auto; }
        .jsb-ai-chat .aic-plan-status--done { color:var(--aic-success-fg); background:var(--aic-success-bg); }
        .jsb-ai-chat .aic-plan-status--cancelled { color:var(--aic-text-2); background:var(--aic-surface-raised); }

        /* Indicateur « réfléchit… ». */
        .jsb-ai-chat .aic-typing { flex:0 0 auto; display:flex; align-items:center; gap:.45rem; padding:.25rem 1rem .5rem; color:var(--aic-muted); font-size:.82rem; }
        .jsb-ai-chat .aic-typing[hidden] { display:none; }
        .jsb-ai-chat .aic-typing .dot {
            width:6px; height:6px; border-radius:50%; background:var(--aic-muted);
            animation: aic-blink 1.2s infinite ease-in-out;
        }
        .jsb-ai-chat .aic-typing .dot:nth-child(2) { animation-delay:.2s; }
        .jsb-ai-chat .aic-typing .dot:nth-child(3) { animation-delay:.4s; }
        @keyframes aic-blink { 0%, 80%, 100% { opacity:.25; } 40% { opacity:1; } }
        /* Compteur de jetons IA, à droite du verbe. `tabular-nums` est
           indispensable : sans lui, la ligne tressaute à chaque chiffre qui change. */
        .jsb-ai-chat .aic-typing-tokens {
            color:var(--aic-muted); font-size:.76rem; opacity:.85;
            font-variant-numeric:tabular-nums;
        }
        .jsb-ai-chat .aic-typing-tokens[hidden] { display:none; }
        .jsb-ai-chat .aic-typing-tokens::before { content:'·'; margin-right:.35rem; }

        /* ── Récapitulatif d'activité, replié sous une réponse ── */
        .jsb-ai-chat .aic-activite { margin:.3rem 0 0; font-size:.72rem; color:var(--aic-muted); }
        .jsb-ai-chat .aic-activite > summary {
            cursor:pointer; list-style:none; padding:.1rem 0;
            font-variant-numeric:tabular-nums; opacity:.8;
        }
        .jsb-ai-chat .aic-activite > summary:hover { opacity:1; }
        .jsb-ai-chat .aic-activite > summary::-webkit-details-marker { display:none; }
        .jsb-ai-chat .aic-activite > summary::before { content:'▸'; margin-right:.3rem; }
        .jsb-ai-chat .aic-activite[open] > summary::before { content:'▾'; }
        .jsb-ai-chat .aic-activite ul { margin:.2rem 0 0; padding:0 0 0 .9rem; list-style:none; }
        .jsb-ai-chat .aic-activite li { display:flex; justify-content:space-between; gap:1rem; padding:.05rem 0; }
        .jsb-ai-chat .aic-activite-cout { font-variant-numeric:tabular-nums; opacity:.75; }

        /* ── Zone de saisie (groupe champ + envoi, focus-within visible) ── */
        .jsb-ai-chat .aic-composer {
            flex:0 0 auto; display:flex; flex-direction:column; gap:.35rem;
            padding:.75rem 1rem .6rem; background:var(--aic-surface); border-top:1px solid var(--aic-border);
        }

        /* ── Objets attachés au contexte (puces au-dessus de la saisie) ── */
        .jsb-ai-chat .aic-context { display:flex; flex-direction:column; gap:.3rem; }
        .jsb-ai-chat .aic-context:empty { display:none; }
        .jsb-ai-chat .aic-context-head {
            display:flex; align-items:center; justify-content:space-between; gap:.75rem;
        }
        .jsb-ai-chat .aic-context-count { color:var(--aic-muted); font-size:.74rem; }
        .jsb-ai-chat .aic-context-clear {
            display:inline-flex; align-items:center; gap:.25rem;
            background:none; border:none; cursor:pointer;
            color:var(--aic-muted); font-size:.74rem; padding:.15rem .4rem; border-radius:6px;
            transition: color .15s ease, background-color .15s ease;
        }
        .jsb-ai-chat .aic-context-clear:hover { color:var(--aic-danger-fg); background:var(--aic-danger-bg); }
        .jsb-ai-chat .aic-context-clear:focus-visible { outline:2px solid var(--aic-accent); outline-offset:2px; }
        .jsb-ai-chat .aic-context-chips {
            display:flex; flex-wrap:wrap; gap:.35rem;
            list-style:none; margin:0; padding:0;
        }
        .jsb-ai-chat .aic-chip {
            display:inline-flex; align-items:center; gap:.3rem; max-width:100%;
            background:var(--aic-accent-subtle); border:1px solid transparent; border-radius:999px;
            padding:.2rem .3rem .2rem .6rem; font-size:.78rem; color:var(--aic-text);
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .jsb-ai-chat .aic-chip:hover { border-color:var(--aic-accent); box-shadow:0 2px 6px var(--aic-shadow-chip); }
        .jsb-ai-chat .aic-chip-icon { display:flex; flex:0 0 auto; color:var(--aic-on-subtle); }
        .jsb-ai-chat .aic-chip-label {
            min-width:0; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
        }
        .jsb-ai-chat .aic-chip-remove {
            display:flex; align-items:center; justify-content:center; flex:0 0 auto;
            width:22px; height:22px; border-radius:50%; border:none; cursor:pointer;
            background:none; color:var(--aic-muted);
            transition: background-color .15s ease, color .15s ease;
        }
        .jsb-ai-chat .aic-chip-remove:hover { background:var(--aic-accent-solid); color:var(--aic-on-accent); }
        .jsb-ai-chat .aic-chip-remove:focus-visible { outline:2px solid var(--aic-accent); outline-offset:1px; }

        /* ── Pièces jointes (puces fichiers) ── */
        /* Fond neutre distinct des puces objets (cobalt subtil) pour différencier
           d'un coup d'œil les deux natures de contexte. */
        .jsb-ai-chat .aic-fichiers:empty { display:none; }
        .jsb-ai-chat .aic-fichier-chip { background:var(--aic-chip-file-bg); }
        .jsb-ai-chat .aic-chip-download { color:var(--aic-accent); text-decoration:none; }
        .jsb-ai-chat .aic-chip-download:hover { text-decoration:underline; }
        .jsb-ai-chat .aic-chip-size { flex:0 0 auto; color:var(--aic-muted); font-size:.7rem; }
        /* Puce en cours de chargement : spinner + libellé atténué, non interactive. */
        .jsb-ai-chat .aic-fichier-chip.is-loading { color:var(--aic-muted); }
        .jsb-ai-chat .aic-fichier-chip.is-loading .aic-chip-remove { visibility:hidden; }
        .jsb-ai-chat .aic-chip-spinner {
            width:13px; height:13px; flex:0 0 auto; border-radius:50%;
            border:2px solid var(--aic-border-strong); border-top-color:var(--aic-accent);
            animation: aic-spin .7s linear infinite;
        }
        .jsb-ai-chat .aic-fichier-chip.is-error { background:var(--aic-danger-bg); color:var(--aic-danger-fg); }
        @keyframes aic-spin { to { transform:rotate(360deg); } }
        @media (prefers-reduced-motion: reduce) {
            .jsb-ai-chat .aic-chip-spinner { animation:none; }
        }

        /* Bouton « joindre un fichier » (trombone) : jumeau du bouton micro. */
        .jsb-ai-chat .aic-attach {
            flex:0 0 auto; width:44px; height:44px; border-radius:10px; border:none; cursor:pointer;
            background:transparent; color:var(--aic-muted); display:flex; align-items:center; justify-content:center;
            transition: background-color .15s ease, color .15s ease;
        }
        .jsb-ai-chat .aic-attach:hover { background:var(--aic-accent-subtle); color:var(--aic-on-subtle); }
        .jsb-ai-chat .aic-attach:focus-visible { outline:2px solid var(--aic-accent); outline-offset:2px; }

        /* Agrafe fichiers d'une bulle utilisateur : liseré vert discret (distinct
           de l'agrafe objets) pour signaler « des pièces étaient jointes ». */
        .jsb-ai-chat .aic-msg-attach--file { cursor:default; }
        .jsb-ai-chat .aic-msg-attach--file:hover { border-color:var(--aic-success-fg); color:var(--aic-success-fg); }

        /* Panneau de téléchargement des pièces jointes proposé par Ket (uiAction
           files-download) : boutons-liens vers la route sécurisée. */
        .jsb-ai-chat .aic-files-dl {
            align-self:flex-start; max-width:96%; margin:.1rem 0 .55rem;
            padding:.7rem .85rem; background:var(--aic-surface); border:1px solid var(--aic-border);
            border-left:3px solid var(--aic-accent); border-radius:10px;
            display:flex; flex-direction:column; gap:.4rem;
        }
        /* DANS LA BULLE, le panneau n'est plus un bloc : il en est le contenu. Ce qui en
           faisait une boîte autonome — son fond, son cadre, son liseré, sa largeur propre
           — ferait ici une boîte dans une boîte. Ne restent que la séparation d'avec le
           texte au-dessus et l'espacement interne. Les règles ci-dessus servent encore le
           repli, quand aucune bulle n'a pu être trouvée. */
        .jsb-ai-chat .aic-msg-body > .aic-files-dl {
            align-self:auto; max-width:100%; margin:.55rem 0 0; padding:.55rem 0 0;
            background:none; border:0; border-top:1px solid var(--aic-border); border-radius:0;
        }
        .jsb-ai-chat .aic-files-dl-title { margin:0; font-size:.8rem; font-weight:600; color:var(--aic-muted); }
        .jsb-ai-chat .aic-file-dl-btn {
            display:inline-flex; align-items:center; gap:.45rem; align-self:flex-start; max-width:100%;
            padding:.4rem .75rem; border:1px solid var(--aic-border-strong); border-radius:8px;
            background:var(--aic-btn-neutral-bg); color:var(--aic-accent); text-decoration:none; font-size:.83rem; font-weight:600;
            transition:background-color .15s ease, border-color .15s ease, box-shadow .15s ease;
        }
        .jsb-ai-chat .aic-file-dl-btn:hover { background:var(--aic-accent-subtle); border-color:var(--aic-accent); }
        .jsb-ai-chat .aic-file-dl-btn:focus-visible { outline:none; box-shadow:0 0 0 3px var(--aic-ring); }
        .jsb-ai-chat .aic-file-dl-btn svg { flex:0 0 auto; }
        .jsb-ai-chat .aic-file-dl-label { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

        /* DOCUMENT PRODUIT par Ket. Voisin du panneau ci-dessus, mais le bouton y
           porte deux niveaux d'information : le NOM (l'identifiant, en premier) et,
           en dessous, le FORMAT et la TAILLE. Tous les jetons sont ceux du chat :
           le thème sombre suit sans une seule règle en plus. */
        .jsb-ai-chat .aic-doc-dl {
            align-self:flex-start; max-width:96%; margin:.1rem 0 .55rem;
            padding:.7rem .85rem; background:var(--aic-surface); border:1px solid var(--aic-border);
            border-left:3px solid var(--aic-success-fg); border-radius:10px;
            display:flex; flex-direction:column; gap:.45rem;
        }
        .jsb-ai-chat .aic-doc-dl-btn {
            display:inline-flex; align-items:center; gap:.6rem; align-self:flex-start; max-width:100%;
            padding:.55rem .8rem; border:1px solid var(--aic-border-strong); border-radius:9px;
            background:var(--aic-btn-neutral-bg); color:var(--aic-accent); text-decoration:none;
            transition:background-color .15s ease, border-color .15s ease, box-shadow .15s ease;
        }
        .jsb-ai-chat .aic-doc-dl-btn:hover { background:var(--aic-accent-subtle); border-color:var(--aic-accent); }
        .jsb-ai-chat .aic-doc-dl-btn:focus-visible { outline:none; box-shadow:0 0 0 3px var(--aic-ring); }
        .jsb-ai-chat .aic-doc-dl-btn svg { flex:0 0 auto; }
        .jsb-ai-chat .aic-doc-dl-corps { min-width:0; display:flex; flex-direction:column; gap:.15rem; }
        .jsb-ai-chat .aic-doc-dl-nom {
            font-size:.85rem; font-weight:600; min-width:0;
            overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
        }
        .jsb-ai-chat .aic-doc-dl-meta {
            display:flex; align-items:center; gap:.4rem;
            font-size:.74rem; font-weight:500; color:var(--aic-muted);
        }
        /* Pastille de format : le TEXTE porte l'information, pas la couleur seule. */
        .jsb-ai-chat .aic-doc-dl-badge {
            padding:.05rem .35rem; border-radius:4px; letter-spacing:.03em;
            background:var(--aic-accent-subtle); color:var(--aic-on-subtle); font-weight:700; font-size:.68rem;
        }
        /* Dossier d'origine, sous la carte d'un fichier unique : c'est le contexte que
           l'utilisateur vient chercher, mais il ne doit pas concurrencer le nom. */
        .jsb-ai-chat .aic-fdl-origine { font-size:.72rem; color:var(--aic-muted); }

        /* TABLEAU DES FICHIERS (deux fichiers ou plus). Un tableau parce qu'à partir de
           deux lignes l'œil compare par colonnes ; numéroté parce que l'utilisateur
           désigne ensuite « le 3 » dans la conversation. Il défile DANS son conteneur :
           sans cela, un rattachement un peu long ferait défiler toute la colonne de
           chat latéralement. Tous les jetons sont ceux du chat — le mode sombre suit. */
        .jsb-ai-chat .aic-fdl-scroll { max-width:100%; overflow-x:auto; }
        .jsb-ai-chat .aic-fdl-table { border-collapse:collapse; width:100%; font-size:.76rem; }
        .jsb-ai-chat .aic-fdl-table th {
            text-align:left; white-space:nowrap; font-weight:700; font-size:.66rem;
            letter-spacing:.05em; text-transform:uppercase; color:var(--aic-muted);
            padding:.3rem .5rem; border-bottom:1px solid var(--aic-border-strong);
        }
        .jsb-ai-chat .aic-fdl-table td {
            padding:.4rem .5rem; color:var(--aic-text); vertical-align:middle;
            border-bottom:1px solid var(--aic-border);
        }
        .jsb-ai-chat .aic-fdl-table tbody tr:last-child td { border-bottom:none; }
        .jsb-ai-chat .aic-fdl-c-num { text-align:right; color:var(--aic-muted); font-variant-numeric:tabular-nums; }
        .jsb-ai-chat .aic-fdl-c-nom { font-weight:600; max-width:16rem; }
        .jsb-ai-chat .aic-fdl-c-fmt { font-weight:700; font-size:.68rem; color:var(--aic-on-subtle); }
        .jsb-ai-chat .aic-fdl-c-taille { white-space:nowrap; color:var(--aic-muted); font-variant-numeric:tabular-nums; }
        .jsb-ai-chat .aic-fdl-c-date { white-space:nowrap; color:var(--aic-muted); font-variant-numeric:tabular-nums; }
        .jsb-ai-chat .aic-fdl-c-lien { color:var(--aic-muted); max-width:14rem; }
        .jsb-ai-chat .aic-fdl-c-btn { text-align:center; }
        /* Bouton de ligne : carré, discret, mais avec une cible de clic tenable. */
        .jsb-ai-chat .aic-fdl-btn {
            display:inline-flex; align-items:center; justify-content:center;
            width:28px; height:28px; border-radius:7px;
            border:1px solid var(--aic-border-strong); background:var(--aic-btn-neutral-bg);
            color:var(--aic-accent); text-decoration:none;
            transition:background-color .15s ease, border-color .15s ease, box-shadow .15s ease;
        }
        .jsb-ai-chat .aic-fdl-btn:hover { background:var(--aic-accent-subtle); border-color:var(--aic-accent); }
        .jsb-ai-chat .aic-fdl-btn:focus-visible { outline:none; box-shadow:0 0 0 3px var(--aic-ring); }
        /* « Tout télécharger » : l'action GLOBALE, donc pleine largeur sous le tableau
           et non alignée avec les boutons de ligne, qu'elle ne remplace pas. */
        .jsb-ai-chat .aic-fdl-zip {
            display:inline-flex; align-items:center; gap:.45rem; align-self:flex-start;
            margin-top:.15rem; padding:.4rem .75rem; border-radius:8px;
            border:1px solid var(--aic-accent); background:var(--aic-accent-subtle);
            color:var(--aic-on-subtle); text-decoration:none; font-size:.8rem; font-weight:600;
            transition:box-shadow .15s ease, filter .15s ease;
        }
        .jsb-ai-chat .aic-fdl-zip:hover { filter:brightness(1.04); }
        .jsb-ai-chat .aic-fdl-zip:focus-visible { outline:none; box-shadow:0 0 0 3px var(--aic-ring); }

        /* Barre de décision d'un document : sélecteur de format en plus du budget. */
        .jsb-ai-chat .aic-doc-apercu { flex:1 1 100%; margin:0 0 .1rem; font-size:.82rem; color:var(--aic-text); }
        .jsb-ai-chat .aic-doc-apercu span { color:var(--aic-muted); }
        .jsb-ai-chat .aic-doc-format { display:inline-flex; align-items:center; gap:.4rem; font-size:.78rem; color:var(--aic-muted); }
        /* `display:inline-flex` l'emporterait sur la règle [hidden] du navigateur :
           sans cette ligne, le sélecteur de thème resterait visible sur un Word, qui
           ne sait pas le tenir. Même précaution que .aic-msg-menu et .aic-citation. */
        .jsb-ai-chat .aic-doc-format[hidden] { display:none; }
        .jsb-ai-chat .aic-doc-format select {
            padding:.25rem .45rem; border-radius:7px; font-size:.78rem;
            border:1px solid var(--aic-border-strong); background:var(--aic-input-bg); color:var(--aic-input-text);
        }
        .jsb-ai-chat .aic-doc-format select:focus-visible { outline:none; box-shadow:0 0 0 3px var(--aic-ring); border-color:var(--aic-accent); }
        .jsb-ai-chat .aic-inputbox {
            display:flex; align-items:flex-end; gap:.5rem;
            border:1px solid var(--aic-border-strong); border-radius:12px; background:var(--aic-input-bg);
            padding:.3rem .35rem .3rem .7rem;
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .jsb-ai-chat .aic-inputbox:focus-within { border-color:var(--aic-accent); box-shadow:0 0 0 .25rem var(--aic-ring); }
        .jsb-ai-chat .aic-input-ic { flex:0 0 auto; align-self:center; display:flex; color:var(--aic-muted); }
        .jsb-ai-chat .aic-input {
            flex:1 1 auto; resize:none; min-height:40px; max-height:160px;
            border:none; background:transparent; padding:.5rem .25rem;
            font-size:.9rem; color:var(--aic-input-text); line-height:1.45;
        }
        .jsb-ai-chat .aic-input:focus { outline:none; box-shadow:none; }
        /* Le placeholder par défaut du navigateur dérive de `color` : sur fond
           sombre il deviendrait presque aussi clair que la saisie. On le fixe
           sur le gris atténué de la charte (6.87:1 sur la boîte sombre). */
        .jsb-ai-chat .aic-input::placeholder { color:var(--aic-muted); opacity:1; }
        /* ── Bouton micro (dictée vocale) : bouton fantôme, état « écoute » pulsé ── */
        .jsb-ai-chat .aic-mic {
            flex:0 0 auto; width:44px; height:44px; border-radius:10px; border:none; cursor:pointer;
            background:transparent; color:var(--aic-muted); display:flex; align-items:center; justify-content:center;
            transition: background-color .15s ease, color .15s ease;
        }
        .jsb-ai-chat .aic-mic:hover { background:var(--aic-accent-subtle); color:var(--aic-on-subtle); }
        .jsb-ai-chat .aic-mic:focus-visible { outline:2px solid var(--aic-accent); outline-offset:2px; }
        .jsb-ai-chat .aic-mic[hidden] { display:none; }
        .jsb-ai-chat .aic-mic--recording,
        .jsb-ai-chat .aic-mic--recording:hover {
            background:var(--aic-danger-bg); color:var(--aic-danger-fg); animation: aic-mic-pulse 1.4s ease-in-out infinite;
        }
        @keyframes aic-mic-pulse {
            0%, 100% { box-shadow:0 0 0 0 var(--aic-mic-pulse); }
            50%      { box-shadow:0 0 0 .35rem var(--aic-mic-fade); }
        }
        @media (prefers-reduced-motion: reduce) {
            .jsb-ai-chat .aic-mic--recording { animation:none; }
        }
        .jsb-ai-chat .aic-send {
            flex:0 0 auto; width:44px; height:44px; border-radius:10px; border:none; cursor:pointer;
            background:var(--aic-accent-solid); color:var(--aic-on-accent); display:flex; align-items:center; justify-content:center;
            transition: background-color .15s ease, opacity .15s ease;
        }
        .jsb-ai-chat .aic-send:hover { background:var(--aic-accent-hover); }
        .jsb-ai-chat .aic-send:focus-visible { outline:2px solid var(--aic-accent); outline-offset:2px; }
        .jsb-ai-chat .aic-send:disabled { opacity:.65; pointer-events:none; }
        /* Pied du composer : indice de raccourcis + compteur près de la limite. */
        .jsb-ai-chat .aic-composer-foot {
            display:flex; justify-content:space-between; gap:.75rem;
            font-size:.72rem; color:var(--aic-muted); padding:0 .25rem;
        }
        .jsb-ai-chat .aic-count[hidden] { display:none; }
        .jsb-ai-chat .aic-count--limite { color:var(--aic-warning-fg); font-weight:600; }
        .jsb-ai-chat .visually-hidden {
            position:absolute; width:1px; height:1px; padding:0; margin:-1px;
            overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
        }
    </style>

    {# ── Entête ── #}
    <div class="aic-header">
        <span class="aic-avatar" aria-hidden="true">{{ assistantNom|first|upper }}</span>
        <div class="aic-header-txt">
            <p class="aic-header-nom">{{ assistantNom }}</p>
            <p class="aic-header-sub">Assistant IA · {{ entreprise.nom }}</p>
        </div>
        {# DEUX BOUTONS, PAS QUATRE. L'entête portait quatre icônes, et le nom du
           cabinet — « Assistant IA · Sté COURTAGE RDC Sarl » — s'y trouvait rogné :
           dans une colonne étroite, ce texte est pourtant ce qui dit à l'utilisateur
           OÙ il travaille. Les commandes occasionnelles (thème, plein écran,
           nouvelle conversation) passent donc dans un menu ⋮, et seules restent
           visibles les deux dont on a besoin d'un coup d'œil : ouvrir les options,
           et fermer.
           Le ⋮ porte l'auto-marge `.aic-iconbtn:first-of-type` qui pousse le groupe
           à droite, d'où sa place en premier. #}
        {# ── Commandes de la conversation ──
           UN SEUL jeu d'éléments, deux présentations : replié en menu flottant
           quand la place manque, déplié en boutons d'icône en plein écran (cf. les
           règles .jsb-ai-chat--full plus haut). Rien n'est dupliqué, donc les deux
           états ne peuvent pas diverger.
           Mêmes classes que le menu de bulle : une seule apparence de menu flottant
           dans le chat, un seul comportement à apprendre.
           Les classes .aic-theme et .aic-fullscreen sont CONSERVÉES sur les items :
           c'est par elles que le contrôleur de thème et le workspace-manager
           synchronisent leur état. Les déplacer sans elles aurait laissé deux
           bascules muettes. #}
        {# REPLIÉ PAR UNE CLASSE, PAS PAR L'ATTRIBUT `hidden`.
           Les navigateurs Chromium appliquent `[hidden] { display:none !important }`
           dans leur feuille de style utilisateur : aucune règle d'auteur ne peut la
           surcharger, quelle que soit sa spécificité. Le menu restait donc invisible
           en plein écran alors que le ⋮, masqué par une règle ORDINAIRE, disparaissait
           bien — d'où une entête avec le seul bouton « fermer ».
           Une classe produit le même `display:none` (donc la même sortie de l'arbre
           d'accessibilité) tout en restant surchargeable. #}
        <div class="aic-msg-menu aic-menu-entete is-ferme" role="menu"
             id="aic-menu-entete-{{ conversation.id }}"
             aria-label="Options de la conversation"
             data-assistant-chat-target="menuEntete"
             data-action="keydown->assistant-chat#naviguerMenuEntete">
            {# NOUVELLE CONVERSATION — le raccourci qui manquait. Repartir de zéro
               supposait de passer par la liste des conversations ; or c'est le geste
               qu'on fait quand le fil est devenu long, donc au moment où l'on a le
               moins envie de naviguer. Il REMPLACE le fil affiché sans rien
               détruire : la conversation précédente reste ouvrable depuis la liste. #}
            <button type="button" class="aic-msg-menu-item aic-new" role="menuitem"
                    aria-label="Nouvelle conversation" title="Nouvelle conversation"
                    data-action="click->assistant-chat#nouvelleConversation">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/>
                    <path d="M12 7v6"/><path d="M9 10h6"/>
                </svg>
                <span>Nouvelle conversation</span>
            </button>
            <hr class="aic-msg-menu-sep">
            {# Bascule clair / sombre du chat (et du chat SEUL).
               A11y : libellé STABLE + état porté par aria-pressed/aria-checked —
               faire varier les deux s'annoncerait de façon contradictoire
               (« Activer le mode clair, activé »). #}
            <button type="button" class="aic-msg-menu-item aic-theme" role="menuitemcheckbox"
                    aria-checked="false" aria-pressed="false"
                    aria-label="Mode sombre" title="Mode sombre"
                    data-action="click->assistant-chat#toggleTheme click->assistant-chat#fermerMenuEntete">
                <svg class="aic-ic-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                </svg>
                <svg class="aic-ic-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2"/><path d="M12 20v2"/><path d="M4.93 4.93l1.41 1.41"/>
                    <path d="M17.66 17.66l1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/>
                    <path d="M6.34 17.66l-1.41 1.41"/><path d="M19.07 4.93l-1.41 1.41"/>
                </svg>
                <span>Mode sombre</span>
            </button>
            {# Plein écran : élargit le chat sur les colonnes 3+4 (voir
               workspace-manager#toggleChatFullscreen). L'icône suit aria-pressed. #}
            <button type="button" class="aic-msg-menu-item aic-fullscreen" role="menuitemcheckbox"
                    aria-checked="false" aria-pressed="false"
                    aria-label="Afficher le chat en plein écran" title="Plein écran"
                    data-action="click->workspace-manager#toggleChatFullscreen click->assistant-chat#fermerMenuEntete">
                <svg class="aic-ic-expand" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/>
                    <path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/>
                </svg>
                <svg class="aic-ic-collapse" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M8 3v3a2 2 0 0 1-2 2H3"/><path d="M21 8h-3a2 2 0 0 1-2-2V3"/>
                    <path d="M3 16h3a2 2 0 0 1 2 2v3"/><path d="M16 21v-3a2 2 0 0 1 2-2h3"/>
                </svg>
                <span>Plein écran</span>
            </button>
        </div>
        <button type="button" class="aic-iconbtn aic-options"
                data-action="click->assistant-chat#basculerMenuEntete keydown->assistant-chat#toucheOptions"
                aria-haspopup="menu" aria-expanded="false"
                aria-controls="aic-menu-entete-{{ conversation.id }}"
                aria-label="Options de la conversation"
                title="Options">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                 viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/>
            </svg>
        </button>
        <button type="button" class="aic-iconbtn aic-close" data-action="click->workspace-manager#closeTab"
                aria-label="Fermer la conversation">
            <twig:UX:Icon name="{{ resolve_icon_name('action:exit') }}" style="width:20px;height:20px;" />
        </button>
    </div>


    {# ── Fil de messages ── #}
    <div class="aic-messages" role="log" aria-live="polite"
         aria-label="Conversation avec {{ assistantNom }}"
         data-assistant-chat-target="messages">
        {% if conversation.messages is empty %}
            {# Conversation vide : Ket ouvre sur le PROGRAMME DU JOUR quand il a
               quelque chose à dire, et sur l'accueil ordinaire sinon (invité sans
               périmètre, rien à traiter, ou calcul indisponible — le contrôleur
               passe alors planDuJour à null). #}
            {% if planDuJour is defined and planDuJour %}
                {# `only` : le partial ne reçoit QUE ce dont il a besoin (pas la
                   conversation ni les fichiers) — d'où le passage explicite du
                   nom du personnage, qui signe l'avatar de la bulle. #}
                {% include 'components/assistant_ia/_plan_du_jour.html.twig'
                    with { plan: planDuJour, assistantNom: assistantNom } only %}
            {% else %}
                <div class="aic-msg aic-msg--assistant">
                    <span class="aic-msg-avatar" aria-hidden="true">{{ assistantNom|first|upper }}</span>
                    <div class="aic-msg-body">
                        <p class="aic-msg-text">Bonjour ! Je suis {{ assistantNom }}, l'assistant IA de {{ entreprise.nom }}. Posez-moi une question sur les données de votre espace de travail — par exemple « Combien de clients avons-nous ? » ou « Quel est mon périmètre d'accès ? ».</p>
                    </div>
                </div>
            {% endif %}
        {% endif %}
        {% for message in conversation.messages %}
            {% set estAssistant = message.role == 'assistant' %}
            {% set estRefus = estAssistant and (message.meta.refus ?? false) %}
            {# Décision d'un plan de mutation, MÉMORISÉE dans le fil : en attente
               (barre reconstruite après F5), exécuté ou annulé (feedback permanent).
               Règle canonique côté PHP : App\Ai\Mutation\PlanEnAttente (verrou
               anti-empilement) — garder ces trois tests alignés dessus. #}
            {% set hasPlan = estAssistant and (message.meta.mutationPlan ?? null) is not null %}
            {% set planExecute = hasPlan and (message.meta.mutationPlanExecuted ?? false) %}
            {% set planAnnule = hasPlan and (message.meta.mutationPlanCancelled ?? false) %}
            {% set planEnAttente = hasPlan and not planExecute and not planAnnule %}
            {# Même trilogie pour un plan de DOCUMENT. Le bouton de téléchargement
               d'un document PRODUIT doit survivre au rechargement : il a été payé
               en tokens, le voir disparaître avec la page reviendrait à le faire
               payer deux fois. Règle canonique : App\Ai\Document\DocumentEnAttente. #}
            {# Reformulation à confirmer (phase de compréhension). Elle n'a ni statut
               « exécuté » ni statut « annulé » : elle est en attente tant qu'elle est
               le DERNIER message du fil — dès que l'utilisateur a répondu, une bulle
               suit et la question est tranchée. C'est aussi la règle que la garde
               anti-boucle applique côté PHP (App\Ai\Comprehension\ClarificationEnAttente). #}
            {% set clarifEnAttente = estAssistant and (message.meta.clarification ?? null) is not null and loop.last %}
            {# PANNEAU DE TÉLÉCHARGEMENT — le seul panneau DÉCLARATIF du chat qui ne
               survivait pas au rechargement. Sa donnée, elle, était déjà persistée : la
               meta porte l'action complète, chaque ligne avec son URL. Il ne manquait que
               ce lecteur. Aucun statut à consulter, contrairement aux barres de décision :
               un tableau de fichiers n'est ni « exécuté » ni « annulé », il est vrai tant
               que les fichiers existent — et la route de téléchargement se revalide
               elle-même au clic. #}
            {% set fichiersDl = estAssistant
                ? (message.meta.actions|default([])|filter(a => (a.type ?? '') == 'files-download')|first)
                : null %}
            {% set hasDoc = estAssistant and (message.meta.documentPlan ?? null) is not null %}
            {% set docProduit = hasDoc and (message.meta.documentPlanExecuted ?? false) %}
            {% set docAnnule = hasDoc and (message.meta.documentPlanCancelled ?? false) %}
            {% set docEnAttente = hasDoc and not docProduit and not docAnnule %}
            {# data-message-id : identité de la bulle, sans laquelle aucune action
               (répondre, exporter, envoyer) n'est possible. Volontairement un
               data-* et NON un id= : deux conversations peuvent être ouvertes en
               même temps, un id DOM entrerait en collision.
               `programme` dans data-mutation-review : sans lui, un F5 en cours de
               série ferait perdre le repère « étape 2 sur 3 » et le bouton
               d'interruption. (Aucun commentaire Twig DANS le littéral ci-dessous :
               `{#` y est une erreur de parsing, pas un commentaire.) #}
            <div class="aic-msg aic-msg--{{ estAssistant ? 'assistant' : 'user' }}{{ estRefus ? ' aic-msg--refus' }}"
                data-message-id="{{ message.id }}"
                data-message-role="{{ message.role }}"
                {%- if planEnAttente %} data-mutation-review="{{ {
                    idMessage: message.id,
                    budget: message.meta.mutationPlan.budget,
                    apercu: message.meta.mutationPlan.apercu ?? [],
                    omissions: message.meta.mutationPlan.omissions ?? [],
                    requiresPassword: message.meta.mutationPlan.requiresPassword ?? false,
                    impacts: message.meta.mutationPlan.impacts ?? [],
                    programme: message.meta.programme ?? null
                }|json_encode|e('html_attr') }}"{% endif %}
                {%- if docEnAttente %} data-document-review="{{ {
                    idMessage: message.id,
                    apercu: message.meta.documentPlan.apercu ?? [],
                    budget: message.meta.documentPlan.budget ?? [],
                    format: message.meta.documentPlan.format ?? 'docx'
                }|json_encode|e('html_attr') }}"{% endif %}
                {%- if clarifEnAttente %} data-clarification="{{ {
                    intention: message.meta.clarification.intention ?? ''
                }|json_encode|e('html_attr') }}"{% endif %}
                {%- if fichiersDl %} data-files-download="{{ fichiersDl|json_encode|e('html_attr') }}"{% endif %}>
                {% if estAssistant %}
                    <span class="aic-msg-avatar" aria-hidden="true">{{ assistantNom|first|upper }}</span>
                {% endif %}
                <div class="aic-msg-body">
                    {# Message CITÉ (« Répondre ») : rappel cliquable, en tête de
                       bulle. Même macro que le <template> cloné en direct. #}
                    {% if message.repondA %}
                        {{ aic.citationBulle(
                            message.repondA.role == 'assistant' ? assistantNom : 'Vous',
                            message.repondA.extraitCitation,
                            message.repondA.id
                        ) }}
                    {% endif %}
                    {% if estAssistant %}
                        <p class="aic-msg-text" data-md-source="{{ message.contenu|e('html_attr') }}">{{ message.contenu }}</p>
                    {% else %}
                        <p class="aic-msg-text">{{ message.contenu }}</p>
                    {% endif %}
                    {# Agrafe : instantané IMMUABLE des objets du contexte à l'envoi de CE
                       message (le contexte courant de la conversation évolue, ce cliché
                       jamais). Survol = infobulle sombre ; clic = épinglage. #}
                    {% if not estAssistant and message.contexteObjets %}
                        {% set agrafe = [] %}
                        {% for o in message.contexteObjets %}
                            {% set agrafe = agrafe|merge([o|merge({typeLabel: token_entite_label('App\\Entity\\' ~ o.type)})]) %}
                        {% endfor %}
                        <button type="button" class="aic-msg-attach"
                                data-msg-contextes="{{ agrafe|json_encode|e('html_attr') }}"
                                data-action="click->assistant-chat#toggleMsgContextes"
                                aria-label="{{ message.contexteObjets|length }} objet{{ message.contexteObjets|length > 1 ? 's' : '' }} en contexte à l'envoi de ce message">
                            {{ ux_icon(resolve_icon_name('lucide:paperclip'), {height: '11px', width: '11px'}) }}
                            <span>{{ message.contexteObjets|length }}</span>
                        </button>
                    {% endif %}
                    {# Agrafe des pièces jointes à l'envoi de CE message (instantané immuable). #}
                    {% if not estAssistant and message.fichiersJoints %}
                        <span class="aic-msg-attach aic-msg-attach--file"
                              title="{{ message.fichiersJoints|map(f => f.nom)|join(', ') }}"
                              aria-label="{{ message.fichiersJoints|length }} fichier{{ message.fichiersJoints|length > 1 ? 's' : '' }} joint{{ message.fichiersJoints|length > 1 ? 's' : '' }} à l'envoi de ce message">
                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v5h5"/>
                            </svg>
                            <span>{{ message.fichiersJoints|length }}</span>
                        </span>
                    {% endif %}
                    {# Heure seule pour les messages du jour, date + heure au-delà. #}
                    {% set memeJour = message.createdAt|date('Y-m-d') == 'now'|date('Y-m-d') %}
                    <span class="aic-msg-time">{{ message.createdAt|date(memeJour ? 'H:i' : 'd/m/Y H:i') }}</span>
                    {# RÉCAPITULATIF D'ACTIVITÉ après rechargement. Ce nœud ne porte que
                       les CHIFFRES : c'est le contrôleur Stimulus qui le remplace par le
                       bloc rendu, avec la même table de verbes qu'en direct. Recopier ces
                       libellés ici en ferait une seconde vérité, qui divergerait au premier
                       changement de vocabulaire — même parti pris que pour les propositions
                       de correction d'un programme (data-programme-correction). #}
                    {% if estAssistant and (message.meta.activite ?? null) %}
                        <div data-activite="{{ message.meta.activite|json_encode|e('html_attr') }}"></div>
                    {% endif %}
                </div>
            </div>
            {# Décision mémorisée : feedback PERMANENT sous le plan (validé / annulé). #}
            {% if planExecute %}
                <p class="aic-plan-status aic-plan-status--done" role="status">
                    {{ ux_icon(resolve_icon_name('lucide:check-check'), {height: '14px', width: '14px'}) }}
                    <span>Plan exécuté — les données ont été enregistrées.</span>
                </p>
            {% elseif planAnnule %}
                <p class="aic-plan-status aic-plan-status--cancelled" role="status">
                    {{ ux_icon(resolve_icon_name('lucide:x'), {height: '14px', width: '14px'}) }}
                    <span>Plan annulé — aucune donnée n’a été modifiée.</span>
                </p>
            {% endif %}
            {# DOCUMENT PRODUIT : le bouton est rendu CÔTÉ SERVEUR — un simple lien,
               qui survit donc au rechargement sans une ligne de JavaScript. Miroir
               exact de renderDocumentDownload() dans assistant-chat_controller.js :
               modifier l'un sans l'autre ferait diverger l'affichage direct et
               l'affichage après F5. #}
            {% if docProduit and (message.meta.documentGenere ?? null) %}
                {% set doc = message.meta.documentGenere %}
                <div class="aic-doc-dl" role="group" aria-label="Téléchargement du document produit">
                    <p class="aic-files-dl-title">Document prêt</p>
                    <a class="aic-doc-dl-btn" href="{{ doc.url }}" download rel="noopener"
                       aria-label="Télécharger « {{ doc.titre|default(doc.nom) }} » — {{ doc.formatLibelle|default('') }}, {{ doc.tailleLisible|default('') }}">
                        {{ ux_icon(resolve_icon_name('lucide:file-down'), {height: '17px', width: '17px'}) }}
                        <span class="aic-doc-dl-corps">
                            <span class="aic-doc-dl-nom">{{ doc.nom }}</span>
                            <span class="aic-doc-dl-meta">
                                <span class="aic-doc-dl-badge">{{ doc.formatBadge|default('') }}</span>
                                <span>{{ doc.tailleLisible|default('') }}</span>
                            </span>
                        </span>
                    </a>
                </div>
            {% elseif docAnnule %}
                <p class="aic-plan-status aic-plan-status--cancelled" role="status">
                    {{ ux_icon(resolve_icon_name('lucide:x'), {height: '14px', width: '14px'}) }}
                    <span>Production annulée — aucun document n’a été produit, aucun token débité.</span>
                </p>
            {% endif %}
            {# Plan FANTÔME : le message décrit un plan/bouton que le modèle n'a pas
               réellement préparé (aucune action émise). Avertissement autoritaire
               réaffiché après un rechargement, en miroir du live (executeActions). #}
            {% if estAssistant and (message.meta.mutationAbsent ?? false) %}
                {# Les messages ANTÉRIEURS à l'ajout du motif portent un simple booléen :
                   on ne cherche la clé que sur une structure, sinon le fil d'archive
                   casserait à l'affichage. #}
                {% set motifAbsent = message.meta.mutationAbsent is iterable
                    ? (message.meta.mutationAbsent.motif ?? null) : null %}
                <p class="aic-notice aic-notice--warning" role="status">
                    {%- if motifAbsent -%}
                        Aucun plan n'a pu être préparé, donc aucun bouton « Valider et exécuter » n'apparaîtra — {{ motifAbsent }}
                    {%- else -%}
                        Aucun plan n'est réellement en attente de validation : l'opération n'a pas été préparée, donc aucun bouton « Valider et exécuter » n'apparaîtra. Redemandez l'action pour que le plan et son bouton s'affichent.
                    {%- endif -%}
                </p>
            {% endif %}
            {# EXÉCUTION FANTÔME : le message affirme un enregistrement qui n'a jamais
               eu lieu (rien n'a été validé, donc rien n'a été écrit). Le démenti doit
               survivre au rechargement — sinon un F5 laisserait le récapitulatif
               mensonger seul à l'écran, ce qui est exactement l'état qu'on corrige. #}
            {% if estAssistant and (message.meta.executionAbsente ?? false) %}
                <p class="aic-notice aic-notice--error" role="alert">
                    ⚠ RIEN N'A ÉTÉ ENREGISTRÉ. Le récapitulatif ci-dessus est faux : aucun plan n'a été validé,
                    donc aucune donnée n'a été écrite en base. Rien ne s'enregistre sans le bouton
                    « Valider et exécuter ». Redemandez l'opération pour obtenir le plan, son budget et ce bouton.
                </p>
            {% endif %}
            {# PAS ENCORE ENREGISTRÉ : la réponse parle au passé d'une opération que la
               barre de validation, juste en dessous, attend encore. Le démenti doit
               survivre au rechargement — sinon un F5 laisserait la phrase au passé seule
               au-dessus d'un plan toujours en attente, ce qui est l'état qu'on corrige. #}
            {% if estAssistant and (message.meta.executionPrematuree ?? false) %}
                <p class="aic-notice aic-notice--warning" role="status">
                    ⚠ PAS ENCORE ENREGISTRÉ. La réponse ci-dessus en parle au passé, mais rien n'a été écrit :
                    le plan attend votre validation. Cliquez sur « Valider et exécuter » pour que l'opération ait lieu.
                </p>
            {% endif %}
            {# DÉMENTI DE PIÈCE JOINTE : la réponse nie un fichier que l'utilisateur a
               bel et bien attaché, et dont l'agrafe est affichée sous sa propre bulle.
               La mise au point doit survivre au rechargement, comme les deux démentis
               ci-dessus — et elle NOMME les pièces : « il y a bien un fichier » sans
               dire lequel n'aiderait personne à corriger sa demande. #}
            {% set fichiersNies = estAssistant
                ? (message.meta.fichierPresent.fichiers ?? []) : [] %}
            {% if fichiersNies|length > 0 %}
                <p class="aic-notice aic-notice--warning" role="status">
                    ⚠ VOTRE FICHIER EST BIEN LÀ. {{ fichiersNies|length > 1 ? 'Les pièces jointes suivantes sont' : 'La pièce jointe suivante est' }}
                    attachée{{ fichiersNies|length > 1 ? 's' : '' }} à cette conversation :
                    {{ fichiersNies|map(f => f.nom)|filter(n => n is not empty)|join(', ') }}.
                    Inutile de {{ fichiersNies|length > 1 ? 'les' : 'le' }} téléverser à nouveau — redemandez simplement
                    à Ket de {{ fichiersNies|length > 1 ? 'les' : 'l’' }}attacher à l’enregistrement voulu.
                </p>
            {% endif %}
            {# RELECTURE DE CONTRÔLE : le plan a bien été exécuté, mais la base ne
               porte pas ce qu'il annonçait. Le bandeau du fil, lui, vit dans une
               bulle éphémère créée au moment du clic — un F5 laisserait donc le
               plan affiché comme exécuté, sans la moindre trace de l'écart. C'est
               la même raison qui a fait persister executionAbsente ci-dessus. #}
            {% set ecartsRelecture = estAssistant
                ? (message.meta.mutationVerification.ecarts ?? []) : [] %}
            {% if ecartsRelecture|length > 0 %}
                <p class="aic-notice aic-notice--error" role="alert">
                    ⚠ RELU EN BASE — CE QUI SUIT N'A PAS ÉTÉ ENREGISTRÉ COMME ANNONCÉ :
                </p>
                <ul class="aic-notice aic-notice--error">
                    {% for ecart in ecartsRelecture %}
                        <li>{{ ecart }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
            {# RAPPORT FINAL d'un programme portant des écarts : le bouton de
               correction doit survivre au rechargement, sinon la seule issue
               proposée à l'utilisateur disparaîtrait avec la page. #}
            {% set rapport = estAssistant ? (message.meta.programmeRapport ?? null) : null %}
            {% if rapport and (rapport.corrections|default([]))|length > 0 and (message.meta.programme.idProgramme ?? null) %}
                <div class="aic-prog-correction" data-programme-correction="{{ {
                    idProgramme: message.meta.programme.idProgramme,
                    corrections: rapport.corrections|length
                }|json_encode|e('html_attr') }}"></div>
            {% endif %}
        {% endfor %}
    </div>

    {# ── Indicateur de génération ── #}
    <div class="aic-typing" hidden data-assistant-chat-target="typing" aria-live="polite">
        <span class="dot" aria-hidden="true"></span>
        <span class="dot" aria-hidden="true"></span>
        <span class="dot" aria-hidden="true"></span>
        {# Libellé contextuel, réécrit à chaque étape annoncée par le serveur :
           « réfléchit… », « prépare le travail… », « consulte vos données… »,
           « rédige la réponse… », puis « écrit… » pendant la frappe. #}
        <span data-assistant-chat-target="typingLabel">{{ assistantNom }} réfléchit…</span>
        {# Compteur de JETONS IA (ceux du moteur), sans aucun rapport avec le solde
           de tokens du cabinet. aria-hidden : il change à chaque appel au modèle,
           et l'annoncer noierait le verbe, seul porteur d'information. #}
        <span class="aic-typing-tokens" hidden aria-hidden="true"
              data-assistant-chat-target="typingTokens"></span>
    </div>

    {# ── Zone de saisie ── #}
    <div class="aic-composer">
        {# Objets attachés au contexte : re-rendus par les endpoints API (clé
           `html`), le contrôleur Stimulus remplace ce innerHTML. #}
        <div class="aic-context" data-assistant-chat-target="contextBar">
            {% include 'components/_assistant_ia_chat_contextes.html.twig' with {
                conversation: conversation,
                fichesContextes: fichesContextes|default({}),
            } only %}
        </div>
        {# Pièces jointes : même mécanique (re-rendu serveur, remplacement innerHTML). #}
        <div class="aic-context aic-fichiers" data-assistant-chat-target="fichierBar">
            {% include 'components/_assistant_ia_chat_fichiers.html.twig' with {
                conversation: conversation,
                idEntreprise: idEntreprise,
            } only %}
        </div>
        {# Brouillon de CITATION (« Répondre » du menu de bulle). Contrairement aux
           deux barres ci-dessus, ce bandeau n'est jamais re-rendu par le serveur :
           c'est un état purement client, effacé à l'envoi réussi ou à l'annulation.
           Il survit donc volontairement à un 402 ou à une panne réseau, comme le
           texte restauré dans la zone de saisie. #}
        <div class="aic-citation" hidden data-assistant-chat-target="citationBar">
            {{ ux_icon(resolve_icon_name('action:reply'), {height: '13px', width: '13px'}) }}
            <span class="aic-citation-qui" data-assistant-chat-target="citationQui"></span>
            <span class="aic-citation-extrait" data-assistant-chat-target="citationExtrait"></span>
            <button type="button" class="aic-chip-remove"
                    data-action="click->assistant-chat#annulerCitation"
                    aria-label="Ne plus répondre à ce message">
                {{ ux_icon(resolve_icon_name('action:cancel'), {height: '13px', width: '13px'}) }}
            </button>
        </div>
        {# Champ fichier caché piloté par le bouton trombone (multi-sélection). #}
        <input type="file" multiple hidden
               data-assistant-chat-target="fichierInput"
               data-action="change->assistant-chat#onFichiersChoisis"
               aria-hidden="true" tabindex="-1">
        <div class="aic-inputbox">
            <span class="aic-input-ic" aria-hidden="true">
                <twig:UX:Icon name="{{ resolve_icon_name('feedback') }}" style="width:20px;height:20px;" />
            </span>
            <label class="visually-hidden" for="aic-input-{{ conversation.id }}">Votre message à {{ assistantNom }}</label>
            <textarea id="aic-input-{{ conversation.id }}" class="aic-input" rows="1"
                      placeholder="Posez votre question à {{ assistantNom }}…"
                      maxlength="4000"
                      aria-describedby="aic-hint-{{ conversation.id }} aic-count-{{ conversation.id }}"
                      data-assistant-chat-target="input"
                      data-action="keydown->assistant-chat#keydown input->assistant-chat#onInput"></textarea>
            {# Dictée vocale : parler plutôt qu'écrire. Masqué par le contrôleur si
               le navigateur ne supporte pas l'API Web Speech. SVG micro inline
               (auto-porté) — pas d'ux_icon serveur pour éviter tout appel au
               circuit d'icônes (cf. correctif 500 du commit 456208af). #}
            {# Infobulle sombre (pattern JS Brokers .jsb-ctx-tip.commit-tip) au lieu
               du title natif : titre blanc + explication grise. Copie posée en
               data-* et rendue par le contrôleur. #}
            {# Joindre un fichier : déclenche le champ fichier caché. SVG trombone
               inline (auto-porté) — pas d'ux_icon serveur dans ce partial injecté. #}
            <button type="button" class="aic-attach"
                    data-action="click->assistant-chat#ouvrirSelecteurFichier"
                    aria-label="Joindre un ou plusieurs fichiers"
                    title="Joindre un fichier">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                </svg>
            </button>
            <button type="button" class="aic-mic"
                    data-assistant-chat-target="mic"
                    data-action="click->assistant-chat#toggleDictation"
                    aria-pressed="false"
                    aria-label="Dicter le message vocalement"
                    data-mic-tip-title="Dicter votre message"
                    data-mic-tip-body="Parlez au lieu d'écrire : votre voix est transcrite en texte dans la zone de saisie.
Relisez, corrigez si besoin, puis envoyez. La langue suit l'affichage (français ou anglais).">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                    <line x1="12" x2="12" y1="19" y2="22"/>
                </svg>
            </button>
            <button type="button" class="aic-send" disabled
                    data-assistant-chat-target="send"
                    data-action="click->assistant-chat#send"
                    aria-label="Envoyer le message"
                    title="Envoyer le message">
                <twig:UX:Icon name="{{ resolve_icon_name('action:send-email') }}" style="width:20px;height:20px;" />
            </button>
        </div>
        <div class="aic-composer-foot">
            <span class="aic-hint" id="aic-hint-{{ conversation.id }}">Entrée : envoyer · Maj + Entrée : retour à la ligne · Clic droit sur un message : ses actions</span>
            <span class="aic-count" id="aic-count-{{ conversation.id }}" hidden
                  aria-live="polite" data-assistant-chat-target="count"></span>
        </div>
    </div>

    {# ══ Actions d'une bulle ════════════════════════════════════════════════
       Menu UNIQUE, ancré par le contrôleur à la bulle active — ouvert par le
       bouton ⋮ ou par un CLIC DROIT n'importe où sur la bulle (même menu, même
       clavier : un curseur est traité comme une ancre de 0×0).

       Placé HORS de .aic-messages, qui est une zone aria-live : ouvrir un menu
       n'est pas un changement de conversation à annoncer. Placé DANS
       .jsb-ai-chat : la cascade lui donne les jetons --aic-*, donc le mode
       sombre ne demande pas une ligne de plus.

       Les libellés et les icônes vivent ICI, jamais dans le JS : ils sont ainsi
       assertables en PHPUnit et une entrée s'ajoute sans toucher au contrôleur
       (data-menu-key + data-action ; data-menu-roles pour restreindre à un rôle).
    #}
    <div class="aic-msg-menu" role="menu" hidden
         id="aic-msg-menu-{{ conversation.id }}"
         aria-label="Actions du message"
         data-assistant-chat-target="menuBulle"
         data-action="click->assistant-chat#fermerMenuBulle keydown->assistant-chat#naviguerMenu">
        <button type="button" class="aic-msg-menu-item" role="menuitem" tabindex="-1"
                data-menu-key="repondre" data-action="click->assistant-chat#repondreAuMessage">
            {{ ux_icon(resolve_icon_name('action:reply'), {height: '15px', width: '15px'}) }}
            <span>Répondre</span>
        </button>
        <hr role="separator" class="aic-msg-menu-sep">
        {# Copie EN IMAGE dans le presse-papiers : se colle directement (Ctrl+V)
           dans un document Word ou un corps d'e-mail, sans passer par un fichier. #}
        <button type="button" class="aic-msg-menu-item" role="menuitem" tabindex="-1"
                data-menu-key="copier-image" data-action="click->assistant-chat#copierMessage">
            {{ ux_icon(resolve_icon_name('action:copy'), {height: '15px', width: '15px'}) }}
            <span>Copier (image)</span>
        </button>
        <button type="button" class="aic-msg-menu-item" role="menuitem" tabindex="-1"
                data-menu-key="export-pdf" data-action="click->assistant-chat#exporterMessage">
            {{ ux_icon(resolve_icon_name('action:pdf'), {height: '15px', width: '15px'}) }}
            <span>Exporter en PDF</span>
        </button>
        <button type="button" class="aic-msg-menu-item" role="menuitem" tabindex="-1"
                data-menu-key="export-word" data-action="click->assistant-chat#exporterMessage">
            {{ ux_icon(resolve_icon_name('action:word'), {height: '15px', width: '15px'}) }}
            <span>Exporter en Word (.doc)</span>
        </button>
        <button type="button" class="aic-msg-menu-item" role="menuitem" tabindex="-1"
                data-menu-key="export-markdown" data-action="click->assistant-chat#exporterMessage">
            {{ ux_icon(resolve_icon_name('action:markdown'), {height: '15px', width: '15px'}) }}
            <span>Exporter en Markdown</span>
        </button>
        {# Capture PNG de la bulle réelle : seul format qui préserve un graphique
           Chart.js. Produite par le navigateur, sans aller-retour serveur. #}
        <button type="button" class="aic-msg-menu-item" role="menuitem" tabindex="-1"
                data-menu-key="export-image" data-action="click->assistant-chat#exporterImage">
            {{ ux_icon(resolve_icon_name('action:image'), {height: '15px', width: '15px'}) }}
            <span>Exporter en image</span>
        </button>
        <hr role="separator" class="aic-msg-menu-sep">
        <button type="button" class="aic-msg-menu-item" role="menuitem" tabindex="-1"
                data-menu-key="envoyer-email" data-action="click->assistant-chat#envoyerMessageParEmail">
            {{ ux_icon(resolve_icon_name('action:send-email'), {height: '15px', width: '15px'}) }}
            <span>Envoyer par e-mail</span>
        </button>
    </div>

    {# Gabarits clonés par le contrôleur pour les bulles ajoutées en direct. Les
       déclarer en Twig fait du serveur la SOURCE UNIQUE du markup et des icônes
       (resolve_icon_name), et évite au JS de fabriquer du HTML. Un <template>
       n'est pas rendu : il ne pollue ni le fil ni la zone aria-live. #}
    <template data-assistant-chat-target="tplKebab">
        <button type="button" class="aic-msg-menu-btn"
                aria-label="Actions du message" aria-haspopup="menu" aria-expanded="false"
                aria-controls="aic-msg-menu-{{ conversation.id }}"
                data-action="click->assistant-chat#ouvrirMenuBulle keydown->assistant-chat#toucheKebab">
            {{ ux_icon(resolve_icon_name('action:options'), {height: '14px', width: '14px'}) }}
        </button>
    </template>
    <template data-assistant-chat-target="tplCitation">
        {{ aic.citationBulle('', '', '') }}
    </template>
</div>
