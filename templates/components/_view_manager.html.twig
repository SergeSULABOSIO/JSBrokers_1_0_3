{#
    Ce template est le conteneur principal pour l'affichage d'une "rubrique" (une liste d'entités).
    Il est piloté par le contrôleur Stimulus `view-manager` (anciennement `list-tabs`).

    Fonctionnement :
    - Le `view-manager` gère la navigation par onglets. L'onglet "Principal" affiche la liste principale.
    - Lorsqu'un élément de la liste principale est sélectionné, il peut créer dynamiquement de nouveaux onglets
      pour afficher les collections liées à cet élément (ex: les contacts d'un client).
    - Il orchestre l'affichage des composants enfants : barre d'outils, barre de recherche, barre de résumé, et la liste elle-même.
#}
<div 
    class="d-flex flex-column h-100"
    data-controller="view-manager"
    data-view-manager-id-entreprise-value="{{ idEntreprise }}"
    data-view-manager-id-invite-value="{{ idInvite }}"
    data-view-manager-server-root-name-value="{{ serverRootName }}"
    data-view-manager-entity-canvas-value='{{ entityCanvas|json_encode|e('html_attr') }}'
>
    {# ================================================================== #}
    {# SECTION 1 : PANNEAU SUPÉRIEUR FIXE (HEADER & OUTILS)             #}
    {# ================================================================== #}
    <div class="sticky-header bg-white shadow-sm">
        {# LE TITRE ET LES ONGLETS, UNE SEULE RANGÉE (refonte de la colonne 3, C5) : ils
           occupaient deux rangées (titre ≈ 56 px, onglets ≈ 45 px) au-dessus de la recherche —
           autant de lignes de données en moins. La rangée PORTE le bandeau (fond, filet bas) :
           il traverse toujours l'entête de bord à bord, le titre à gauche, les onglets à
           droite. La barre d'onglets garde sa largeur propre (le repli « +N » la mesure). #}
        <div class="jsb-entete-rubrique">
            <div class="jsb-entete-rubrique__titre">
                {# NOUVEAU : On utilise la fonction `resolve_icon_name` pour gérer les alias d'icônes #}
                <twig:UX:Icon
                    name="{{ resolve_icon_name(entityCanvas.parametres.icone | default('lucide:file-text')) }}"
                    class="rubrique-header-icon"
                    aria-hidden="true"
                />
                <h2 class="rubrique-title">
                    {{ entityCanvas.parametres.description | default('Rubrique') }}
                    {# Guidage : rappel de l'élément sélectionné dont les onglets
                       contextuels (collections) sont ouverts — rempli/masqué par
                       view-manager#_updateSelectionContext. #}
                    <span class="rubrique-context d-none" data-view-manager-target="selectionContext"></span>
                </h2>
            </div>

        {# DÉBORDEMENT : au-delà d'une dizaine d'onglets, la barre partait hors du cadre et
           n'offrait qu'une barre de défilement fine — les onglets hors champ étaient
           invisibles ET introuvables (Nielsen 6). Ceux qui ne tiennent pas sont repliés
           derrière « + N », qui les liste en surcouche. Le bandeau est le référent de
           positionnement de ce panneau. Les cibles Stimulus sont retrouvées n'importe où
           dans l'élément du contrôleur : la rangée commune ne change rien au JavaScript. #}
        <div class="list-tabs-wrapper jsb-onglets-barre" data-view-manager-target="tabsWrapper">
            <div class="list-tabs-container jsb-onglets-rangee"
                 role="tablist"
                 aria-label="Onglets de la rubrique {{ entite_nom }}"
                 data-view-manager-target="tabsContainer"
                 data-action="keydown->view-manager#handleTabKeydown"
            >
                <button class="list-tab jsb-onglet active" role="tab" id="tab-principal" aria-selected="true" aria-controls="panneau-principal" data-tab-id="principal" data-action="click->view-manager#switchTab">
                    {# Signifiance : l'onglet principal porte l'icône de l'entité de la
                       rubrique, comme les onglets de collection portent celle de leur
                       entité cible. Décorative (aria-hidden), le libellé reste le texte. #}
                    <span class="list-tab-icon jsb-onglet-icone" aria-hidden="true"><twig:UX:Icon name="{{ resolve_icon_name(entityCanvas.parametres.icone | default('lucide:file-text')) }}" /></span>
                    <span class="jsb-onglet-titre">Principal</span>
                </button>
            </div>

            {# Bouton de repli : masqué tant que tout tient. `aria-expanded` +
               `aria-controls` en font un vrai révélateur pour les lecteurs d'écran ;
               le compteur dit COMBIEN d'onglets sont cachés, pas seulement qu'il y en a. #}
            <button type="button"
                    class="list-tabs-more d-none"
                    data-view-manager-target="tabsMore"
                    data-action="click->view-manager#toggleTabsOverflow"
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls="list-tabs-overflow-panel">
                <span data-view-manager-target="tabsMoreCount">+0</span>
                <span class="visually-hidden">onglets supplémentaires</span>
                <twig:UX:Icon name="{{ resolve_icon_name('lucide:chevron-down') }}" class="list-tabs-more-chevron" aria-hidden="true" />
            </button>

            {# Panneau des onglets repliés. `role="list"` et non `menu` : ce sont des
               onglets, et ils restent dans le tablist du DOM — ce panneau n'est qu'un
               RACCOURCI vers eux, peuplé à l'ouverture par le contrôleur. #}
            <div id="list-tabs-overflow-panel"
                 class="list-tabs-overflow-panel d-none"
                 data-view-manager-target="tabsOverflowPanel"
                 role="list"
                 aria-label="Onglets repliés"></div>
        </div>
        </div>
        {# LA RECHERCHE, SEULE SUR SA RANGÉE (refonte de la colonne 3) : la barre d'outils
           est descendue en rail, à gauche de la liste (SECTION 2). #}
        <div class="p-2">
            {{ include('components/_search_bar.html.twig', {
                'entite_nom': entite_nom,
                'searchCanvas': searchCanvas,
                'autocomplete_url': path('app_espace_de_travail_component.api_search_autocomplete', {idInvite: idInvite, idEntreprise: idEntreprise})
            }) }}
        </div>
    </div>

    {# ================================================================== #}
    {# SECTION 2 : ZONE DE CONTENU DYNAMIQUE (LISTES)                     #}
    {# ================================================================== #}
    {# `overflow: auto` (et non overflow-y seul) : quand les colonnes numériques
       (nowrap) rendent le tableau plus large que le panneau, le défilement
       horizontal doit se faire ICI — sur le même conteneur que le défilement
       vertical — pour que l'entête sticky du tableau garde son ancrage
       (`position: sticky` s'accroche au plus proche ancêtre défilant).

       LA ZONE DE LA LISTE porte le RAIL d'outils, posé à gauche par-dessus la colonne que
       chaque liste lui réserve (`--jsb-rail-w`), et s'arrêtant au-dessus de la barre du bas
       (`--jsb-barre-bas-h`). Une seule barre d'outils pour tous les onglets de la rubrique,
       comme avant. #}
    <div class="jsb-zone-liste">
    {{ include("components/_toolbar.html.twig") }}
    <div class="flex-grow-1" style="overflow: auto; min-height: 0;" data-view-manager-target="tabContentContainer">
        <div
            {# `principal` est l'id de la LISTE (clé de routage du cerveau) ; le panneau en
               porte un autre, sans quoi l'identifiant figurait deux fois dans la page. Le
               view-manager le retrouve par `data-panneau-onglet`. #}
            id="panneau-principal"
            data-panneau-onglet="principal"
            role="tabpanel"
            aria-labelledby="tab-principal"
            tabindex="0"
            data-entity-name="{{ entite_nom }}"
            data-server-root-name="{{ serverRootName }}"
            data-can-add="true"
        >
            {# Bouton « Ajouter » de l'état vide : même drapeau que la barre d'outils et le
               menu contextuel (`creation_interdite`), pour qu'une rubrique fermée à la
               création ne l'offre pas par une troisième porte. Le repli sur {} est
               nécessaire : `entityFormCanvas` peut arriver vide, et l'accès en chaîne
               lèverait avant que `default` n'ait son mot à dire. #}
            {% set peutAjouter = (entityFormCanvas.parametres|default({})).creation_interdite|default(false) != true %}
            {# On utilise notre nouveau composant générique pour la liste principale #}
            {{ include('components/_list_manager.html.twig', {
                'listId': 'principal',
                'can_add': peutAjouter,
                'data': data,
                'entite_nom': entite_nom,
                'serverRootName': serverRootName,
                'entityCanvas': entityCanvas,
                'listeCanvas': listeCanvas,
                'entityFormCanvas': entityFormCanvas,
                'numericAttributesAndValues': numericAttributesAndValues,
                'idEntreprise': idEntreprise,
                'idInvite': idInvite,
                'listUrl': mainListUrl,
                'paginationMeta': paginationMeta,
                'initialSearchCriteria': initialSearchCriteria|default([]),
                'criteresImposes': criteresImposes|default([]),
                'etatVide': etatVide|default(null)
            }) }}
        </div>

        {# ================================================================== #}
        {# SECTION 3 : MODÈLE POUR LES ONGLETS DE COLLECTION (CONTEXTUELS)    #}
        {# ================================================================== #}
        <template data-view-manager-target="collectionTabTemplate">
            <div 
                id="" {# L'ID sera défini dynamiquement par le contrôleur #}
                data-entity-name="" {# Défini dynamiquement #}
                data-server-root-name="{{ serverRootName }}" 
                data-can-add="true"
                class="h-100"
            >
                {# Le contenu (le composant _list_manager) sera chargé ici de manière asynchrone
                   par le contrôleur Stimulus lors du changement d'onglet.
                   Cela évite de charger toutes les collections en même temps. #}
            </div>
        </template>
    </div>
    </div>
    {{ include('components/_context_menu.html.twig') }}
    {# Le dialogue de recherche est inclus ici pour être à la racine et éviter les problèmes de z-index #}
    {{ include('components/_search_bar_dialog.html.twig') }}
</div>