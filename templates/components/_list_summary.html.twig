<div
    data-controller="list-summary"
    data-list-summary-indisponible-value="indisponible"
    data-list-summary-indisponible-note-value="Le total de la sélection n'a pas pu être calculé (connexion ou serveur). Il sera recalculé à la prochaine sélection."
    class="jsb-list-summary"
    role="region"
    aria-label="Totaux de la liste"
>
    <label class="jsb-list-summary__label" aria-hidden="true">Totaliser :</label>
    <select
        class="jsb-list-summary__select"
        aria-label="Choisir l'attribut à totaliser"
        data-action="list-summary#recalculate"
        data-list-summary-target="attributeSelector"
    >
        <option value="">-- Choisir --</option>
    </select>
    <span class="jsb-list-summary__divider" aria-hidden="true"></span>
    {# « TOTAL DE LA PAGE », et non « Total » : la somme porte sur les lignes AFFICHÉES
       (vingt au plus), pas sur tout le filtre. Lu à côté de « 1–20 sur 42 », un simple
       « Total » se prenait pour celui des 42 — un chiffre faux qu'on croit juste. #}
    <span class="jsb-list-summary__item"
          title="Somme des lignes affichées sur cette page — les autres pages n'y sont pas comptées.">
        <span class="jsb-list-summary__item-label">Total de la page</span>
        <span class="jsb-list-summary__item-value"
            data-list-summary-target="globalTotal"
            aria-live="polite"
            aria-atomic="true">—</span>
    </span>
    <span class="jsb-list-summary__divider" aria-hidden="true"></span>
    <span class="jsb-list-summary__item">
        <span class="jsb-list-summary__item-label">Sélection</span>
        <span class="jsb-list-summary__item-value"
            data-list-summary-target="selectionTotal"
            aria-live="polite"
            aria-atomic="true">—</span>
    </span>
</div>
