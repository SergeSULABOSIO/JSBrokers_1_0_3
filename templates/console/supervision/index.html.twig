{% extends 'console/base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Barre de filtres : reprise à l'identique de console/vente/index.html.twig
       pour que toutes les listes de la Console se manipulent pareil. */
    .cs-filterbar { display: grid; grid-template-columns: repeat(auto-fit, minmax(185px, 1fr)); gap: .85rem 1rem; align-items: end; }
    .cs-filterbar .cs-filter { display: flex; flex-direction: column; min-width: 0; }
    .cs-filterbar .form-label { margin: 0 0 .35rem; font-size: .8rem; font-weight: 600; color: #6c757d;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cs-filterbar .cs-filter-actions { grid-column: 1 / -1; flex-direction: row; justify-content: flex-end; gap: .5rem; }
    .cs-filterbar .cs-filter-actions .btn { display: inline-flex; align-items: center; white-space: nowrap; }

    /* Le compteur d'occurrences est la colonne qui HIÉRARCHISE : chiffres à
       chasse fixe pour que les ordres de grandeur s'alignent verticalement et
       se comparent d'un coup d'œil, sans lire les nombres. */
    .cs-occ { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 1.05rem; }
    .cs-occ--fort { color: #b3261e; }

    /* Le lieu dans le code : long par nature, il ne doit pas élargir le tableau. */
    .cs-lieu { font-size: .76rem; color: #6c757d; word-break: break-all; }
    .cs-msg { max-width: 420px; }
    .cs-msg code { font-size: .78rem; }
</style>
{% endblock %}

{% block console_subtitle %}<p>Un défaut = une ligne, avec le nombre de fois qu'il s'est produit. Le compteur donne l'ampleur ; c'est lui qui dit par quoi commencer.</p>{% endblock %}

{% block console_body %}
    {# ── Ce que montre le périmètre filtré ── #}
    <div class="cs-kpis" style="margin-bottom:1.25rem;">
        <div class="cs-kpi"><span class="cs-kpi-icon" aria-hidden="true">{{ ux_icon(resolve_icon_name('action:alert'), {height:'24px', width:'24px'}) }}</span>
            <span class="cs-kpi-body"><span class="cs-kpi-val">{{ totaux.defauts }}</span><span class="cs-kpi-lbl">Défauts distincts</span></span></div>
        <div class="cs-kpi"><span class="cs-kpi-icon" aria-hidden="true">{{ ux_icon(resolve_icon_name('tache'), {height:'24px', width:'24px'}) }}</span>
            <span class="cs-kpi-body"><span class="cs-kpi-val">{{ totaux.ouverts }}</span><span class="cs-kpi-lbl">À traiter</span></span></div>
        <div class="cs-kpi"><span class="cs-kpi-icon" aria-hidden="true">{{ ux_icon(resolve_icon_name('action:analyser'), {height:'24px', width:'24px'}) }}</span>
            <span class="cs-kpi-body"><span class="cs-kpi-val">{{ totaux.occurrences|number_format(0, ',', ' ') }}</span><span class="cs-kpi-lbl">Occurrences cumulées</span></span></div>
        <div class="cs-kpi"><span class="cs-kpi-icon" aria-hidden="true">{{ ux_icon(resolve_icon_name('action:calendar'), {height:'24px', width:'24px'}) }}</span>
            <span class="cs-kpi-body"><span class="cs-kpi-val">{{ totaux.occurrences24h }}</span><span class="cs-kpi-lbl">Actifs sur 24 h</span></span></div>
    </div>

    {# ── Filtres (formulaire GET, sans JS) ── #}
    <div class="cs-panel" style="margin-bottom:1.25rem;">
        <form method="get" data-action="submit->top-progress#show" class="cs-filterbar">
            <div class="cs-filter"><label class="form-label" for="f-cote">Côté</label>
                <div class="cs-field">
                    <span class="cs-field-icon">{{ ux_icon(resolve_icon_name('action:filter'), {height:'18px', width:'18px'}) }}</span>
                    <select id="f-cote" name="cote" class="form-select">
                        <option value="">Tous</option>
                        {% for c in cotes %}<option value="{{ c }}" {{ filtres.cote == c ? 'selected' }}>{{ ('supervision_cote.' ~ c)|trans }}</option>{% endfor %}
                    </select>
                </div>
            </div>
            <div class="cs-filter"><label class="form-label" for="f-branche">Branche</label>
                <div class="cs-field">
                    <span class="cs-field-icon">{{ ux_icon(resolve_icon_name('dashboard'), {height:'18px', width:'18px'}) }}</span>
                    <select id="f-branche" name="branche" class="form-select">
                        <option value="">Toutes</option>
                        {% for b in branches %}<option value="{{ b }}" {{ filtres.branche == b ? 'selected' }}>{{ ('supervision_branche.' ~ b)|trans }}</option>{% endfor %}
                    </select>
                </div>
            </div>
            <div class="cs-filter"><label class="form-label" for="f-statut">Statut</label>
                <div class="cs-field">
                    <span class="cs-field-icon">{{ ux_icon(resolve_icon_name('action:filter'), {height:'18px', width:'18px'}) }}</span>
                    <select id="f-statut" name="statut" class="form-select">
                        <option value="">Tous</option>
                        {% for s in statuts %}<option value="{{ s }}" {{ filtres.statut == s ? 'selected' }}>{{ ('supervision_statut.' ~ s)|trans }}</option>{% endfor %}
                    </select>
                </div>
            </div>
            <div class="cs-filter"><label class="form-label" for="f-q" title="Recherche (message, type, fichier)">Recherche</label>
                <div class="cs-field">
                    <span class="cs-field-icon">{{ ux_icon(resolve_icon_name('action:search'), {height:'18px', width:'18px'}) }}</span>
                    <input id="f-q" type="text" name="q" value="{{ filtres.q }}" class="form-control" placeholder="Message, type, fichier…">
                </div>
            </div>
            <div class="cs-filter cs-filter-actions">
                <button type="submit" class="btn btn-cobalt">{{ ux_icon(resolve_icon_name('action:filter'), {height:'18px', width:'18px'}) }}<span class="ms-1">Filtrer</span></button>
                <a href="{{ path('console.supervision.index') }}" class="btn btn-outline-secondary" data-action="click->top-progress#show">Réinitialiser</a>
            </div>
        </form>
    </div>

    {# ── La liste ──
       Triée par dernière occurrence, et NON par nombre : un défaut massif mais
       ancien, corrigé depuis, occuperait sinon la première ligne pour toujours.
       Ce qui vient de se produire passe devant ; l'ampleur se lit en colonne. #}
    <div class="cs-panel">
        {% if erreurs.getTotalItemCount > 0 %}
            {% set badgeStatut = {
                'nouvelle': 'cs-badge--danger',
                'en_cours': 'cs-badge--warn',
                'resolue':  'cs-badge--ok',
                'ignoree':  'cs-badge--muted'
            } %}
            <table class="cs-table">
                <thead><tr>
                    <th>Dernière fois</th><th>Source</th><th>Défaut</th><th>Lieu</th>
                    <th>Occurrences</th><th>Statut</th><th>Pris par</th>
                </tr></thead>
                <tbody>
                {% for e in erreurs %}
                    <tr data-cm-row>
                        <td>
                            {{ e.derniereOccurrenceAt|format_datetime('medium', 'short', locale: app.user.locale) }}
                            <br><small style="color:#6c757d;">depuis le {{ e.premiereOccurrenceAt|format_datetime('short', 'none', locale: app.user.locale) }}</small>
                        </td>
                        <td>
                            {# Les deux axes de source, côte à côte : le langage où
                               chercher, et qui est touché. #}
                            <span class="cs-badge {{ e.cote == 'serveur' ? 'cs-badge--cobalt' : 'cs-badge--muted' }}">{{ ('supervision_cote.' ~ e.cote)|trans }}</span>
                            <br><span class="cs-badge cs-badge--muted" style="margin-top:.25rem;">{{ ('supervision_branche.' ~ e.branche)|trans }}</span>
                        </td>
                        <td class="cs-msg">
                            <strong>{{ e.type }}</strong>
                            <br><span style="color:#6c757d;">{{ e.message|length > 140 ? e.message|slice(0, 139) ~ '…' : e.message }}</span>
                        </td>
                        <td class="cs-lieu">
                            {% if e.fichier %}{{ e.fichier }}{% if e.ligne %}:{{ e.ligne }}{% endif %}{% else %}—{% endif %}
                        </td>
                        <td>
                            {# Au-delà de dix, le défaut a franchi son premier palier
                               d'aggravation : il a déjà fait l'objet d'un e-mail. #}
                            <span class="cs-occ {{ e.nombreOccurrences >= 10 ? 'cs-occ--fort' }}">{{ e.nombreOccurrences|number_format(0, ',', ' ') }}</span>
                        </td>
                        <td><span class="cs-badge {{ badgeStatut[e.statut]|default('cs-badge--muted') }}">{{ ('supervision_statut.' ~ e.statut)|trans }}</span></td>
                        <td>{{ e.assigneA ? e.assigneA.nom : '—' }}</td>

                        {# Cellule masquée : la Console n'a pas de colonne « Actions »,
                           tout passe par le menu contextuel au clic droit, qui reflète
                           ces éléments (console-context-menu_controller.js). #}
                        <td hidden data-cm-actions>
                            <div style="display:inline-flex; gap:.4rem; align-items:center; flex-wrap:wrap;">
                                <a href="{{ path('console.supervision.detail', {id: e.id}) }}"
                                   class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center"
                                   data-action="click->top-progress#show">
                                    {{ ux_icon(resolve_icon_name('action:analyser'), {height:'16px', width:'16px'}) }}
                                    <span class="ms-1">Voir la trace</span>
                                </a>

                                {% if e.statut != 'en_cours' %}
                                    {{ include('console/supervision/_action_statut.html.twig', {
                                        erreur: e, statut: 'en_cours', libelle: 'Prendre en charge', icone: 'tache'
                                    }, with_context: false) }}
                                {% endif %}
                                {% if e.statut != 'resolue' %}
                                    {{ include('console/supervision/_action_statut.html.twig', {
                                        erreur: e, statut: 'resolue', libelle: 'Marquer résolue', icone: 'action:completed'
                                    }, with_context: false) }}
                                {% endif %}
                                {% if e.statut != 'ignoree' %}
                                    {{ include('console/supervision/_action_statut.html.twig', {
                                        erreur: e, statut: 'ignoree', libelle: 'Ignorer', icone: 'action:cancel'
                                    }, with_context: false) }}
                                {% endif %}
                                {% if e.statut != 'nouvelle' %}
                                    {{ include('console/supervision/_action_statut.html.twig', {
                                        erreur: e, statut: 'nouvelle', libelle: 'Rouvrir', icone: 'action:reset'
                                    }, with_context: false) }}
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <div class="cs-pagination">{{ knp_pagination_render(erreurs) }}</div>
        {% else %}
            <div class="cs-empty">
                {% if filtres.cote or filtres.branche or filtres.statut or filtres.q %}
                    Aucun défaut pour ces critères.
                {% else %}
                    Aucune erreur enregistrée. C'est la bonne nouvelle — mais vérifiez-la une fois par déploiement plutôt que de la supposer.
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
