{% extends 'console/base.html.twig' %}

{# Réglages de Ket — inventaire en lecture seule.

   AUCUN STYLE NOUVEAU N'EST INVENTÉ ICI : .cs-panel, .cs-table, .cs-badge et
   .cs-empty viennent de console/base.html.twig, comme sur toutes les autres
   rubriques. Seules les quelques règles ci-dessous sont propres à cet écran, et
   elles n'ajoutent aucune couleur hors charte.

   LA FICHE DE DÉTAIL EST UN <details>, PAS UN PANNEAU JAVASCRIPT. L'état est alors
   exposé nativement aux technologies d'assistance, le clavier fonctionne sans qu'on
   écrive une ligne, et rien ne se casse si le script ne charge pas. C'est le même
   choix que la navigation de la console (cf. _nav.html.twig). #}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Une ligne d'outil : mêmes proportions qu'un <tr>, mais dépliable. */
    .kr-row { border-bottom: 1px solid #f0f0f0; }
    .kr-row[open] { background: #f8f9fa; }
    .kr-row > summary {
        display: grid;
        grid-template-columns: 2.4rem 1fr 9rem 8rem 7rem;
        gap: .75rem; align-items: center;
        /* 44px minimum de zone cliquable (WCAG 2.5.5) : .7rem de part et d'autre
           d'une ligne de texte y suffisent, la hauteur minimale le garantit. */
        padding: .7rem; min-height: 44px;
        cursor: pointer; list-style: none;
    }
    .kr-row > summary::-webkit-details-marker { display: none; }
    .kr-row > summary:hover { background: #f8f9fa; }
    .kr-row > summary:focus-visible { outline: 2px solid #0047AB; outline-offset: -2px; }
    /* Pastille : même langage visuel que .cs-head-icon des entêtes de console
       (fond cobalt très clair, glyphe cobalt), en plus petit pour une ligne de
       liste. Décorative : aria-hidden, car le libellé juste à côté dit déjà tout —
       une icône annoncée deux fois est du bruit au lecteur d'écran. */
    .kr-pastille {
        flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
        width: 34px; height: 34px; border-radius: 9px;
        background: #e8f0fb; color: #0047AB;
    }
    .kr-pastille svg { width: 19px; height: 19px; }

    .kr-nom { min-width: 0; }
    .kr-nom strong { display: block; color: #212529; font-size: .93rem; }
    .kr-nom span { display: block; color: #6c757d; font-size: .82rem; margin-top: .1rem; }
    .kr-tech { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .78rem; color: #6c757d; }
    .kr-poids { color: #495057; font-size: .85rem; text-align: right; }
    .kr-etat { display: inline-flex; align-items: center; gap: .3rem; font-size: .82rem; color: #6c757d; }
    .kr-etat svg { width: 15px; height: 15px; flex: 0 0 auto; }

    /* Le corps de la fiche. */
    .kr-fiche { padding: .25rem .7rem 1.1rem; }
    .kr-fiche dl { display: grid; grid-template-columns: 11rem 1fr; gap: .45rem .9rem; margin: 0; }
    .kr-fiche dt { color: #6c757d; font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; font-weight: 700; }
    .kr-fiche dd { margin: 0; color: #495057; font-size: .88rem; }
    .kr-fiche dd code { font-size: .8rem; color: #495057; }
    .kr-prose { white-space: pre-line; }

    /* En-tête chiffré : ce que la plateforme envoie au maximum, par trousse. */
    .kr-mesures { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
    .kr-mesure { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 10px; padding: .85rem 1rem; }
    .kr-mesure dt { color: #6c757d; font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; font-weight: 700; }
    .kr-mesure dd { margin: .3rem 0 0; color: #0047AB; font-size: 1.25rem; font-weight: 700; }
    .kr-mesure p { margin: .2rem 0 0; color: #6c757d; font-size: .8rem; }

    /* Encart d'accès : cobalt très clair, le ton « information » de la charte. */
    .kr-acces { background: #e8f0fb; border: 1px solid #dee2e6; border-radius: 12px; padding: 1rem 1.15rem; margin-bottom: 1.25rem; }
    .kr-acces h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; color: #0047AB; margin: 0 0 .4rem; }
    /* LE TEXTE OCCUPE SA LARGEUR. Un plafond de 80ch coupait les lignes vers 500 px
       dans un panneau de 960 : le vide à droite se lisait comme un défaut de mise en
       page, pas comme un confort de lecture. Le PANNEAU est désormais la mesure, ce
       qui est déjà le cas des autres textes de la console (Cohérence, Bastien &
       Scapin). Le texte reste aligné à gauche : `text-align: justify` creuse des
       rivières d'espaces et pénalise les lecteurs dyslexiques — WCAG 1.4.8, et
       Opquast le déconseille également. */
    .kr-acces p { margin: 0 0 .35rem; color: #495057; font-size: .88rem; }
    .kr-acces p:last-child { margin-bottom: 0; }
    .kr-acces strong { color: #212529; }

    /* ONGLETS — LE PATTERN DE L'ESPACE DE TRAVAIL, sans la croix de fermeture.
       Repris de `.workspace-tab-*` (assets/styles/interactive-menu.css) : rangée
       posée sur un fond clair, onglets à coins arrondis en haut, actif en BLANC
       coiffé d'un liseré cobalt. C'est la grammaire d'onglets que l'utilisateur
       connaît déjà — en donner une seconde, différente, dans la même application,
       lui demanderait de réapprendre ce qu'il sait faire.

       Les valeurs sont écrites en clair plutôt qu'en variables : la console ne
       charge pas `interactive-menu.css`, et un `var(--bg-muted)` non résolu rendrait
       un onglet transparent. Ce sont les teintes de la charte, à une exception
       assumée — #d0d5dd, le survol, qui vient de la barre d'origine et n'existe que
       là : la reprendre garde les deux barres identiques.

       Ces onglets ne se ferment PAS : ce sont des sections d'un même écran, pas des
       rubriques qu'on ouvre et qu'on quitte. Pas de croix, donc, et pas de bouton
       « + N » : à six, la rangée tient sans déborder.

       LA BARRE ET LE CORPS NE FONT QU'UN BLOC. Séparés, ils se lisaient comme deux
       cartes sans rapport : une rangée de boutons flottant au-dessus d'un panneau.
       La barre n'a donc pas de bordure basse et pas de marge — c'est le panneau
       juste dessous qui la referme, et l'onglet actif (blanc, sans bord bas) s'y
       fond exactement comme dans l'espace de travail. */
    .kr-tab-bar {
        display: flex; flex-wrap: wrap; align-items: flex-end; gap: 2px;
        background: #f8f9fa; border: 1px solid #dee2e6; border-bottom: 0;
        border-radius: 12px 12px 0 0; padding: 6px 8px 0; margin-bottom: 0;
    }
    .kr-tab {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px 7px; min-height: 44px;
        background: #e9ecef; border: 1px solid transparent; border-bottom: none;
        border-radius: 8px 8px 0 0;
        font-family: inherit; font-size: .82rem; color: #6c757d;
        white-space: nowrap; cursor: pointer; user-select: none;
        transition: background-color .15s ease, color .15s ease, box-shadow .15s ease;
    }
    .kr-tab:hover { background: #d0d5dd; color: #343a40; }
    .kr-tab:focus-visible { outline: none; box-shadow: 0 0 0 2px rgba(0, 71, 171, .35); }
    /* Actif : FOND, LISERÉ et GRAISSE — jamais la couleur seule (WCAG 1.4.1). */
    .kr-tab.is-active {
        background: #ffffff; border-color: #dee2e6; color: #0047AB; font-weight: 600;
        box-shadow: inset 0 2px 0 0 #0047AB;
    }
    .kr-tab-icone { display: inline-flex; align-items: center; flex-shrink: 0; }
    .kr-tab-icone svg { width: 15px; height: 15px; }
    .kr-tab-compte {
        font-weight: 700; font-variant-numeric: tabular-nums; opacity: .7;
        font-size: .78rem;
    }
    .kr-pane { display: none; }
    .kr-pane.is-active { display: block; }
    /* Le premier panneau du volet CONTINUE la barre : coins hauts carrés, pas de
       bord haut. Les panneaux suivants (le volet des fournisseurs en a deux)
       gardent leur forme de carte. */
    .kr-pane > .cs-panel:first-child {
        border-top-left-radius: 0; border-top-right-radius: 0; border-top: 0;
    }

    /* ── BARRE DE FILTRE ──────────────────────────────────────────────────
       CE QUI N'ALLAIT PAS. Des contrôles posés à nu sur le fond de la carte, de
       hauteurs différentes, un bouton plein collé à un lien nu : rien ne disait que
       ces quatre éléments forment UN outil. Et rien ne disait non plus, avant de
       cliquer, que « Filtrer » recharge la page.

       CE QUI LE REMPLACE. Un bandeau qui les GROUPE (Bastien & Scapin > Groupement
       par la localisation), des contrôles à la même hauteur (48 px, cible confortable
       — WCAG 2.5.5 en demande 44), et une loupe DANS le champ : l'icône dit à quoi
       sert la zone avant qu'on ait lu son libellé. « Tout afficher » devient un
       bouton secondaire, parce que c'en est un — un lien nu se lit comme une
       navigation, alors qu'il agit sur la liste. */
    .kr-filtres {
        display: flex; flex-wrap: wrap; gap: .75rem 1rem; align-items: flex-end;
        background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 10px;
        padding: .9rem 1rem; margin: 0 0 1.1rem;
    }
    .kr-filtre-champ { display: flex; flex-direction: column; min-width: 0; }
    .kr-filtre-champ--large { flex: 1 1 20rem; }
    .kr-filtres label {
        font-size: .78rem; font-weight: 600; color: #6c757d; margin-bottom: .3rem;
    }
    .kr-filtres select,
    .kr-filtres input[type="search"] {
        height: 48px; padding: .4rem .7rem; border: 1px solid #ced4da; border-radius: 8px;
        background: #fff; color: #212529; font-size: .95rem; font-family: inherit;
    }
    .kr-filtres select { min-width: 12rem; }
    .kr-filtres select:focus,
    .kr-filtres input[type="search"]:focus {
        outline: 0; border-color: #0047AB; box-shadow: 0 0 0 .25rem rgba(0, 71, 171, .35);
    }
    /* La loupe vit DANS le champ : décorative, donc aria-hidden — le libellé et le
       placeholder portent déjà le sens. */
    .kr-champ-loupe { position: relative; display: flex; }
    .kr-champ-loupe input[type="search"] { width: 100%; padding-left: 2.4rem; }
    .kr-champ-loupe svg {
        position: absolute; left: .75rem; top: 50%; transform: translateY(-50%);
        width: 17px; height: 17px; color: #6c757d; pointer-events: none;
    }
    .kr-filtre-actions { display: flex; gap: .5rem; align-items: center; }
    .kr-filtres .kr-btn { height: 48px; }
    /* Bouton SECONDAIRE : même forme, même hauteur, poids visuel moindre — la
       hiérarchie des deux actions se voit sans les lire. */
    .kr-btn--secondaire {
        display: inline-flex; align-items: center; height: 48px; padding: 0 1rem;
        background: #fff; border: 1px solid #ced4da; border-radius: 8px;
        color: #495057; font-weight: 600; font-size: .9rem; text-decoration: none;
        transition: background-color .12s ease, border-color .12s ease, color .12s ease;
    }
    .kr-btn--secondaire:hover { background: #e9ecef; border-color: #adb5bd; color: #212529; }
    .kr-btn--secondaire:focus-visible {
        outline: none; box-shadow: 0 0 0 .25rem rgba(0, 71, 171, .35);
    }

    .kr-compte { color: #6c757d; font-size: .85rem; margin: 0 0 .5rem; }

    /* Interrupteur : une case à cocher NATIVE, redessinée. Le clavier, le focus et
       l'annonce au lecteur d'écran fonctionnent alors sans une ligne de script, et
       le libellé texte à côté dit l'état — jamais la couleur seule (WCAG 1.4.1). */
    .kr-switch { display: inline-flex; align-items: center; gap: .45rem; cursor: pointer; }
    .kr-switch input { position: absolute; opacity: 0; width: 0; height: 0; }
    .kr-switch-piste {
        width: 38px; height: 22px; border-radius: 999px; background: #adb5bd;
        position: relative; transition: background .15s ease; flex: 0 0 auto;
    }
    .kr-switch-piste::after {
        content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px;
        border-radius: 50%; background: #fff; transition: transform .15s ease;
    }
    .kr-switch input:checked + .kr-switch-piste { background: #198754; }
    .kr-switch input:checked + .kr-switch-piste::after { transform: translateX(16px); }
    .kr-switch input:focus-visible + .kr-switch-piste { box-shadow: 0 0 0 .2rem rgba(0, 71, 171, .35); }

    /* Formulaire de bascule : caché tant qu'on n'a pas déplié la fiche. */
    .kr-agir { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #dee2e6; }
    .kr-agir h3 { font-size: .8rem; text-transform: uppercase; letter-spacing: .03em; color: #6c757d; margin: 0 0 .6rem; font-weight: 700; }
    .kr-impact { background: #fff3cd; border: 1px solid #dee2e6; border-radius: 8px; padding: .7rem .85rem; margin-bottom: .75rem; }
    .kr-impact p { margin: 0 0 .25rem; color: #664d03; font-size: .85rem; }
    .kr-impact p:last-child { margin-bottom: 0; }
    .kr-agir label { display: block; font-size: .8rem; color: #6c757d; margin-bottom: .25rem; }
    .kr-agir textarea, .kr-agir input[type="number"] {
        width: 100%; max-width: 46rem; min-height: 44px; padding: .5rem .65rem;
        border: 1px solid #ced4da; border-radius: 8px; color: #212529; font-size: .9rem; font-family: inherit;
    }
    .kr-agir input[type="number"] { max-width: 9rem; }
    .kr-agir textarea:focus, .kr-agir input:focus {
        outline: 0; border-color: #0047AB; box-shadow: 0 0 0 .2rem rgba(0, 71, 171, .35);
    }
    .kr-agir .kr-boutons { margin-top: .75rem; display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }
    .kr-btn {
        min-height: 44px; padding: .5rem 1.1rem; border: 0; border-radius: 8px;
        background: #0047AB; color: #fff; font-weight: 600; cursor: pointer; font-size: .9rem;
    }
    .kr-btn:hover { background: #003380; }
    .kr-btn--danger { background: #dc3545; }
    .kr-btn--danger:hover { background: #b02a37; }

    /* ── SEUILS MÉTIER ────────────────────────────────────────────────────
       CE QUI N'ALLAIT PAS. Quatre formulaires côte à côte, chacun avec son motif et
       son bouton : le même geste demandé quatre fois. Et les champs numériques
       n'avaient AUCUN style — la règle ne visait que `.kr-agir` —, si bien qu'un
       « 30 » nu flottait entre deux libellés, sans cadre ni hauteur. On ne voyait
       plus qu'il était saisissable.

       CE QUI LE REMPLACE. Un tableau de description : à gauche le seuil et ce qu'il
       fait, à droite sa valeur et ses bornes, toutes alignées sur la même colonne —
       l'œil descend une seule ligne verticale au lieu de chercher quatre fois
       (Bastien & Scapin > Groupement par la localisation). Puis UN motif et UN
       bouton : celui qui déplace deux seuils le fait pour une seule raison. */
    .kr-seuil {
        display: grid; grid-template-columns: 1fr 13rem;
        gap: .35rem 1.5rem; align-items: start;
        padding: 1rem .75rem; border-bottom: 1px solid #f0f0f0; border-radius: 6px;
        transition: background-color .12s ease;
    }
    .kr-seuil:last-of-type { border-bottom: 0; }
    /* LA LIGNE SURVOLÉE SE DÉTACHE. Quatre seuils alignés se ressemblent : sans
       retour au survol, on ne sait pas laquelle des quatre bornes appartient au champ
       qu'on vise, et l'on corrige la mauvaise (Bastien & Scapin > Guidage).
       Le même fond répond au CLAVIER (`:focus-within`) : un retour réservé à la
       souris laisse le reste des utilisateurs sans repère. La teinte est celle du
       survol des tableaux de la console — on ne réinvente pas un signal qui existe. */
    .kr-seuil:hover,
    .kr-seuil:focus-within { background: #f8f9fa; }
    .kr-seuil-label {
        grid-column: 1; margin: 0; font-size: .95rem; font-weight: 600; color: #212529;
    }
    .kr-seuil-aide { grid-column: 1; margin: 0; color: #6c757d; font-size: .85rem; }
    .kr-seuil-champ { grid-column: 2; grid-row: 1 / span 2; }
    .kr-seuil-saisie { display: flex; align-items: center; gap: .5rem; }
    .kr-seuil-saisie input {
        width: 5.5rem; height: 48px; padding: .4rem .65rem; text-align: right;
        border: 1px solid #ced4da; border-radius: 8px;
        background: #fff; color: #000; font-size: 1rem; font-family: inherit;
        font-variant-numeric: tabular-nums;
    }
    .kr-seuil-saisie input:focus {
        outline: 0; border-color: #0047AB; box-shadow: 0 0 0 .25rem rgba(0, 71, 171, .35);
    }
    .kr-seuil-unite { color: #495057; font-size: .88rem; }
    .kr-bornes { margin: .3rem 0 0; color: #6c757d; font-size: .78rem; }
    .kr-modifie {
        display: inline-block; margin-left: .4rem; padding: .05rem .45rem;
        border-radius: 999px; background: #fff3cd; color: #664d03;
        font-size: .7rem; font-weight: 700; vertical-align: middle;
    }
    /* Le motif et le bouton closent la liste, séparés par un trait : ils portent sur
       TOUT ce qui précède, et cela doit se voir avant de cliquer. */
    .kr-seuil-pied { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid #dee2e6; }
    .kr-seuil-pied label { display: block; font-size: .8rem; color: #6c757d; margin-bottom: .3rem; }
    .kr-seuil-pied .kr-seuil-pied-ligne { display: flex; gap: .75rem; align-items: flex-start; flex-wrap: wrap; }
    .kr-seuil-pied input[type="text"] {
        flex: 1 1 24rem; min-height: 48px; padding: .5rem .65rem;
        border: 1px solid #ced4da; border-radius: 8px; font-size: .95rem; font-family: inherit;
    }
    .kr-seuil-pied input[type="text"]:focus {
        outline: 0; border-color: #0047AB; box-shadow: 0 0 0 .25rem rgba(0, 71, 171, .35);
    }
    .kr-seuil-pied .kr-btn { height: 48px; }

    @media (max-width: 640px) {
        .kr-seuil { grid-template-columns: 1fr; }
        .kr-seuil-champ { grid-column: 1; grid-row: auto; margin-top: .5rem; }
    }

    /* Historique. */
    /* Règles : une ligne par identifiant, l'identifiant en tête comme une cote. */
    .kr-regle { display: grid; grid-template-columns: 3.5rem 1fr; gap: .25rem .9rem; padding: .6rem .2rem; border-bottom: 1px solid #f0f0f0; }
    .kr-regle:last-child { border-bottom: 0; }
    .kr-regle-id { font-weight: 700; color: #0047AB; font-size: .9rem; }
    .kr-regle-titre { color: #212529; font-size: .9rem; }
    .kr-regle-meta { grid-column: 2; color: #6c757d; font-size: .8rem; }
    .kr-regle-meta code { font-size: .78rem; }
    .kr-regle-risque { grid-column: 2; color: #664d03; font-size: .8rem; }

    .kr-histo td { vertical-align: top; }
    .kr-histo .kr-motif { color: #495057; }
    .kr-histo time { color: #6c757d; white-space: nowrap; }

    /* Même raison pour le sous-titre de page : `console/base.html.twig` plafonne
       `.cs-head p` à 70ch. On ne lève la contrainte QUE sur cette page — la changer
       dans le socle toucherait les dix-neuf autres rubriques de la console, ce qui
       n'est pas une décision à prendre au détour d'un écran. */
    .cs-head p { max-width: none; }

    @media (max-width: 720px) {
        .kr-row > summary { grid-template-columns: 2.4rem 1fr; gap: .35rem .6rem; }
        .kr-tech, .kr-poids, .kr-etat { grid-column: 2; }
        .kr-poids { text-align: left; }
        .kr-fiche dl { grid-template-columns: 1fr; gap: .15rem .9rem; }
        .kr-fiche dt { margin-top: .5rem; }
    }
</style>
{% endblock %}

{% block console_subtitle %}
    <p>Qui répond pour Ket, ce qu’elle sait faire, ce que cela coûte, et les règles qui
       la tiennent. Ces réglages valent pour <strong>tous les cabinets</strong> de la plateforme.</p>
{% endblock %}

{% block console_body %}

    <section class="kr-acces" aria-labelledby="kr-acces-titre">
        <h2 id="kr-acces-titre">Qui a accès à Ket</h2>
        <p>Ket est ouvert à un cabinet disposant d’un <strong>solde de jetons payant</strong> —
           l’allocation gratuite ne suffit pas — et dont l’invité a le module
           « Assistant IA » dans son périmètre. Cette condition
           <strong>ne se modifie pas depuis la console</strong>.</p>
        {# Accord du VERBE, pas seulement du nom : « 0 cabinet … disposent » se lit comme
           une faute, et un écran d'administration qui écrit mal perd de sa crédibilité. #}
        <p>Aujourd’hui, <strong>{{ cabinetsAvecKet }} cabinet{{ cabinetsAvecKet > 1 ? 's' : '' }}
           sur {{ cabinets }}</strong> {{ cabinetsAvecKet > 1 ? 'disposent' : 'dispose' }} du solde nécessaire.
           Les paquets et leurs prix se règlent dans
           {% if console_can_access('console.plan.index') and is_granted('ROLE_SUPER_ADMIN') %}
               <a href="{{ path('console.plan.index') }}">Ventes → Plan tarifaire</a>.
           {% else %}
               Ventes → Plan tarifaire (super-administrateur).
           {% endif %}
        </p>
    </section>

    {# Les cinq blocs empilés faisaient une page de cinq mille pixels : l'historique,
       tout en bas, avait toutes les chances de n'être jamais consulté. Ils deviennent
       des onglets, avec le MÊME contrôleur que la fiche client CRM (`crm-tabs`), qui
       sait de surcroît ouvrir un onglet précis depuis le fragment d'URL — ce dont on
       se sert après chaque action pour revenir là d'où l'agent est parti. #}
    <div data-controller="crm-tabs">
        <div class="kr-tab-bar" role="tablist" aria-label="Sections de la configuration de Ket">
            {% set onglets = {
                mesures:    {libelle: 'Déclarations',       icone: 'action:analyser', compte: null},
                outils:     {libelle: 'Outils de Ket',      icone: 'action:settings', compte: total},
                seuils:     {libelle: 'Seuils métier',      icone: 'action:filter',   compte: parametres|length},
                regles:     {libelle: 'Règles et boussole', icone: 'role',            compte: reglesTotal},
                historique: {libelle: 'Historique',         icone: 'jour-ferie',      compte: historique|length}
            } %}
            {# Les fournisseurs restent SUPER-ADMIN : l'onglet n'existe pas pour les
               autres, et la route qui l'enregistre les refuse de toute façon. #}
            {% if formFournisseurs %}
                {% set onglets = onglets|merge({fournisseurs: {libelle: 'Fournisseurs', icone: 'assistant-ia', compte: null}}) %}
            {% endif %}
            {% for cle, onglet in onglets %}
                <button type="button" id="onglet-{{ cle }}"
                        class="kr-tab {{ ongletActif == cle ? 'is-active' }}"
                        role="tab" aria-controls="tab-{{ cle }}"
                        aria-selected="{{ ongletActif == cle ? 'true' : 'false' }}"
                        data-crm-tabs-target="tab" data-tab="{{ cle }}" data-action="crm-tabs#select">
                    {# Décorative : le libellé juste à côté dit déjà tout. #}
                    <span class="kr-tab-icone" aria-hidden="true">
                        {{ ux_icon(resolve_icon_name(onglet.icone), {height:'15px', width:'15px'}) }}
                    </span>
                    <span>{{ onglet.libelle }}</span>
                    {% if onglet.compte is not null %}<span class="kr-tab-compte">{{ onglet.compte }}</span>{% endif %}
                </button>
            {% endfor %}
        </div>

    <div class="kr-pane{% if ongletActif == 'mesures' %} is-active{% endif %}" data-crm-tabs-target="pane" data-tab="mesures" id="tab-mesures" role="tabpanel" aria-labelledby="onglet-mesures">
    <div class="cs-panel">
        <h2 class="cs-panel-title">Déclarations envoyées à chaque échange</h2>
        <dl class="kr-mesures">
            {% for cle, m in poids %}
                <div class="kr-mesure">
                    <dt>Trousse {{ cle == 'lecture' ? 'de consultation' : 'de saisie' }}</dt>
                    <dd>≈ {{ m.jetons|number_format(0, ',', ' ') }} jetons</dd>
                    <p>{{ m.outils }} outils · {{ (m.octets / 1024)|number_format(1, ',', ' ') }} Ko</p>
                </div>
            {% endfor %}
        </dl>
        {% if gainCoupe.outils > 0 %}
            <p class="kr-compte" style="margin-top:1rem">
                <strong>{{ gainCoupe.outils }} outil{{ gainCoupe.outils > 1 ? 's' : '' }} coupé{{ gainCoupe.outils > 1 ? 's' : '' }}</strong>
                épargne{{ gainCoupe.outils > 1 ? 'nt' : '' }} déjà
                ≈ {{ gainCoupe.jetons|number_format(0, ',', ' ') }} jetons
                ({{ (gainCoupe.octets / 1024)|number_format(1, ',', ' ') }} Ko) à chaque échange.
            </p>
        {% endif %}
        <p class="kr-compte" style="margin-top:1rem">
            Ce sont des <strong>plafonds</strong> : selon les droits de l’invité et son appareil,
            certains outils ne sont pas déclarés, et l’échange réel pèse moins. Les jetons sont
            estimés à partir des octets réellement envoyés.
        </p>
    </div>
    </div>

    <div class="kr-pane{% if ongletActif == 'outils' %} is-active{% endif %}" data-crm-tabs-target="pane" data-tab="outils" id="tab-outils" role="tabpanel" aria-labelledby="onglet-outils">
    <div class="cs-panel">
        <h2 class="cs-panel-title">Outils de Ket</h2>

        <form method="get" action="{{ path('console.ket.reglages.index') }}"
              data-action="submit->top-progress#show">
            <fieldset class="kr-filtres">
                {# La légende est masquée : les libellés des deux champs disent déjà
                   ce qu'on filtre, et un troisième titre au-dessus n'ajouterait qu'une
                   ligne à lire. Elle reste dans le DOM pour les lecteurs d'écran, à qui
                   le groupement, lui, ne se voit pas. #}
                <legend class="visually-hidden">Filtrer les outils de Ket</legend>
                {# LE FORMULAIRE DIT D'OÙ IL PART. Un GET ne peut pas porter de
                   fragment : sans ce champ, filtrer renverrait sur le premier onglet
                   dès que la recherche est vide. #}
                <input type="hidden" name="onglet" value="outils">

                <div class="kr-filtre-champ kr-filtre-champ--large">
                    <label for="kr-q">Rechercher un outil</label>
                    <span class="kr-champ-loupe">
                        {{ ux_icon(resolve_icon_name('action:search'), {height:'17px', width:'17px'}) }}
                        <input type="search" id="kr-q" name="q" value="{{ recherche }}"
                               placeholder="Nom de l’outil, mot-clé…">
                    </span>
                </div>

                <div class="kr-filtre-champ">
                    <label for="kr-classe">Classe</label>
                    <select id="kr-classe" name="classe">
                        <option value="">Toutes les classes</option>
                        {% for c in classes %}
                            <option value="{{ c.value }}" {{ classeActive == c.value ? 'selected' }}>{{ c.libelle }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="kr-filtre-actions">
                    <button type="submit" class="kr-btn">Filtrer</button>
                    {% if classeActive or recherche %}
                        <a href="{{ path('console.ket.reglages.index', {onglet: 'outils'}) }}" class="kr-btn--secondaire"
                           data-action="click->top-progress#show">Tout afficher</a>
                    {% endif %}
                </div>
            </fieldset>
        </form>

        <p class="kr-compte">
            {{ outils|length }} outil{{ outils|length > 1 ? 's' : '' }} affiché{{ outils|length > 1 ? 's' : '' }}
            sur {{ total }}.
        </p>

        {% if outils is empty %}
            <div class="cs-empty">Aucun outil ne correspond à ce filtre.</div>
        {% else %}
            {% for o in outils %}
                <details class="kr-row">
                    <summary>
                        <span class="kr-pastille" aria-hidden="true">
                            {{ ux_icon(resolve_icon_name(o.icone), {height:'19px', width:'19px'}) }}
                        </span>
                        <span class="kr-nom">
                            <strong>{{ o.libelle }}</strong>
                            <span>{{ o.resume }}</span>
                        </span>
                        <span class="kr-tech">{{ o.nom }}</span>
                        <span class="kr-poids">≈ {{ o.jetons|number_format(0, ',', ' ') }} jetons</span>
                        {# Le statut n'est JAMAIS porté par la seule couleur (WCAG 1.4.1) :
                           pastille, icône et libellé disent la même chose. #}
                        <span class="kr-etat">
                            {% if not o.classe.estModifiable %}
                                {{ ux_icon(resolve_icon_name('action:password'), {height:'15px', width:'15px'}) }}
                                <span class="cs-badge cs-badge--cobalt">Verrouillé</span>
                            {% elseif o.nom in coupes %}
                                {{ ux_icon(resolve_icon_name('action:hide'), {height:'15px', width:'15px'}) }}
                                <span class="cs-badge cs-badge--warn">Coupé</span>
                            {% else %}
                                <span class="cs-badge cs-badge--ok">Actif</span>
                            {% endif %}
                        </span>
                    </summary>

                    <div class="kr-fiche">
                        <dl>
                            <dt>Classe</dt>
                            <dd><strong>{{ o.classe.libelle }}</strong> — {{ o.classe.explication }}</dd>

                            <dt>Nom technique</dt>
                            <dd><code>{{ o.nom }}</code></dd>

                            <dt>Trousses</dt>
                            <dd>{{ o.trousses|join(', ') }}</dd>

                            <dt>Poids par échange</dt>
                            <dd>{{ o.octets|number_format(0, ',', ' ') }} octets, soit ≈ {{ o.jetons|number_format(0, ',', ' ') }} jetons</dd>

                            {% if o.facture %}
                                <dt>Facturation</dt>
                                <dd>Cet outil <strong>débite des jetons</strong> au cabinet qui l’utilise
                                    (<code>{{ o.facture }}</code>). Le couper supprimerait aussi cette recette.</dd>
                            {% endif %}

                            {% if o.conditionnel %}
                                <dt>Conditions</dt>
                                <dd>Cet outil n’est pas toujours déclaré : selon les droits de l’invité,
                                    son appareil ou le fil en cours, il est écarté pour ne pas être payé
                                    à chaque échange.</dd>
                            {% endif %}

                            <dt>Instructions au modèle</dt>
                            <dd class="kr-prose">{{ o.description }}</dd>

                            {% if o.aiguillage %}
                                <dt>Règle d’appel</dt>
                                <dd class="kr-prose">{{ o.aiguillage }}</dd>
                            {% endif %}

                            <dt>Source</dt>
                            <dd><code>{{ o.source }}</code></dd>

                            {% set change = dernierChangement['outil:' ~ o.nom]|default(null) %}
                            {% if change %}
                                <dt>Dernier changement</dt>
                                <dd>
                                    {{ change.ancienneValeur }} → <strong>{{ change.nouvelleValeur }}</strong>,
                                    le {{ change.effectueLe|date('d/m/Y à H:i') }} par {{ change.auteurNom }}.<br>
                                    <em>« {{ change.motif }} »</em>
                                </dd>
                            {% endif %}
                        </dl>

                        {% if peutRegler and o.classe.estModifiable %}
                            {% set coupe = o.nom in coupes %}
                            <form method="post" action="{{ path('console.ket.reglages.outil', {nom: o.nom}) }}" class="kr-agir"
                                  data-action="submit->top-progress#show">
                                <h3>{{ coupe ? 'Réactiver cet outil' : 'Couper cet outil' }}</h3>

                                {# L'IMPACT EST MONTRÉ AVANT LE BOUTON, jamais après : une
                                   confirmation qui n'apprend rien ne protège de rien. #}
                                <div class="kr-impact">
                                    <p><strong>{{ cabinetsAvecKet }} cabinet{{ cabinetsAvecKet > 1 ? 's' : '' }}</strong>
                                       {{ cabinetsAvecKet > 1 ? 'disposent' : 'dispose' }} de Ket aujourd’hui
                                       (sur {{ cabinets }} au total). Le changement vaut pour tous.</p>
                                    <p>{{ coupe ? 'Réactiver' : 'Couper' }} cet outil
                                       {{ coupe ? 'ajoute' : 'épargne' }}
                                       <strong>≈ {{ o.jetons|number_format(0, ',', ' ') }} jetons</strong> par échange.</p>
                                    {% if o.facture and not coupe %}
                                        <p>⚠ Cet outil <strong>débite des jetons</strong> au cabinet qui l’utilise :
                                           le couper supprime aussi cette recette.</p>
                                    {% endif %}
                                    <p>Prise d’effet : au prochain message de chaque cabinet.</p>
                                </div>

                                <label for="motif-{{ o.nom }}">Motif (obligatoire)</label>
                                <textarea id="motif-{{ o.nom }}" name="motif" rows="2" required minlength="5"
                                          placeholder="Pourquoi ce changement ? Sans motif, l’historique ne permet pas de savoir s’il faut le défaire."></textarea>

                                <input type="hidden" name="_token" value="{{ csrf_token('ket_reglage') }}">
                                <input type="hidden" name="actif" value="{{ coupe ? 1 : 0 }}">
                                <div class="kr-boutons">
                                    <button type="submit" class="kr-btn {{ coupe ? '' : 'kr-btn--danger' }}">
                                        {{ coupe ? 'Réactiver pour toute la plateforme' : 'Couper pour toute la plateforme' }}
                                    </button>
                                </div>
                            </form>
                        {% endif %}
                    </div>
                </details>
            {% endfor %}
        {% endif %}
    </div>
    </div>

    <div class="kr-pane{% if ongletActif == 'seuils' %} is-active{% endif %}" data-crm-tabs-target="pane" data-tab="seuils" id="tab-seuils" role="tabpanel" aria-labelledby="onglet-seuils">
    <div class="cs-panel">
        <h2 class="cs-panel-title">Seuils métier</h2>
        <p class="kr-compte">
            Quatre valeurs, bornées. Une valeur hors bornes est refusée à la saisie —
            et ignorée si elle arrive en base par un autre chemin : c’est alors la valeur
            d’origine qui reprend la main.
        </p>

        {% if peutRegler %}<form method="post" action="{{ path('console.ket.reglages.seuils') }}"
              data-action="submit->top-progress#show">{% endif %}

        {% for clef, regle in parametres %}
            {% set modifie = valeurs[clef] != regle.defaut %}
            <div class="kr-seuil">
                <label class="kr-seuil-label" for="v-{{ clef }}">
                    {{ regle.libelle }}
                    {% if modifie %}<span class="kr-modifie">modifié</span>{% endif %}
                </label>
                <p class="kr-seuil-aide" id="aide-{{ clef }}">{{ regle.explication }}</p>

                <div class="kr-seuil-champ">
                    <div class="kr-seuil-saisie">
                        {% if peutRegler %}
                            <input type="number" id="v-{{ clef }}" name="valeurs[{{ clef }}]"
                                   value="{{ valeurs[clef] }}" min="{{ regle.min }}" max="{{ regle.max }}"
                                   step="1" required
                                   aria-describedby="aide-{{ clef }} bornes-{{ clef }}">
                        {% else %}
                            <strong id="v-{{ clef }}">{{ valeurs[clef] }}</strong>
                        {% endif %}
                        <span class="kr-seuil-unite">{{ regle.unite }}</span>
                    </div>
                    {# Les bornes et la valeur d'origine sont RATTACHÉES au champ
                       (aria-describedby) : un lecteur d'écran les annonce en entrant
                       dedans, au moment où elles servent (WCAG 3.3.2). #}
                    <p class="kr-bornes" id="bornes-{{ clef }}">
                        entre {{ regle.min }} et {{ regle.max }} · d’origine&nbsp;: {{ regle.defaut }}
                    </p>

                    {% set change = dernierChangement['parametre:' ~ clef]|default(null) %}
                    {% if change %}
                        <p class="kr-bornes">
                            {{ change.ancienneValeur }} → <strong>{{ change.nouvelleValeur }}</strong>,
                            le {{ change.effectueLe|date('d/m/Y') }} par {{ change.auteurNom }}
                        </p>
                    {% endif %}
                </div>
            </div>
        {% endfor %}

        {% if peutRegler %}
            <div class="kr-seuil-pied">
                <label for="motif-seuils">Motif (obligatoire) — il vaut pour tous les seuils modifiés ci-dessus</label>
                <div class="kr-seuil-pied-ligne">
                    <input type="text" id="motif-seuils" name="motif" required minlength="5"
                           placeholder="Pourquoi ce changement ? Sans motif, l’historique ne permet pas de savoir s’il faut le défaire.">
                    <input type="hidden" name="_token" value="{{ csrf_token('ket_reglage') }}">
                    <button type="submit" class="kr-btn">Enregistrer les seuils</button>
                </div>
            </div>
            </form>
        {% endif %}
    </div>
    </div>

    <div class="kr-pane{% if ongletActif == 'regles' %} is-active{% endif %}" data-crm-tabs-target="pane" data-tab="regles" id="tab-regles" role="tabpanel" aria-labelledby="onglet-regles">
    <div class="cs-panel">
        <h2 class="cs-panel-title">Règles et boussole</h2>
        <p class="kr-compte">
            Ce qui tient Ket, et que <strong>personne ne peut modifier depuis la console</strong> —
            pas même un super-administrateur. Une règle d’intégrité comptable, de cloisonnement
            entre cabinets ou de réglementation ne se règle pas depuis un écran. Ce qui change
            ici, c’est qu’elles portent enfin un identifiant stable, et qu’on peut donc les citer.
        </p>

        {% for cle, famille in familles %}
            <h3 style="font-size:.95rem;color:#212529;margin:1.4rem 0 .3rem">{{ famille.libelle }}</h3>
            <p class="kr-compte">
                {% if cle == 'code' %}
                    Appliquées par le CODE : un service en est la source unique, et elles valent
                    aussi pour les formulaires de l’espace de travail. Les enfreindre corrompt
                    des données.
                {% elseif cle == 'restitution' %}
                    Appliquées par les instructions de Ket : elles régissent son DISCOURS.
                    Les enfreindre produit une réponse fausse, pas une donnée fausse.
                {% else %}
                    Ce que le cabinet poursuit, et l’ordre de la chaîne de valeur.
                {% endif %}
            </p>

            {% for id, regle in famille.entrees %}
                <div class="kr-regle">
                    <span class="kr-regle-id">{{ id }}</span>
                    <span class="kr-regle-titre">{{ regle.titre }}</span>
                    <span class="kr-regle-meta">Source : <code>{{ regle.source }}</code></span>
                    {% if regle.risque is defined %}
                        <span class="kr-regle-risque">Si elle saute : {{ regle.risque }}</span>
                    {% endif %}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
    </div>

    <div class="kr-pane{% if ongletActif == 'historique' %} is-active{% endif %}" data-crm-tabs-target="pane" data-tab="historique" id="tab-historique" role="tabpanel" aria-labelledby="onglet-historique">
    <div class="cs-panel">
        <h2 class="cs-panel-title">Historique des changements</h2>

        {% if historique is empty %}
            <div class="cs-empty">Aucun réglage n’a encore été modifié : la plateforme tourne sur les valeurs d’origine.</div>
        {% else %}
            <div style="overflow-x:auto">
                <table class="cs-table kr-histo">
                    <caption class="visually-hidden">Derniers changements de réglages de Ket</caption>
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Administrateur</th>
                            <th scope="col">Élément</th>
                            <th scope="col">Avant → après</th>
                            <th scope="col">Motif</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ligne in historique %}
                            <tr>
                                <td><time datetime="{{ ligne.effectueLe|date('c') }}">{{ ligne.effectueLe|date('d/m/Y H:i') }}</time></td>
                                <td>{{ ligne.auteurNom }}</td>
                                <td><code>{{ ligne.nomCourt }}</code></td>
                                <td>{{ ligne.ancienneValeur }} → <strong>{{ ligne.nouvelleValeur }}</strong></td>
                                <td class="kr-motif">{{ ligne.motif }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% if peutRegler and not vierge %}
            <form method="post" action="{{ path('console.ket.reglages.reinitialiser') }}" class="kr-agir"
                  data-action="submit->top-progress#show">
                <h3>Rétablir les réglages d’origine</h3>
                <div class="kr-impact">
                    <p>Tous les outils coupés redeviennent actifs et tous les seuils reprennent
                       leur valeur d’origine, pour l’ensemble de la plateforme.</p>
                    <p>L’état actuel est inscrit à l’historique avant d’être effacé : rien n’est perdu,
                       vous pourrez relire ce qui a été annulé.</p>
                </div>
                <label for="motif-reset">Motif (obligatoire)</label>
                <textarea id="motif-reset" name="motif" rows="2" required minlength="5"
                          placeholder="Pourquoi rétablir les valeurs d’origine ?"></textarea>
                <input type="hidden" name="_token" value="{{ csrf_token('ket_reglage') }}">
                <div class="kr-boutons">
                    <button type="submit" class="kr-btn kr-btn--danger">Rétablir les réglages d’origine</button>
                </div>
            </form>
        {% endif %}
    </div>
    </div>

    {% if formFournisseurs %}
        <div class="kr-pane{% if ongletActif == 'fournisseurs' %} is-active{% endif %}"
             data-crm-tabs-target="pane" data-tab="fournisseurs" id="tab-fournisseurs"
             role="tabpanel" aria-labelledby="onglet-fournisseurs">
            <div class="cs-panel">
                <h2 class="cs-panel-title">Qui répond pour Ket</h2>
                <p class="kr-compte">
                    Cinq familles — moteur de texte, compréhension, dictée, voix, oreilles —
                    et pour chacune : qui répond, dans quel ordre, avec quel modèle.
                    <strong>Aucune clé d’API ne se saisit ici</strong> : elles restent dans la
                    configuration du serveur, et cet écran n’affiche que leur présence.
                </p>

                {{ form_start(formFournisseurs, {
                    action: path('console.ket.fournisseurs.index'),
                    attr: {'data-action': 'submit->top-progress#show'}
                }) }}
                    {% include 'console/ket_fournisseurs/_corps.html.twig' with {
                        form: formFournisseurs, etat: etatFournisseurs
                    } only %}
                    <div class="kr-boutons" style="margin-top:1.25rem">
                        <button type="submit" class="kr-btn">Enregistrer la politique</button>
                    </div>
                {{ form_end(formFournisseurs) }}
            </div>

            {# Le réarmement n'entre PAS dans le formulaire ci-dessus : imbriqué, il le
               refermerait avant son bouton d'envoi, qui ne ferait plus rien. #}
            <form method="post" action="{{ path('console.ket.fournisseurs.rearmer') }}" id="kf-rearmer-form"
                  data-action="submit->top-progress#show">
                <input type="hidden" name="_token" value="{{ csrf_token('ket_rearmer') }}">
                <input type="hidden" name="cle" id="kf-rearmer-cle">
            </form>
        </div>
    {% endif %}
    </div>

{% endblock %}
