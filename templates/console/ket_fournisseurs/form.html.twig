{% extends 'console/form.html.twig' %}

{% set libelles = {
    'moteur':        {titre: 'Moteur de texte', aide: 'Qui rédige les réponses de Ket et choisit ses outils.'},
    'comprehension': {titre: 'Compréhension',   aide: 'Le premier appel : établir ce que l’utilisateur veut dire.'},
    'dictee':        {titre: 'Finition de dictée', aide: 'Met au propre le texte dicté avant de l’envoyer à Ket.'},
    'voix':          {titre: 'Voix',            aide: 'Lecture à voix haute des réponses.'},
    'oreille':       {titre: 'Oreilles',        aide: 'Transcription de la parole en mode Live.'}
} %}

{% block console_form_body %}
    <style>
        .cs-help { border:1px solid #d7e2f7; background:#f5f8ff; border-radius:12px; margin-bottom:1.5rem; }
        .cs-help > summary { cursor:pointer; list-style:none; padding:.85rem 1.1rem; font-weight:700; color:#0047AB;
            display:flex; align-items:center; gap:.5rem; }
        .cs-help > summary::-webkit-details-marker { display:none; }
        .cs-help > summary::after { content:"▸"; margin-left:auto; transition:transform .2s ease; color:#6c757d; }
        .cs-help[open] > summary::after { transform:rotate(90deg); }
        .cs-help__body { padding:0 1.1rem 1rem; color:#333; font-size:.9rem; }
        .cs-help__body h3 { font-size:.9rem; font-weight:700; color:#0047AB; margin:1rem 0 .35rem; }
        .cs-help__note { margin-top:.9rem; padding:.6rem .8rem; background:#fff3cd; color:#7a5b00; border-radius:8px; }

        /* L'erreur se lit AVANT le formulaire, en rouge, et porte `role="alert"` :
           un message d'erreur qui n'interrompt pas la lecture n'est pas lu
           (WCAG 3.3.1, Bastien & Scapin > Gestion des erreurs). */
        .kf-erreurs { border:1px solid #f1aeb5; background:#fff5f5; color:#842029;
            border-radius:12px; padding:.9rem 1.1rem; margin-bottom:1.25rem; font-size:.9rem; }
        .kf-erreurs p { margin:0 0 .35rem; }
        .kf-erreurs p:last-child { margin-bottom:0; }

        .kf-famille { margin-bottom:1.1rem; }
        .kf-famille__aide { color:#495057; font-size:.85rem; margin:-.25rem 0 .7rem; }

        /* LE MODE : un vrai groupe de radios, deguise en pastilles. La commande
           native apporte le role, l'exclusivite et le parcours aux fleches ; le CSS
           ne fait que l'habiller (WCAG 4.1.2). */
        .kf-mode { display:flex; gap:.4rem; align-items:center; margin-bottom:.35rem; }
        .kf-mode__choix { display:inline-flex; align-items:center; gap:.35rem; margin:0;
            border:1px solid #d7e2f7; background:#fff; color:#0047AB; border-radius:999px;
            padding:.35rem .9rem; font-size:.82rem; font-weight:600; cursor:pointer;
            min-height:2.25rem; }
        .kf-mode__choix input { accent-color:#0047AB; margin:0; cursor:pointer; }
        .kf-mode__choix:has(input:checked) { background:#0047AB; color:#fff; border-color:#0047AB; }
        .kf-mode__choix:has(input:checked) input { accent-color:#fff; }
        .kf-mode__choix:has(input:focus-visible) { outline:3px solid #0047AB; outline-offset:2px; }
        .kf-mode-aide { color:#495057; font-size:.8rem; margin:0 0 .75rem; }

        .kf-liste { list-style:none; margin:0; padding:0; }
        /* UNE GRILLE SUR DEUX NIVEAUX, et non une rangée unique. Cinq colonnes ne
           tiennent pas dans une carte de 620 px : essayé au navigateur le 2026-09-22,
           le nom du fournisseur y était rogné jusqu'à une seule lettre. Le réglage
           descend donc sous le nom, où il a la place de se lire. Une grille aligne
           en prime les colonnes sur TOUTES les lignes à la fois. */
        .kf-item { display:grid; align-items:center;
            grid-template-columns:auto minmax(6rem,1fr) auto auto;
            grid-template-areas:"rang nom etat fleches"
                                ".    reglage reglage reglage";
            gap:.35rem .6rem; padding:.5rem .7rem;
            border:1px solid #e6ecf7; border-radius:10px; background:#fff; margin-bottom:.45rem; }
        .kf-item__position { grid-area:rang; }
        .kf-item__bascule  { grid-area:nom; }
        .kf-item__reglage  { grid-area:reglage; }
        .kf-fleches        { grid-area:fleches; }
        .kf-item__etat { grid-area:etat; display:flex; align-items:center; gap:.4rem;
            justify-content:flex-end; }
        /* Un fournisseur ecarte reste LISIBLE : il faut pouvoir le relire pour decider
           de le remettre. On le distingue par le fond et un trait tirete — jamais par
           une opacite, qui ferait passer son texte sous le seuil de contraste. */
        .kf-item[data-actif="0"] { background:#f8f9fa; border-style:dashed; }

        .kf-item__position { width:1.6rem; height:1.6rem; border-radius:50%;
            display:inline-flex; align-items:center; justify-content:center;
            font-size:.76rem; font-weight:700; background:#e8effb; color:#0047AB; }
        .kf-item[data-actif="0"] .kf-item__position { background:#e9ecef; color:#495057; }

        /* LA CASE A COCHER ET SON NOM NE FONT QU'UN : tout le bloc est cliquable, ce
           qui donne une cible bien au-dela des 24x24 px exiges (WCAG 2.5.8). */
        .kf-item__bascule { display:flex; align-items:center; gap:.55rem;
            margin:0; cursor:pointer; min-width:0; min-height:2.25rem; }
        .kf-item__bascule .form-check-input { flex:0 0 auto; width:1.2rem; height:1.2rem;
            margin:0; cursor:pointer; accent-color:#0047AB; }
        .kf-item__bascule:has(input:focus-visible) { outline:3px solid #0047AB;
            outline-offset:2px; border-radius:6px; }
        .kf-item__nom { font-weight:600; color:#212529; overflow:hidden;
            text-overflow:ellipsis; white-space:nowrap; }
        .kf-item[data-actif="0"] .kf-item__nom { color:#495057; }
        .kf-item__mention { font-size:.73rem; color:#495057; background:#eef1f4;
            border-radius:999px; padding:.1rem .45rem; white-space:nowrap; }
        /* LE REPLI SE VOIT. Il ne se configure pas — il s'applique dès que plus rien
           ne répond — et un badge terne à côté de « écarté » laissait croire l'inverse. */
        .kf-item__mention--repli { display:inline-flex; align-items:center; gap:.25rem;
            background:#e6f5ec; color:#1b6b3a; font-weight:600; }
        .kf-item__mention--repli svg { flex:0 0 auto; }
        /* EN SERVICE : le repli ne fait pas qu'exister, il parle en ce moment. */
        .kf-item__mention--actif { background:#0047AB; color:#fff; }

        .kf-item__reglage { display:flex; align-items:center; gap:.4rem; min-width:0; }
        .kf-item__reglage-nom { font-size:.73rem; color:#495057; text-transform:uppercase;
            letter-spacing:.02em; margin:0; cursor:pointer; }
        .kf-item__reglage input { flex:1 1 auto; min-width:0; max-width:24rem;
            border:1px solid #d7e2f7; border-radius:8px; padding:.3rem .5rem;
            font-size:.82rem; background:#fff; color:#212529; }
        .kf-item__reglage input::placeholder { color:#6c757d; font-style:italic; }
        .kf-item__reglage input:focus-visible { outline:3px solid #0047AB; outline-offset:1px;
            border-color:#0047AB; }

        .kf-fleches { display:flex; gap:.25rem; }
        /* 2rem de cote : au-dessus du minimum de 24x24 px (WCAG 2.5.8). */
        .kf-fleches button { width:2rem; height:2rem; display:inline-flex; align-items:center;
            justify-content:center; border:1px solid #d7e2f7; background:#fff; border-radius:8px;
            cursor:pointer; font-size:.85rem; color:#0047AB; }
        .kf-fleches button:hover:not(:disabled) { background:#e8effb; }
        .kf-fleches button:focus-visible { outline:3px solid #0047AB; outline-offset:2px; }
        .kf-fleches button:disabled { color:#868e96; cursor:default; }

        /* L'ETAT EST ECRIT, pas seulement colore : la couleur ne porte aucune
           information a elle seule (WCAG 1.4.1). Contrastes mesures, tous >= 4,5:1. */
        .kf-voyant { font-size:.76rem; padding:.2rem .55rem; border-radius:999px; white-space:nowrap; }
        .kf-voyant--ok { background:#e6f5ec; color:#1b6b3a; }
        .kf-voyant--absent { background:#f1f3f5; color:#495057; }
        .kf-voyant--sec { background:#fff3cd; color:#7a5b00; }

        /* Le rearmement est une ACTION : un bouton, pas un mot dans la pastille d'etat. */
        .kf-rearmer { border:1px solid #d9a91e; background:#fffaf0; color:#7a5b00;
            border-radius:8px; padding:.25rem .6rem; font-size:.76rem; font-weight:700;
            cursor:pointer; white-space:nowrap; min-height:2rem; }
        .kf-rearmer:hover { background:#fff3cd; }
        .kf-rearmer:focus-visible { outline:3px solid #0047AB; outline-offset:2px; }

        /* DEUXIÈME ASCENSEUR, INCIDENT DU 2026-09-22. La console tient dans la
           fenêtre : `.cs-page` fait 100vh en `overflow:hidden`, et SEUL `.cs-scroll`
           défile. Or un élément en `position:absolute` SANS ancêtre positionné prend
           pour référence le bloc englobant initial : il échappe donc à ce
           `overflow:hidden`, s'installe à sa position statique — ici ~2 750 px plus
           bas, dans le contenu défilant — et étire le DOCUMENT. D'où un second
           ascenseur, celui du navigateur, à côté de celui de la console. Mesuré :
           `html` à 2 754 px pour une fenêtre de 281. Ce `position:relative` rend la
           référence LOCALE, et la région invisible ne dépasse plus de son éditeur. */
        .kf-editeur { position:relative; }

        /* Lu par les lecteurs d'ecran, invisible a l'ecran (pattern .visually-hidden). */
        .kf-annonce { position:absolute; top:0; left:0; width:1px; height:1px; padding:0;
            margin:0; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }

        /* Sur une tablette, la ligne se plie au lieu de deborder. */
        @media (max-width: 620px) {
            .kf-item { grid-template-columns:auto minmax(0,1fr) auto;
                       grid-template-areas:"rang nom fleches"
                                           ".    reglage reglage"
                                           ".    etat etat"; }
            .kf-item__etat { justify-content:flex-start; }
        }
    </style>

    {# LES ERREURS GLOBALES DU FORMULAIRE, sans quoi elles n'apparaissent NULLE PART.
       Surcharger `console_form_body`, c'est remplacer le `form_widget(form)` du
       gabarit — celui-là même qui les rendait. Un JSON cassé ou un modèle refusé
       renvoyait donc un 422 muet : l'écran se réaffichait, rien ne partait en base,
       et l'agent n'avait aucun moyen de savoir pourquoi. Constaté le 2026-09-22 en
       écrivant le test du modèle aberrant. #}
    {% if form.vars.errors|length > 0 %}
        <div class="kf-erreurs" role="alert">
            {% for erreur in form.vars.errors %}<p>{{ erreur.message }}</p>{% endfor %}
        </div>
    {% endif %}

    <details class="cs-help">
        <summary>
            {{ ux_icon(resolve_icon_name('action:information'), {height:'18px', width:'18px'}) }}
            Comment cette page décide qui répond
        </summary>
        <div class="cs-help__body">
            <p>Ket s'appuie sur <strong>cinq familles de fournisseurs</strong>. Pour chacune, la liste
               ci-dessous dit <strong>qui est essayé, et dans quel ordre</strong>.</p>

            <h3>Chaîné ou épinglé</h3>
            <p><strong>Chaîné</strong> : la liste est parcourue de haut en bas, et le premier fournisseur
               utilisable répond. <strong>Épinglé</strong> : seul le premier est appelé, sans repli.</p>

            <h3>Un fournisseur décoché n'est jamais appelé</h3>
            <p>C'est ainsi qu'on coupe un fournisseur sans toucher au code. En revanche, tout décocher
               dans une famille ne la coupe pas : la configuration du serveur reprend la main, pour
               qu'une case oubliée ne laisse jamais Ket sans réponse.</p>

            <h3>« Non configuré » et « à sec » ne veulent pas dire la même chose</h3>
            <p><strong>Non configuré</strong> : il manque à ce fournisseur, <em>sur ce serveur</em>, une
               clé d'API, un identifiant de voix ou un modèle — rien à faire ici, cela se règle dans la
               configuration du serveur. C'est la raison habituelle pour laquelle un fournisseur est
               « prêt » en développement et « non configuré » en production : les secrets ne sont pas
               versionnés, chaque serveur a les siens. <strong>À sec</strong> : il s'est lui-même
               déclaré épuisé (quota du jour, crédits du mois, plafond de dépense) et sera réessayé
               automatiquement à l'heure indiquée. Le lien <em>Réarmer</em> le rend interrogeable tout de
               suite — utile seulement si vous pensez que la marque est erronée.</p>

            <div class="cs-help__note">
                Les <strong>clés d'API ne se saisissent pas ici</strong> : elles restent dans la
                configuration du serveur. Cette page ne fait qu'indiquer si elles sont présentes.
            </div>
        </div>
    </details>

    {% for famille, meta in libelles %}
        <fieldset class="cs-fieldset kf-famille">
            <legend class="cs-legend">
                {{ ux_icon(resolve_icon_name('action:settings'), {height:'18px', width:'18px'}) }}
                {{ meta.titre }}
            </legend>
            <p class="kf-famille__aide">{{ meta.aide }}</p>

            <div class="kf-editeur" data-controller="fournisseurs-editor"
                 data-fournisseurs-editor-famille-value="{{ famille }}"
                 data-fournisseurs-editor-etat-value="{{ (etat[famille] ?? [])|json_encode }}">
                {# L'ICÔNE DU BADGE « REPLI », clonée par l'éditeur. Elle vit ici parce que
                   c'est Twig qui sait résoudre un alias d'icône, et nulle part ailleurs. #}
                <template data-fournisseurs-editor-target="icone">{{ ux_icon(resolve_icon_name('action:transfer'), {height:'13px', width:'13px'}) }}</template>

                <div class="kf-mode" role="group" aria-label="Mode d’appel — {{ meta.titre }}"
                     data-fournisseurs-editor-target="mode"></div>
                <p class="kf-mode-aide" data-fournisseurs-editor-target="aide"></p>
                <ul class="kf-liste" data-fournisseurs-editor-target="liste"></ul>
                <p class="kf-mode-aide" id="kf-aide-modele-{{ famille }}">
                    Laissez le champ <strong>Modèle</strong> vide pour garder celui du serveur —
                    il est rappelé en filigrane dans le champ.
                </p>
                {# Ce qui vient de se passer, dit aux lecteurs d’écran : cocher ou
                   réordonner ne s’annonce pas tout seul (WCAG 4.1.3). #}
                <p class="kf-annonce" role="status" aria-live="polite"
                   data-fournisseurs-editor-target="annonce"></p>
                {{ form_widget(attribute(form, famille ~ 'Json'), {'attr': {'data-fournisseurs-editor-target': 'champ'}}) }}
            </div>
        </fieldset>
    {% endfor %}
{% endblock %}

{# Le réarmement est une action à part : il ne passe pas par l'enregistrement de la
   politique, puisqu'il ne change rien à la politique — il efface une marque. Il vit
   donc DEHORS du formulaire principal : imbriqué, il refermait celui-ci avant son
   bouton « Enregistrer », qui ne faisait plus rien. #}
{% block console_form_after %}
    <form method="post" action="{{ path('console.ket.fournisseurs.rearmer') }}" id="kf-rearmer-form">
        <input type="hidden" name="_token" value="{{ csrf_token('ket_rearmer') }}">
        <input type="hidden" name="cle" id="kf-rearmer-cle">
    </form>
{% endblock %}
