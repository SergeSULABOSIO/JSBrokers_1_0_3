# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# ⚠ CE FICHIER EST VERSIONNÉ SUR UN DÉPÔT PUBLIC. Tout ce qu'on y écrit est
# lisible par n'importe qui. Le secret RÉEL de production vit dans .env.local,
# sur le serveur, et n'existe nulle part ailleurs.
# Générer le sien : php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
APP_SECRET=valeur-de-developpement-a-ne-jamais-utiliser-en-production
###< symfony/framework-bundle ###

# Horloge de RÉFÉRENCE de l'application — SOURCE DE VÉRITÉ UNIQUE.
# Appliquée au démarrage du noyau (App\Kernel::boot) : PHP, Doctrine, Twig et le
# CLI la suivent, quel que soit le date.timezone du php.ini de la machine ; le
# front la reçoit via <meta name="app-timezone"> et affiche exactement la même
# heure que le serveur. UTC+1 sans heure d'été = horloge du marché RDC.
# ⚠️ Colonnes DATETIME NAÏVES : changer cette valeur ne modifie aucune heure
# affichée, mais décale d'autant le sens ABSOLU des dates déjà stockées.
APP_TIMEZONE=Africa/Kinshasa

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
# Base de DÉVELOPPEMENT, sur la machine du développeur. Elle doit rester ici et
# pas dans .env.local : Symfony IGNORE .env.local quand APP_ENV=test, de sorte
# que la suite de tests ne dépende jamais d'une surcharge propre à un poste.
# C'est aussi d'ici que vient « bdm_test » (suffixe posé par doctrine.yaml).
# La production, elle, surcharge cette ligne dans le .env.local DU SERVEUR —
# jamais ici : ce fichier est versionné sur un dépôt public.
DATABASE_URL="mysql://root:@127.0.0.1:3306/bdm?serverVersion=10.4.27-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> assistant-ia (moteur Claude / Anthropic) ###
# Clé API Anthropic (à créer sur https://console.anthropic.com → API Keys).
# NE PAS la mettre ici : renseignez-la dans .env.local (non versionné).
# Vide = l'assistant tourne sur le moteur simulé (aucun appel réseau).
ANTHROPIC_API_KEY=
# Modèle Claude utilisé par l'assistant (claude-opus-4-8 recommandé ;
# claude-haiku-4-5 = alternative plus rapide et moins chère).
ANTHROPIC_MODEL=claude-opus-4-8
# Clé API Google Gemini (https://aistudio.google.com → « Get API key »,
# palier gratuit disponible). À renseigner dans .env.local (non versionné).
# Priorité des moteurs : ANTHROPIC_API_KEY > GEMINI_API_KEY > simulé.
GEMINI_API_KEY=
# Modèle Gemini, ÉPINGLÉ À UNE VERSION PRÉCISE — et surtout pas à un alias.
#
# « gemini-flash-latest » était posé ici comme « alias stable vers la génération
# flash courante ». Il n'a rien de stable : le 2026-09-14, en production, il
# pointait sur gemini-3.8-flash, un modèle à raisonnement qui a refusé la charge
# utile de l'assistant par un HTTP 500 — sans qu'aucun déploiement n'ait eu lieu.
# Le modèle avait bougé sous l'application.
#
# Un alias déplace donc une dépendance en dehors de tout ce qui est versionné,
# testé et déployé : la panne arrive un mardi, sans changement de code, et rien
# dans le dépôt n'en porte la trace. Une version épinglée, elle, ne change que
# lorsqu'on décide de la changer — et on l'éprouve avant.
#
# gemini-3.1-flash-lite : le seul modèle vérifié de bout en bout avec le
# function calling de Ket (appel d'outil réussi, réponse exacte). Le jour où on
# en change, on le prouve d'abord par « app:assistant:smoke <idEntreprise> ».
GEMINI_MODEL=gemini-3.1-flash-lite
# Modèle de la phase de COMPRÉHENSION (le premier des trois appels : établir ce
# que l'utilisateur veut dire avant de planifier). Volontairement DISTINCT de
# GEMINI_MODEL pour deux raisons : la tâche est simple et n'a pas besoin du gros
# modèle, et Google tient un compteur de débit SÉPARÉ par modèle — cet appel ne
# mange donc pas la fenêtre par minute de la planification et de la rédaction.
# 2026-09-04 : « gemini-flash-lite-latest » est saturé chez Google (503 continu).
# La phase de compréhension se replie proprement quand son modèle ne répond pas —
# elle n'améliore la demande, elle ne la porte pas — mais se replier À CHAQUE
# message revient à ne plus l'avoir du tout. On la pose donc sur une référence
# disponible, de la même classe « lite » et avec son propre compteur de quota.
GEMINI_MODELE_COMPREHENSION=gemini-3.1-flash-lite
# Voix de Ket (lecture à voix haute des réponses). Palier gratuit : 10 générations
# par JOUR et par modèle (mesuré le 2026-09-16) ; la chaîne passe au modèle suivant
# quand l'un est épuisé, puis le navigateur prend le relais avec sa propre voix.
# La 3.1 parle en flux (premier son en ~3 s) ; la 2.5 rend l'audio d'un bloc.
GEMINI_MODELES_VOIX=gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts
GEMINI_VOIX_KET=Aoede
# MODÈLES DE SECOURS du moteur principal, séparés par des virgules (vide = aucun).
# N'entrent en jeu que sur un HTTP 503 « model is overloaded » : le modèle est débordé
# CHEZ GOOGLE, une saturation partagée par tous ses clients, sans délai annoncé et que
# l'attente ne résout pas — contrairement au 429, qui est notre propre quota. Google
# tenant un compteur de débit SÉPARÉ par modèle, un secours arrive avec sa propre
# fenêtre. Le repli vaut pour tout le message en cours, puis retombe sur le principal.
GEMINI_MODELES_REPLI=gemini-flash-lite-latest,gemini-3.5-flash-lite
# Forçage du moteur : vide = auto (Anthropic > Gemini > simulé) ;
# valeurs possibles : simulated | anthropic | gemini. Posé à « simulated »
# dans .env.test : les variables d'environnement OS (ex. GEMINI_API_KEY
# globale Windows) priment sur les .env et activeraient sinon un moteur
# réel pendant les tests.
# ⚠ LAISSER VIDE ICI. Vide = choix AUTOMATIQUE (Anthropic si clé > Gemini si
# clé > simulé). Forcer « gemini » dans ce fichier versionné, alors qu'aucune
# clé ne l'accompagne, fait ÉCHOUER l'assistant à chaque message au lieu de le
# laisser retomber proprement sur le simulateur. Le forçage se pose dans
# .env.local — le seul endroit où la clé existe aussi.
AI_ENGINE=
# Tokens d'ENTRÉE autorisés par MINUTE et PAR MODÈLE (quota
# GenerateContentInputTokensPerModelPerMinute). 250000 = palier gratuit, valeur
# lue dans le corps d'un vrai 429. C'est le SEUL réglage à relever le jour où la
# facturation Gemini est activée : le moteur s'y adapte sans changement de code.
# Le cache implicite du fournisseur n'y change rien — les tokens cachés comptent
# dans le débit, ils ne sont qu'allégés sur la facture.
GEMINI_TPM_PLAFOND=250000
# Traitement des messages en TÂCHE DE FOND. À 0, la question est traitée pendant
# la requête d'envoi, exactement comme avant la refonte — toute la mécanique de
# file est en place mais invisible. À 1, l'envoi rend un 202 immédiat et c'est le
# worker (`php bin/console messenger:consume async`) qui répond ; sans worker en
# marche, les questions s'empilent sans réponse. Ne passer à 1 qu'une fois le
# worker exploité.
ASSISTANT_ASYNC=0
###< assistant-ia ###

###> reprise de données ###
# COMBIEN DE LIGNES un import traite par palier. À 0, le chiffre est CALCULÉ sur la
# mémoire de PHP — le contrôle à blanc retient environ huit mégaoctets par ligne, sans
# les rendre, et c'est cette limite-là qui décide de ce qu'un processus peut tenir.
# Une valeur explicite sert à raccourcir les paliers pour d'autres raisons que la
# mémoire : une base lente, un worker partagé, un serveur qu'on ne veut pas voir occupé
# trente secondes d'affilée. Elle est bornée à 200.
IMPORT_PALIER=0
# Importation en TÂCHE DE FOND. À 0, les paliers sont poussés par le navigateur : une
# requête par palier, et l'onglet doit rester ouvert. À 1, la confirmation rend la main
# aussitôt et c'est le worker (`php bin/console messenger:consume async`) qui avance ;
# sans worker en marche, les imports resteraient en attente. Ne passer à 1 qu'une fois
# le worker exploité.
IMPORT_ASYNC=0
###< reprise de données ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Défaut INOFFENSIF : n'envoie rien et ne peut pas échouer. Le développement
# est déjà couvert par .env.dev (null://null, visible dans le profiler) et la
# production par .env.local. Pointer Mailpit ici imposait un service local à
# quiconque clone le dépôt.
MAILER_DSN=null://null
# Adresse expéditeur affichée sur les emails sortants.
MAILER_FROM=contact@joseara.com
###< symfony/mailer ###

###> déploiement ###
# URL de base des liens fabriqués HORS requête HTTP : commandes de console,
# crons, gestionnaires de messages. Sans elle, Symfony suppose « http://localhost »
# — et c'est ce qu'un salarié reçoit dans l'e-mail de relance de congé, ou un
# client dans une campagne CRM. Lue par config/packages/routing.yaml.
DEFAULT_URI=http://localhost:8000
# Mandataires de confiance. Beaucoup d'hébergements placent un nginx devant
# Apache : vu de PHP, toute requête vient alors de 127.0.0.1 et arrive en
# « http », même quand le visiteur est en HTTPS. « private_ranges » ne fait
# confiance qu'aux plages privées — un mandataire local, jamais une machine
# d'Internet. Vide = aucune confiance, ce qui est le bon défaut en développement.
TRUSTED_PROXIES=
###< déploiement ###

###> supervision des erreurs ###
# Adresse qui reçoit les alertes d'erreur. Adresse de RÔLE, pas de personne :
# elle survit à un changement d'équipe, et les alertes techniques ne se mêlent
# pas aux demandes de clients (contact@joseara.com est la boîte du formulaire
# public du site).
#
# Non secrète — elle vit donc ICI plutôt que dans .env.local : un oubli au
# moment d'écrire les secrets du serveur rendrait la supervision muette, et une
# supervision muette est pire que pas de supervision, puisqu'on la croit active.
ALERTE_EMAIL=technique@joseara.com
###< supervision des erreurs ###
